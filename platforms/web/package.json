{
  "name": "jellyfesh-web",
  "version": "0.0.7",
  "private": true,
  "description": "Jellyfesh Web: the Jellyfesh music player in the browser, for Subsonic, Navidrome and Jellyfin servers.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "plugins": "node scripts/build-plugins.mjs",
    "tokens": "cd ../.. && cargo xtask tokens --target css",
    "prepare-assets": "npm run tokens && npm run wasm && npm run plugins",
    "dev": "vite",
    "build": "npm run prepare-assets && vite build && node scripts/postbuild.mjs",
    "build:app": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tests/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "mock": "node tests/mock/serve.mjs"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.41.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
