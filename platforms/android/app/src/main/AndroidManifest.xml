<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Library access, option C: MediaStore for an instant list (media permission), SAF folders
         for the rest or instead of the permission. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Media3 session service and its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Online sources (plugins) and their artwork. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Whether the network is metered or gone, told to the core (NetworkWatcher.kt): Auto quality
         and downloads (Pause on Metered Connections) follow it. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Downloads go to Music/Jellyfesh by path (ADR-0025 §2): Android 11 and later allow it and
         index the files, Android 10 has requestLegacyExternalStorage, and Android 8 and 9 need
         this, asked once before the first download (DownloadGate.kt). Never the all-files one. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Android 17 (API 37): servers on the home network (Jellyfin, Navidrome) are reachable only
         with this runtime permission of the Nearby devices group. The app asks before connecting
         to a source whose address the core calls local (LocalNetworkUi.kt); earlier versions
         grant it with INTERNET. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:name=".JellyfeshApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher_ice"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_ice"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jellyfesh"
        tools:targetApi="37">

        <!-- The launcher entries are the icon aliases below, so the activity has none itself.
             The mini player is picture-in-picture (ADR-0026 §4), only while Settings › Appearance ›
             Mini Player in Picture-in-Picture is on; the window keeps its activity through the
             size changes that brings (PictureInPicture.kt). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <!-- OAuth sign-in redirects (ADR-0004: an app link or custom scheme on Android). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="auth"
                    android:scheme="jellyfesh" />
            </intent-filter>
        </activity>

        <!-- App icon picker (ADR-0017): one alias per icon; exactly one is enabled. Ice is the
             default, and Automatic uses it too. -->
        <activity-alias
            android:name=".LauncherIce"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ice"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherSteel"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_steel"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherOriginal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_original"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherNavyTide"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_navy_tide"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherRoyal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_royal"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherTealDeep"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_teal_deep"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherSeaGlass"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sea_glass"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherElectric"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_electric"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherAbyss"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_abyss"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherLagoon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_lagoon"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Media3 session: notification, lock screen, headset and Bluetooth buttons. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
