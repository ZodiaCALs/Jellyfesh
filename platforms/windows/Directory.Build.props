<Project>
  <!-- Shared by every project under platforms/windows. -->
  <PropertyGroup>
    <Version>0.0.8</Version>
    <Product>Jellyfesh</Product>
    <Company>The Jellyfesh authors</Company>
    <Copyright>All rights reserved (ADR-0016)</Copyright>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en-US</NeutralLanguage>
    <SatelliteResourceLanguages>en;zh-Hans;zh-Hant;ja</SatelliteResourceLanguages>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>8.0</AnalysisLevel>
    <!-- Type names mirror the core (Stop, Next, Queue, Collection) on purpose. -->
    <NoWarn>$(NoWarn);CA1711;CA1716</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Folders that other scripts write into (git-ignored). -->
    <JfWindowsRoot>$(MSBuildThisFileDirectory)</JfWindowsRoot>
    <JfGeneratedDir>$(MSBuildThisFileDirectory)Generated\</JfGeneratedDir>
    <!-- The C# ports of the drawing-time helpers (DisplayClock, the lyrics cursor). -->
    <JfSharedCsharpDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\shared\csharp'))\</JfSharedCsharpDir>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Edition and distribution (ADR-0021, docs/github.md): -p:JfEdition and -p:JfDistribution,
         else the JF_EDITION and JF_DISTRIBUTION environment variables (the release workflow), else
         a community build from source. Editions: community, commercial (no unofficial community
         plugins bundled). Distributions: source, direct, microsoft-store (scripts/build.ps1
         -StorePackage). Directory.Build.targets turns them into constants and assembly metadata. -->
    <JfEdition Condition="'$(JfEdition)' == ''">$(JF_EDITION)</JfEdition>
    <JfEdition Condition="'$(JfEdition)' == ''">community</JfEdition>
    <JfDistribution Condition="'$(JfDistribution)' == ''">$(JF_DISTRIBUTION)</JfDistribution>
    <JfDistribution Condition="'$(JfDistribution)' == ''">source</JfDistribution>
  </PropertyGroup>
</Project>
