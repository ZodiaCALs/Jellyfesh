<?xml version="1.0" encoding="utf-8"?>
<!--
    The shell (Luminous, v0.0.6): the title bar on the window material (Mica Alt on Windows 11, the
    solid field otherwise, ADR-0007); below it the field with four glows at the artwork's hue
    behind everything, the navigation pane as Clear glass over it, the library pages, the floating
    mini player (under 900 px) or player bar (900 px and wider) with the content fading out just
    above it, Now Playing over everything below the title bar, and one notice at a time.
-->
<Window
    x:Class="Jellyfesh.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Jellyfesh.App.Views">

    <Grid x:Name="Root" PreviewKeyDown="OnRootPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The keys every Jellyfesh app shares (docs/ui.md, "Keyboard"): Space plays or pauses, Ctrl+F
            searches and Esc goes back (closing Now Playing first); Ctrl+Right and Ctrl+Left, Ctrl+Up and
            Ctrl+Down, Shift+Right and Shift+Left are handled in OnRootPreviewKeyDown, ahead of lists and
            sliders. None of them acts while a text box has focus. The Groove and Windows Media Player keys
            below reuse none of them.
        -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Space" Invoked="OnSpaceKey" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchKey" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeKey" />
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="OnPlayPauseKey" />
            <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="OnPreviousKey" />
            <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="OnSearchKey" />
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="OnNowPlayingKey" />
            <KeyboardAccelerator Key="M" Modifiers="Control" Invoked="OnCompactKey" />
            <KeyboardAccelerator Key="H" Modifiers="Control" Invoked="OnShuffleKey" />
            <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="OnRepeatKey" />
            <KeyboardAccelerator Key="F8" Invoked="OnMuteKey" />
            <KeyboardAccelerator Key="F9" Invoked="OnVolumeDownKey" />
            <KeyboardAccelerator Key="F10" Invoked="OnVolumeUpKey" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackKey" />
            <KeyboardAccelerator Key="GoBack" Invoked="OnBackKey" />
        </Grid.KeyboardAccelerators>

        <!-- The Luminous field at the theme hue: the sky and four large glows (no photograph, MAT-02), behind the pane too. -->
        <Grid x:Name="Field" Grid.Row="1" Background="{ThemeResource JfSky}" IsHitTestVisible="False">
            <Rectangle Fill="{ThemeResource JfAuroraGlow1}" />
            <Rectangle Fill="{ThemeResource JfAuroraGlow2}" />
            <Rectangle Fill="{ThemeResource JfAuroraGlow3}" />
            <Rectangle Fill="{ThemeResource JfAuroraGlow4}" />
        </Grid>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Jellyfesh"
            BackRequested="OnBackRequested"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource x:Name="TitleIcon" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="240"
            PaneDisplayMode="Auto"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.Resources>
                <!-- The pane is Clear glass over the field (in-app acrylic; solid Cloud without transparency); the content area shows the field. -->
                <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="JfGlassClear" />
                <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="JfGlassClear" />
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Nav_Home" Content="Home" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Albums" Content="Albums" Tag="albums">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE93C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Artists" Content="Artists" Tag="artists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Songs" Content="Songs" Tag="songs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Playlists" Content="Playlists" Tag="playlists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Favorites" Content="Favourites" Tag="favorites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB51;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Uid="Nav_Search" Content="Search" Tag="search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Sources" Content="Sources" Tag="sources">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE753;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel x:Name="ScanPanel" Margin="16,8,16,12" Spacing="6" Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" />
                    <TextBlock x:Name="ScanText" Style="{StaticResource JfCaptionText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid x:Name="ContentArea" SizeChanged="OnContentAreaSizeChanged">
                <Frame x:Name="ContentFrame" CacheSize="8" Navigated="OnNavigated" />
                <!-- The content fades out just above the floating player (Luminous). -->
                <Rectangle
                    x:Name="ContentFade"
                    Height="152"
                    VerticalAlignment="Bottom"
                    Fill="{ThemeResource JfContentFade}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
                <views:MiniPlayer
                    x:Name="Mini"
                    Margin="16,0,16,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed" />
                <views:PlayerBar
                    x:Name="Bar"
                    MaxWidth="1240"
                    Margin="16,0,16,16"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed" />
            </Grid>
        </NavigationView>

        <views:NowPlayingView x:Name="NowPlaying" Grid.Row="1" Visibility="Collapsed" />

        <views:CompactPlayer x:Name="Compact" Grid.RowSpan="2" Visibility="Collapsed" />

        <InfoBar
            x:Name="Notice"
            Grid.Row="1"
            MaxWidth="440"
            Margin="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Closed="OnNoticeClosed"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Window>
