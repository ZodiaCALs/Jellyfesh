<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX packaging for a later store or sideload build (ADR-0016): build with -p:WindowsPackageType=MSIX.
     The direct-download build is unpackaged and does not use this file. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap mp">

  <Identity Name="Jellyfesh" Publisher="CN=Jellyfesh" Version="0.0.5.0" />

  <mp:PhoneIdentity PhoneProductId="7f2a6b2e-4c3e-4d77-9b40-9f3c4f8a1d10" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Jellyfesh</DisplayName>
    <PublisherDisplayName>The Jellyfesh authors</PublisherDisplayName>
    <Logo>Assets\Package\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="zh-Hans" />
    <Resource Language="zh-Hant" />
    <Resource Language="ja" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Jellyfesh"
        Description="An elegant, very lightweight music player."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Package\Square150x150Logo.png"
        Square44x44Logo="Assets\Package\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Package\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\Package\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
