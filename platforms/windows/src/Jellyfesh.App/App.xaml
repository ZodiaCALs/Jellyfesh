<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Jellyfesh.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--
                    The Misty brushes (from the core's Theme slice) and the control style dictionary
                    (Styles/Controls.xaml, style D) are added in App's constructor, after the brushes
                    exist, so every reference in them resolves.
                -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
