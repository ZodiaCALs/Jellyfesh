<?xml version="1.0" encoding="utf-8"?>
<!--
    Row and tile templates shared by the library pages, compiled with x:Bind (no reflection). Rows
    start as placeholders and fill in when their page of the core's query arrives; artwork is a
    thumbnail file the view decodes at twice the drawn size (crisp up to 200 % scaling). Track rows
    are 52 px (player tokens), list art radius 6, grid covers 16 (Luminous). A song that cannot play
    here shows why beside its other facts (choosing it opens its link when it has one).
-->
<ResourceDictionary
    x:Class="Jellyfesh.App.Styles.Templates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jellyfesh.App.Controls"
    xmlns:shell="using:Jellyfesh.App.Shell"
    xmlns:th="using:Jellyfesh.App.Theming"
    xmlns:vm="using:Jellyfesh.ViewModels">

    <DataTemplate x:Key="TrackRowTemplate" x:DataType="vm:TrackItem">
        <Grid Height="{th:Token Key=Player.RowHeight}" ColumnSpacing="12" Background="Transparent"
              Opacity="{x:Bind shell:Bind.Dim(IsMissing), Mode=OneWay}"
              AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="{th:Token Key=Artwork.RadiusList, Kind=Corner}" Background="{ThemeResource JfFill}">
                <Image controls:Artwork.DecodeSize="80" controls:Artwork.Uri="{x:Bind ArtworkUri, Mode=OneWay}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{StaticResource JfListTitleText}" Text="{x:Bind Title, Mode=OneWay}" />
                <TextBlock Style="{StaticResource JfListSecondaryText}" Text="{x:Bind Subtitle, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <TextBlock Style="{StaticResource JfCaptionText}" Text="{x:Bind UnplayableNote, Mode=OneWay}"
                           Visibility="{x:Bind shell:Bind.VisibleIf(UnplayableNote), Mode=OneWay}" />
                <TextBlock Style="{StaticResource JfCaptionText}" Text="{x:Bind Origin, Mode=OneWay}"
                           Visibility="{x:Bind shell:Bind.VisibleIf(Origin), Mode=OneWay}" />
                <TextBlock Style="{StaticResource JfTimeText}" Text="{x:Bind Duration, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--
        Album tracks: the number instead of the artwork the whole page already shows. It turns into a
        play glyph on hover; the playing row is accent-soft with accent text and a level glyph.
    -->
    <DataTemplate x:Key="NumberedTrackRowTemplate" x:DataType="vm:TrackItem">
        <Grid Height="{th:Token Key=Player.RowHeight}" Padding="8,0" ColumnSpacing="12" CornerRadius="{th:Token Key=Radius.Md, Kind=Corner}"
              Background="{x:Bind shell:Bind.CurrentRowFill(IsCurrent), Mode=OneWay}"
              AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:TrackNumberCell IsCurrent="{x:Bind IsCurrent, Mode=OneWay}" Number="{x:Bind Number, Mode=OneWay}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{StaticResource JfListTitleText}" Foreground="{x:Bind shell:Bind.CurrentRowInk(IsCurrent), Mode=OneWay}" Text="{x:Bind Title, Mode=OneWay}" />
                <TextBlock Style="{StaticResource JfListSecondaryText}" Text="{x:Bind Subtitle, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Style="{StaticResource JfTimeText}" VerticalAlignment="Center" Text="{x:Bind Duration, Mode=OneWay}" />
        </Grid>
    </DataTemplate>

    <!-- Home's rows of songs: a small tile per track. -->
    <DataTemplate x:Key="TrackTileTemplate" x:DataType="vm:TrackItem">
        <StackPanel Width="148" Spacing="8" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
            <Border Width="148" Height="148" CornerRadius="{th:Token Key=Artwork.RadiusGrid, Kind=Corner}" Background="{ThemeResource JfFill}">
                <Image controls:Artwork.DecodeSize="296" controls:Artwork.Uri="{x:Bind ArtworkUri, Mode=OneWay}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource JfListTitleText}" Text="{x:Bind Title, Mode=OneWay}" />
                <TextBlock Style="{StaticResource JfListSecondaryText}" Text="{x:Bind Subtitle, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Albums lift on hover and offer a glass play button (Controls/AlbumTile, after Apple Music). -->
    <DataTemplate x:Key="AlbumTileTemplate" x:DataType="vm:AlbumItem">
        <controls:AlbumTile
            Album="{x:Bind}"
            ArtworkUri="{x:Bind ArtworkUri, Mode=OneWay}"
            Subtitle="{x:Bind Subtitle, Mode=OneWay}"
            Title="{x:Bind Title, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" />
    </DataTemplate>

    <!-- An album as a row (Search's library results, as in the other apps): its cover, title and artist. -->
    <DataTemplate x:Key="AlbumRowTemplate" x:DataType="vm:AlbumItem">
        <Grid Height="{th:Token Key=Player.RowHeight}" ColumnSpacing="12" Background="Transparent"
              AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="{th:Token Key=Artwork.RadiusList, Kind=Corner}" Background="{ThemeResource JfFill}">
                <Image controls:Artwork.DecodeSize="80" controls:Artwork.Uri="{x:Bind ArtworkUri, Mode=OneWay}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{StaticResource JfListTitleText}" Text="{x:Bind Title, Mode=OneWay}" />
                <TextBlock Style="{StaticResource JfListSecondaryText}" Text="{x:Bind Subtitle, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Artists have no images in this release: a monogram on accent-soft (COL-06). -->
    <DataTemplate x:Key="ArtistTileTemplate" x:DataType="vm:ArtistItem">
        <StackPanel Width="136" Spacing="8" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
            <Grid Width="120" Height="120" HorizontalAlignment="Center">
                <Ellipse Fill="{ThemeResource JfAccentSoft}" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" FontWeight="Bold"
                           Foreground="{ThemeResource JfAccentText}" Text="{x:Bind Monogram, Mode=OneWay}" />
            </Grid>
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource JfListTitleText}" Text="{x:Bind Name, Mode=OneWay}" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource JfListSecondaryText}" Text="{x:Bind Subtitle, Mode=OneWay}" />
        </StackPanel>
    </DataTemplate>

    <!-- The Artists page is a list (docs/ui.md): a round monogram, the name and the song count. -->
    <DataTemplate x:Key="ArtistRowTemplate" x:DataType="vm:ArtistItem">
        <Grid Height="{th:Token Key=Player.RowHeight}" ColumnSpacing="12" Background="Transparent"
              AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="40" Height="40">
                <Ellipse Fill="{ThemeResource JfAccentSoft}" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"
                           Foreground="{ThemeResource JfAccentText}" Text="{x:Bind Monogram, Mode=OneWay}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{StaticResource JfListTitleText}" Text="{x:Bind Name, Mode=OneWay}" />
                <TextBlock Style="{StaticResource JfListSecondaryText}" Text="{x:Bind Subtitle, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PlaylistTileTemplate" x:DataType="vm:PlaylistItem">
        <StackPanel Width="168" Spacing="8" AutomationProperties.Name="{x:Bind Name}">
            <Grid Width="168" Height="168" CornerRadius="{th:Token Key=Artwork.RadiusGrid, Kind=Corner}" Background="{ThemeResource JfAccentSoft}">
                <controls:StrokeIcon Data="{StaticResource IconQueue}" Size="48" Foreground="{ThemeResource JfAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image controls:Artwork.DecodeSize="336" controls:Artwork.Uri="{x:Bind ArtworkUri, Mode=OneWay}" Stretch="UniformToFill" />
            </Grid>
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource JfListTitleText}" Text="{x:Bind Name}" />
                <TextBlock Style="{StaticResource JfListSecondaryText}" Text="{x:Bind Subtitle}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="QueueRowTemplate" x:DataType="vm:QueueEntryItem">
        <Grid Height="{th:Token Key=Player.RowHeight}" ColumnSpacing="12" Background="Transparent"
              AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="{th:Token Key=Artwork.RadiusList, Kind=Corner}" Background="{ThemeResource JfFill}">
                <Image controls:Artwork.DecodeSize="80" controls:Artwork.Uri="{x:Bind ArtworkUri, Mode=OneWay}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{StaticResource JfListTitleText}" Text="{x:Bind Title, Mode=OneWay}" />
                <TextBlock Style="{StaticResource JfListSecondaryText}" Text="{x:Bind Subtitle, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Style="{StaticResource JfTimeText}" VerticalAlignment="Center" Text="{x:Bind Duration, Mode=OneWay}" />
        </Grid>
    </DataTemplate>

    <!-- An album, artist, playlist or folder from an online source (search and browse). -->
    <DataTemplate x:Key="SourceEntryTemplate" x:DataType="vm:SourceEntryItem">
        <Grid Height="{th:Token Key=Player.RowHeight}" ColumnSpacing="12" Background="Transparent"
              AutomationProperties.Name="{x:Bind AccessibleName}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="{th:Token Key=Artwork.RadiusList, Kind=Corner}" Background="{ThemeResource JfFill}">
                <Image controls:Artwork.DecodeSize="80" controls:Artwork.Uri="{x:Bind ArtworkUri, Mode=OneWay}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{StaticResource JfListTitleText}" Text="{x:Bind Title}" />
                <TextBlock Style="{StaticResource JfListSecondaryText}" Text="{x:Bind Subtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <TextBlock Style="{StaticResource JfCaptionText}" Text="{x:Bind Origin}" Visibility="{x:Bind shell:Bind.VisibleIf(Origin)}" />
                <TextBlock Style="{StaticResource JfCaptionText}" Text="{x:Bind KindLabel}" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
