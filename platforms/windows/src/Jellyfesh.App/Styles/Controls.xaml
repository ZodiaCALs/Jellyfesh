                                   Foreground="{ThemeResource JfInk70}" Text="{TemplateBinding Label}" />
                        <TextBlock x:Name="CurrentText" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource JfInk90}" Opacity="0" Text="{TemplateBinding Label}" />
