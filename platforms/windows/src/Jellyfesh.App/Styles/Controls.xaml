    <!-- ===== Misty's segmented control (Lyrics | Queue | Info; Artwork | Misty) ===== -->

    <Style x:Key="JfSegmentGroupStyle" TargetType="Border">
        <Setter Property="Padding" Value="3" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{ThemeResource JfFill}" />
        <Setter Property="BorderBrush" Value="{ThemeResource JfLineSoft}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="JfSegmentStyle" TargetType="RadioButton">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource JfInk70}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource JfAccentText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Pill" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Foreground" Value="{ThemeResource JfInk90}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Foreground" Value="{ThemeResource JfInk30}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Pill.Background" Value="{ThemeResource JfCloud}" />
                                        <Setter Target="Pill.BorderBrush" Value="{ThemeResource JfGlassEdge}" />
                                        <Setter Target="Pill.BorderThickness" Value="1" />
                                        <Setter Target="Label.Foreground" Value="{ThemeResource JfInk90}" />
                                    </VisualState.Setters>
