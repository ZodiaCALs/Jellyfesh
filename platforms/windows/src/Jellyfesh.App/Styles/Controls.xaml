    <!-- ===== Sliders ===== -->

    <!--
        The volume (and any slider in the seek bar's style): the same straight line between two
        speaker glyphs, ink-90 over ink-30, no thumb at rest; hover or focus thickens it to 6 px and
        shows the 14 px ringed thumb, a press to 8 px (dur-1).
    -->
    <Style x:Key="JfThinSliderStyle" TargetType="Slider">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="StepFrequency" Value="1" />
        <Setter Property="IsThumbToolTipEnabled" Value="False" />
        <Setter Property="Foreground" Value="{ThemeResource JfInk90}" />
        <Setter Property="Background" Value="{ThemeResource JfInk30}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource JfAccentText}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource JfSky}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="SliderContainer" Background="Transparent" MinHeight="32">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.16">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HorizontalTrackRect" Storyboard.TargetProperty="Height" To="6" Duration="0" EnableDependentAnimation="True" />
                                        <DoubleAnimation Storyboard.TargetName="HorizontalDecreaseRect" Storyboard.TargetProperty="Height" To="6" Duration="0" EnableDependentAnimation="True" />
                                        <DoubleAnimation Storyboard.TargetName="HorizontalThumb" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HorizontalTrackRect" Storyboard.TargetProperty="Height" To="8" Duration="0" EnableDependentAnimation="True" />
                                        <DoubleAnimation Storyboard.TargetName="HorizontalDecreaseRect" Storyboard.TargetProperty="Height" To="8" Duration="0" EnableDependentAnimation="True" />
                                        <DoubleAnimation Storyboard.TargetName="HorizontalThumb" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="HorizontalDecreaseRect.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusEngagementStates">
                                <VisualState x:Name="FocusDisengaged" />
                                <VisualState x:Name="FocusEngagedHorizontal">
                                    <VisualState.Setters>
                                        <Setter Target="HorizontalThumb.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="FocusEngagedVertical" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="HorizontalTemplate" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3" Height="{th:Token Key=Player.ScrubberTrack}" RadiusX="4" RadiusY="4" Fill="{TemplateBinding Background}" />
                            <Rectangle x:Name="HorizontalDecreaseRect" Height="{th:Token Key=Player.ScrubberTrack}" RadiusX="4" RadiusY="4" Fill="{TemplateBinding Foreground}" />
                            <Thumb x:Name="HorizontalThumb" Grid.Column="1" Width="{th:Token Key=Player.ScrubberThumb}" Height="{th:Token Key=Player.ScrubberThumb}" Opacity="0" AutomationProperties.AccessibilityView="Raw">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid>
                                            <Ellipse Margin="-1,0,-1,-2" Fill="{ThemeResource JfScrim}" Opacity="0.35" />
                                            <Ellipse Fill="{ThemeResource JfInk90}" Stroke="{ThemeResource JfGlassEdge}" StrokeThickness="2" />
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <Grid x:Name="VerticalTemplate" Visibility="Collapsed">
                            <Rectangle x:Name="VerticalTrackRect" />
                            <Rectangle x:Name="VerticalDecreaseRect" />
                            <Thumb x:Name="VerticalThumb" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The custom hue slider: the thin slider over a hue-gradient track (Settings → Appearance sets
        HueTrack's stops from the accent at every 30 degrees), with the thumb always shown.
    -->
    <Style x:Key="JfHueSliderStyle" TargetType="Slider" BasedOn="{StaticResource JfThinSliderStyle}">
        <Setter Property="Maximum" Value="359" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="SliderContainer" Background="Transparent" MinHeight="36">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="SliderContainer.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusEngagementStates">
                                <VisualState x:Name="FocusDisengaged" />
                                <VisualState x:Name="FocusEngagedHorizontal" />
                                <VisualState x:Name="FocusEngagedVertical" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="HorizontalTemplate" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3" Height="10" RadiusX="5" RadiusY="5" Fill="{TemplateBinding Background}" />
                            <Rectangle x:Name="HorizontalDecreaseRect" Height="10" Fill="Transparent" />
                            <Thumb x:Name="HorizontalThumb" Grid.Column="1" Width="20" Height="20" AutomationProperties.AccessibilityView="Raw">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid>
                                            <Ellipse Margin="-1,0,-1,-2" Fill="{ThemeResource JfScrim}" Opacity="0.35" />
                                            <Ellipse Fill="{ThemeResource JfCloud}" Stroke="{ThemeResource JfLineStrong}" StrokeThickness="1" />
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <Grid x:Name="VerticalTemplate" Visibility="Collapsed">
                            <Rectangle x:Name="VerticalTrackRect" />
                            <Rectangle x:Name="VerticalDecreaseRect" />
                            <Thumb x:Name="VerticalThumb" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The seek bar (Controls/SeekBar.cs, docs/design-controls.md "v0.0.4"): a straight line with round
        caps, ink-90 played over ink-30, a 14 px ringed thumb (ink-90, glass-edge ring, shadow-1) on
        hover, focus and drag. The control sets the line's thickness and the thumb per state.
    -->
    <Style TargetType="controls:SeekBar">
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{ThemeResource JfInk90}" />
        <Setter Property="Background" Value="{ThemeResource JfInk30}" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource JfAccentText}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource JfSky}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SeekBar">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border x:Name="Track" Height="{th:Token Key=Player.ScrubberTrack}" VerticalAlignment="Center"
                                CornerRadius="{th:Token Key=Radius.Full, Kind=Corner}" Background="{TemplateBinding Background}" />
                        <Border x:Name="Played" Width="0" Height="{th:Token Key=Player.ScrubberTrack}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                CornerRadius="{th:Token Key=Radius.Full, Kind=Corner}" Background="{TemplateBinding Foreground}" />
                        <Grid x:Name="Thumb" Width="{th:Token Key=Player.ScrubberThumb}" Height="{th:Token Key=Player.ScrubberThumb}"
                              HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Ellipse Margin="-1,0,-1,-2" Fill="{ThemeResource JfScrim}" Opacity="0.35" />
                            <Ellipse Fill="{TemplateBinding Foreground}" Stroke="{ThemeResource JfGlassEdge}" StrokeThickness="2" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Lists ===== -->

    <!-- Track rows are 52 px (player tokens). -->
    <Style x:Key="JfTrackRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="MinHeight" Value="{th:Token Key=Player.RowHeight}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="JfGridTileStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
        <Setter Property="Margin" Value="0,0,12,16" />
    </Style>

    <!-- Album tiles lift themselves on hover (Controls/AlbumTile): no system hover fill behind them. -->
    <Style x:Key="JfLiftTileStyle" TargetType="GridViewItem" BasedOn="{StaticResource JfGridTileStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>
</ResourceDictionary>
