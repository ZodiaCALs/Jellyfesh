    <!-- ===== Navigation (ADR-0023): Jellyfesh Web's sidebar items, phone tabs and Library switcher =====
         Controls/SidebarItem: a radio button with a glyph and a label. The rest and current looks are
         separate layers, so the pointer's states (CommonStates) and the current place (CheckStates)
         never set the same property. -->

    <!-- A place in the sidebar panel: 42 epx, r-lg; ink-70 at rest, the hover fill and ink-90 under the
         pointer; the current place accent-soft with accent text, semibold. -->
    <Style x:Key="JfSidebarItemStyle" TargetType="controls:SidebarItem">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="CornerRadius" Value="{th:Token Key=Radius.Lg, Kind=Corner}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource JfAccentText}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource JfSky}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SidebarItem">
                    <Grid x:Name="Root" MinHeight="{TemplateBinding MinHeight}" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" />
                        </Grid.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Opacity" Value="1" />
                                        <Setter Target="RestIcon.Foreground" Value="{ThemeResource JfInk90}" />
                                        <Setter Target="RestText.Foreground" Value="{ThemeResource JfInk90}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Press.Opacity" Value="1" />
                                        <Setter Target="RestIcon.Foreground" Value="{ThemeResource JfInk90}" />
                                        <Setter Target="RestText.Foreground" Value="{ThemeResource JfInk90}" />
                                        <Setter Target="Scale.ScaleX" Value="0.97" />
                                        <Setter Target="Scale.ScaleY" Value="0.97" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Fills.Visibility" Value="Collapsed" />
                                        <Setter Target="Current.Opacity" Value="1" />
                                        <Setter Target="RestContent.Opacity" Value="0" />
                                        <Setter Target="CurrentContent.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="Fills">
                            <Border x:Name="Hover" Background="{ThemeResource JfFillHover}" Opacity="0" />
                            <Border x:Name="Press" Background="{ThemeResource JfFillPress}" Opacity="0" />
                        </Grid>
                        <Border x:Name="Current" Background="{ThemeResource JfAccentSoft}" Opacity="0" />
                        <Grid x:Name="RestContent" Padding="{TemplateBinding Padding}" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:StrokeIcon x:Name="RestIcon" VerticalAlignment="Center" Data="{TemplateBinding Glyph}" Foreground="{ThemeResource JfInk70}" Size="20" />
                            <TextBlock x:Name="RestText" Grid.Column="1" VerticalAlignment="Center" FontSize="{TemplateBinding FontSize}" FontWeight="Medium"
                                       Foreground="{ThemeResource JfInk70}" Text="{TemplateBinding Label}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Grid x:Name="CurrentContent" Padding="{TemplateBinding Padding}" ColumnSpacing="12" Opacity="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:StrokeIcon VerticalAlignment="Center" Data="{TemplateBinding Glyph}" Foreground="{ThemeResource JfAccentText}" Size="20" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource JfAccentText}" Text="{TemplateBinding Label}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Open Files… in the sidebar's foot: an action, not a place, so a button in the items' look. -->
    <Style x:Key="JfSidebarActionStyle" TargetType="Button" BasedOn="{StaticResource JfBareButtonStyle}">
