    <!-- A phone tab: a 54 by 30 pill around the glyph (accent-soft when current) and an 11 epx label below. -->
    <Style x:Key="JfPhoneTabStyle" TargetType="controls:SidebarItem">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="0,4,0,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CornerRadius" Value="{th:Token Key=Radius.Lg, Kind=Corner}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource JfAccentText}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource JfSky}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SidebarItem">
                    <Grid x:Name="Root" MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}" Background="Transparent" RenderTransformOrigin="0.5,0.5" RowSpacing="3">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" />
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Opacity" Value="1" />
                                        <Setter Target="Scale.ScaleX" Value="0.97" />
                                        <Setter Target="Scale.ScaleY" Value="0.97" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Visibility" Value="Collapsed" />
                                        <Setter Target="Current.Opacity" Value="1" />
                                        <Setter Target="RestIcon.Opacity" Value="0" />
                                        <Setter Target="CurrentIcon.Opacity" Value="1" />
                                        <Setter Target="RestText.Opacity" Value="0" />
                                        <Setter Target="CurrentText.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid Width="54" Height="30" HorizontalAlignment="Center" CornerRadius="15">
                            <Border x:Name="Hover" Background="{ThemeResource JfFillHover}" Opacity="0" />
                            <Border x:Name="Current" Background="{ThemeResource JfAccentSoft}" Opacity="0" />
                            <controls:StrokeIcon x:Name="RestIcon" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{TemplateBinding Glyph}" Foreground="{ThemeResource JfInk70}" Size="20" />
                            <controls:StrokeIcon x:Name="CurrentIcon" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{TemplateBinding Glyph}" Foreground="{ThemeResource JfAccentText}" Opacity="0" Size="20" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="RestText" HorizontalAlignment="Center" FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold" Foreground="{ThemeResource JfInk70}"
                                       Text="{TemplateBinding Label}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="CurrentText" HorizontalAlignment="Center" FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold" Foreground="{ThemeResource JfAccentText}"
                                       Opacity="0" Text="{TemplateBinding Label}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The Library tab's switcher on phones (Albums, Artists, Songs, Playlists, Favourites): pills on a
