<?xml version="1.0" encoding="utf-8"?>
<!--
    Control style D as built in v0.0.4 (docs/design-controls.md, "v0.0.4: the controls as built"):
    Apple's glass grouping for transport, a straight seek line with inline times and Media Player's
    ringed hover thumb, Misty's segmented control. Every control shape lives in this one dictionary.

    Colours are the Jf* brushes from the core's Theme slice (ThemeBrushes); sizes, radii and spacing
    are Misty tokens ({th:Token}). Loaded by App after those brushes exist.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jellyfesh.App.Controls"
    xmlns:th="using:Jellyfesh.App.Theming">

    <!-- ===== Glyphs (Controls/StrokeIcon: 1.75-unit strokes on a 24-unit grid, Misty ICO-01) =====
         From the mock-ups (design/canvas/Controls-D.dc.html, NowPlaying-*.dc.html), with every number
         separated and every repeated command written out for XAML's path parser. Play and pause are
         filled (media is playing); everything else is an outline. -->
    <x:String x:Key="IconBack">M15 5 l-7 7 l7 7</x:String>
    <x:String x:Key="IconLyrics">M5 5 h14 v10 H10 l-5 4 z M9 9 h6</x:String>
    <x:String x:Key="IconQueue">M4 6 h16 M4 12 h16 M4 18 h10</x:String>
    <x:String x:Key="IconSpeaker">M11 5 L6 9 H3 v6 h3 l5 4 z M16 9 a4 4 0 0 1 0 6 M19 6 a8 8 0 0 1 0 12</x:String>
    <x:String x:Key="IconVolumeLow">M11 5 L6 9 H3 v6 h3 l5 4 z</x:String>
    <x:String x:Key="IconVolumeHigh">M11 5 L6 9 H3 v6 h3 l5 4 z M15.5 9.5 a3.5 3.5 0 0 1 0 5 M18.5 6.5 a8 8 0 0 1 0 11</x:String>
    <x:String x:Key="IconMuted">M11 5 L6 9 H3 v6 h3 l5 4 z M16 9 l5 6 M21 9 l-5 6</x:String>
    <x:String x:Key="IconShuffle">M3 7 h3 c1.7 0 3.2 0.9 4 2.3 l3.9 5.4 c0.8 1.4 2.3 2.3 4 2.3 H21 M18 14 l3 3 l-3 3 M3 17 h3 c1 0 1.9 -0.3 2.7 -0.8 M15.3 7.8 c0.8 -0.5 1.7 -0.8 2.7 -0.8 H21 M18 4 l3 3 l-3 3</x:String>
    <x:String x:Key="IconRepeat">M4 12 V9 a3 3 0 0 1 3 -3 h12 M16 3 l3 3 l-3 3 M20 12 v3 a3 3 0 0 1 -3 3 H5 M8 21 l-3 -3 l3 -3</x:String>
    <x:String x:Key="IconRepeatOne">M4 12 V9 a3 3 0 0 1 3 -3 h12 M16 3 l3 3 l-3 3 M20 12 v3 a3 3 0 0 1 -3 3 H5 M8 21 l-3 -3 l3 -3 M11.5 10.5 l1.5 -1 v5</x:String>
    <x:String x:Key="IconPrevious">M6 5 v14 M19 6 l-10 6 l10 6 z</x:String>
    <x:String x:Key="IconNext">M18 5 v14 M5 6 l10 6 l-10 6 z</x:String>
    <x:String x:Key="IconPlay">M8 5.6 v12.8 a1 1 0 0 0 1.5 0.86 l10 -6.4 a1 1 0 0 0 0 -1.72 l-10 -6.4 A1 1 0 0 0 8 5.6 z</x:String>
    <x:String x:Key="IconPause">M7.7 5 h1.2 a1.2 1.2 0 0 1 1.2 1.2 v11.6 a1.2 1.2 0 0 1 -1.2 1.2 H7.7 a1.2 1.2 0 0 1 -1.2 -1.2 V6.2 A1.2 1.2 0 0 1 7.7 5 z M15.1 5 h1.2 a1.2 1.2 0 0 1 1.2 1.2 v11.6 a1.2 1.2 0 0 1 -1.2 1.2 h-1.2 a1.2 1.2 0 0 1 -1.2 -1.2 V6.2 A1.2 1.2 0 0 1 15.1 5 z</x:String>
    <x:String x:Key="IconHeart">M12 20 s-7 -4.4 -7 -10 a4 4 0 0 1 7 -2.6 A4 4 0 0 1 19 10 c0 5.6 -7 10 -7 10 z</x:String>
    <x:String x:Key="IconMore">M6 12 h0.01 M12 12 h0.01 M18 12 h0.01</x:String>
    <x:String x:Key="IconClose">M6 6 l12 12 M18 6 L6 18</x:String>
    <x:String x:Key="IconChevronDown">M6 9 l6 6 l6 -6</x:String>
    <x:String x:Key="IconInfo">M12 21 a9 9 0 1 0 0 -18 a9 9 0 0 0 0 18 z M12 11 v5 M12 8 h0.01</x:String>
    <x:String x:Key="IconMiniPlayer">M4 6 h16 v12 H4 z M12 12 h6 v4 h-6 z</x:String>
    <x:String x:Key="IconExpand">M14 4 h6 v6 M20 4 l-7 7 M10 20 H4 v-6 M4 20 l7 -7</x:String>
    <!-- Devices a remote source plays on (Devices, the device button); speakers use IconSpeaker. -->
    <x:String x:Key="IconDeviceComputer">M5 6 h14 v9 H5 z M3 18 h18</x:String>
    <x:String x:Key="IconDevicePhone">M8 3 h8 a1 1 0 0 1 1 1 v16 a1 1 0 0 1 -1 1 H8 a1 1 0 0 1 -1 -1 V4 a1 1 0 0 1 1 -1 z M11 18 h2</x:String>
    <x:String x:Key="IconDeviceTv">M3 6 h18 v11 H3 z M8 21 h8 M12 17 v4</x:String>
    <x:String x:Key="IconDeviceCar">M3 15 v-3 l2.5 -5 h13 l2.5 5 v3 z M7 18 v-3 M17 18 v-3 M3 12 h18</x:String>
    <x:String x:Key="IconDeviceOther">M4 5 h11 v14 H4 z M17 9 h3 v10 h-3 z</x:String>
    <!-- The places of the sidebar and the phone tabs (ADR-0023), Jellyfesh Web's glyphs. -->
    <x:String x:Key="IconHome">M4 11.5 L12 5 l8 6.5 V19 a1 1 0 0 1 -1 1 h-4.5 v-5 h-5 v5 H5 a1 1 0 0 1 -1 -1 z</x:String>
    <x:String x:Key="IconAlbum">M12 3.5 a8.5 8.5 0 1 1 0 17 a8.5 8.5 0 0 1 0 -17 z M12 10 a2 2 0 1 1 0 4 a2 2 0 0 1 0 -4 z</x:String>
    <x:String x:Key="IconArtist">M12 4 a4 4 0 1 1 0 8 a4 4 0 0 1 0 -8 z M4.5 20 a7.5 7.5 0 0 1 15 0</x:String>
    <x:String x:Key="IconNote">M9 18 V6 l10 -2 v12 M9 18 a2.5 2.5 0 1 1 -2.5 -2.5 H9 M19 16 a2.5 2.5 0 1 1 -2.5 -2.5 H19</x:String>
    <x:String x:Key="IconPlaylist">M4 6 h12 M4 11 h12 M4 16 h7 M17 13 v6.5 M17 19.5 a2 2 0 1 1 -2 -2 h2 M17 13 l3.5 -1</x:String>
    <x:String x:Key="IconDownload">M12 4 v11 M7.5 10.5 L12 15 l4.5 -4.5 M5 19.5 h14</x:String>
    <x:String x:Key="IconSearch">M10.5 4 a6.5 6.5 0 1 1 0 13 a6.5 6.5 0 0 1 0 -13 z M15.5 15.5 L20 20</x:String>
    <x:String x:Key="IconSources">M5 6.5 h14 v4 H5 z M5 13.5 h14 v4 H5 z M8 8.5 h0.01 M8 15.5 h0.01</x:String>
    <x:String x:Key="IconSettings">M5 7 h9 M18 7 h1 M5 17 h3 M12 17 h7 M14 5 v4 M8 15 v4 M5 12 h5 M14 12 h5 M10 10 v4</x:String>
    <x:String x:Key="IconFile">M7 3.5 h7 l4 4 V20 a0.5 0.5 0 0 1 -0.5 0.5 h-10 A0.5 0.5 0 0 1 6 20 V4 a0.5 0.5 0 0 1 0.5 -0.5 z M14 3.5 V8 h4 M9.5 13.5 v3.5 M9.5 17 a1.5 1.5 0 1 1 -1.5 -1.5 h1.5 M9.5 13.5 l4 -1</x:String>
    <x:String x:Key="IconLibrary">M5 4.5 v15 M9.5 4.5 v15 M14 5.5 l4.5 13.5</x:String>

    <!-- Radii as resources for markup that cannot use {th:Token} (Misty r-full). -->
    <CornerRadius x:Key="JfFullRadius">999</CornerRadius>

    <!-- ===== Type (native face: Segoe UI Variable; CJK falls back by language, Misty TYP-01) ===== -->

    <Style x:Key="JfPageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{th:Token Key=Type.NowPlayingTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource JfInk90}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
    </Style>

    <!-- Library pages start with a large title that scrolls with the content (after Apple Music); Luminous: 48 epx (type.text-h1). -->
    <Style x:Key="JfLargeTitleText" TargetType="TextBlock" BasedOn="{StaticResource JfPageTitleText}">
        <Setter Property="FontSize" Value="{th:Token Key=Type.H1}" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>

    <!-- An album's, artist's or playlist's name in its page's header: the web's text-h2 (30.4 epx), up to two lines. -->
    <Style x:Key="JfHeaderTitleText" TargetType="TextBlock" BasedOn="{StaticResource JfPageTitleText}">
        <Setter Property="FontSize" Value="{th:Token Key=Type.H2}" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="MaxLines" Value="2" />
    </Style>

    <Style x:Key="JfNowPlayingTitleText" TargetType="TextBlock" BasedOn="{StaticResource JfPageTitleText}">
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="MaxLines" Value="2" />
    </Style>

    <Style x:Key="JfNowPlayingArtistText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{th:Token Key=Type.NowPlayingArtist}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource JfInk70}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="JfSectionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{th:Token Key=Type.Section}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource JfInk90}" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>

    <Style x:Key="JfListTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{th:Token Key=Type.ListTitle}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource JfInk90}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="JfListSecondaryText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{th:Token Key=Type.ListSecondary}" />
        <Setter Property="Foreground" Value="{ThemeResource JfInk70}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="JfCaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource JfInk50}" />
    </Style>

    <!-- Times use tabular figures so they do not wobble as they count. -->
    <Style x:Key="JfTimeText" TargetType="TextBlock" BasedOn="{StaticResource JfCaptionText}">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="JfBodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource JfInk90}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="JfSecondaryBodyText" TargetType="TextBlock" BasedOn="{StaticResource JfBodyText}">
        <Setter Property="Foreground" Value="{ThemeResource JfInk70}" />
    </Style>

    <!-- Playing on {Device} under the title while a remote session shows (accent text). -->
    <Style x:Key="JfRemoteLineText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource JfAccentText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- The remote session's error: a quieter line below Playing on {Device}. -->
    <Style x:Key="JfQuietLineText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource JfInk50}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ===== Surfaces ===== -->

    <!--
        A grouped surface (Settings groups, cards; Luminous): the Mist tint without live blur over the
        field, so a screen stays within the glass budget, a glass edge and radius r-2xl. Solid Cloud
        when transparency is off. The page casts shadow-1 under it (Controls/Elevation).
    -->
    <Style x:Key="JfCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource JfMistSurface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource JfGlassEdgeSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{th:Token Key=Radius.2xl, Kind=Corner}" />
        <Setter Property="Padding" Value="{th:Token Key=Space.S5, Kind=Thickness}" />
    </Style>

    <!-- Veil glass: bars and the floating mini player (Misty MAT-05). -->
    <Style x:Key="JfVeilCapsuleStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource JfGlassVeil}" />
        <Setter Property="BorderBrush" Value="{ThemeResource JfGlassEdgeSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{th:Token Key=Radius.Full, Kind=Corner}" />
    </Style>

    <!-- Now Playing's dock (Luminous): every control in one floating Veil capsule, 80 high on desktops. -->
    <Style x:Key="JfDockStyle" TargetType="Border" BasedOn="{StaticResource JfVeilCapsuleStyle}">
        <Setter Property="MinHeight" Value="{th:Token Key=Player.BarHeight}" />
        <Setter Property="Padding" Value="20,8,24,8" />
    </Style>

    <!-- ===== Buttons ===== -->

    <!-- A round 44 px icon button (shuffle, repeat, queue, lyrics): rest, hover fill, press fill and 92 %. -->
    <Style x:Key="JfIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource JfInk70}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{th:Token Key=Radius.Full, Kind=Corner}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource JfAccentText}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource JfSky}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" />
                        </Grid.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource JfFillHover}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource JfInk90}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource JfFillPress}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource JfInk90}" />
                                        <Setter Target="Scale.ScaleX" Value="0.92" />
                                        <Setter Target="Scale.ScaleY" Value="0.92" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource JfInk30}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A plain area that acts as a button (the mini player's capsule, header links): hover fill only. -->
    <Style x:Key="JfBareButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource JfInk90}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="{th:Token Key=Radius.Full, Kind=Corner}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource JfAccentText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource JfFillHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource JfFillPress}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Previous and next inside the transport capsule: 52 px, ink-90. -->
    <Style x:Key="JfTransportButtonStyle" TargetType="Button" BasedOn="{StaticResource JfIconButtonStyle}">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Foreground" Value="{ThemeResource JfInk90}" />
    </Style>

    <!-- The one accent fill of Now Playing (Misty COL-04): play/pause, 60 px; hover adds a soft halo. -->
    <Style x:Key="JfPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource JfIconButtonStyle}">
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="60" />
        <Setter Property="Background" Value="{ThemeResource JfAccent}" />
        <Setter Property="Foreground" Value="{ThemeResource JfOnAccent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" />
                        </Grid.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Disc.Background" Value="{ThemeResource JfAccentHover}" />
                                        <Setter Target="Halo.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Disc.Background" Value="{ThemeResource JfAccentPress}" />
                                        <Setter Target="Scale.ScaleX" Value="0.92" />
                                        <Setter Target="Scale.ScaleY" Value="0.92" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Disc.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Halo" Margin="-6" Opacity="0" CornerRadius="{th:Token Key=Radius.Full, Kind=Corner}" Background="{ThemeResource JfAccentSoft}" />
                        <Border x:Name="Disc" Background="{TemplateBinding Background}" CornerRadius="{th:Token Key=Radius.Full, Kind=Corner}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A floating round button on Now Playing's stage (back, mini player): the Mist tint without live blur and a glass edge. -->
    <Style x:Key="JfStageButtonStyle" TargetType="Button" BasedOn="{StaticResource JfIconButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource JfInk90}" />
        <Setter Property="Background" Value="{ThemeResource JfMistSurface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource JfGlassEdgeSoft}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- The album grid's play button: a 36 px Mist glass circle in the cover's bottom start corner. -->
    <Style x:Key="JfGlassPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource JfIconButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Foreground" Value="{ThemeResource JfInk90}" />
        <Setter Property="Background" Value="{ThemeResource JfGlassMist}" />
        <Setter Property="BorderBrush" Value="{ThemeResource JfGlassEdge}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Toggles (shuffle, repeat, lyrics): accent-soft circle with an accent glyph when on (COL-05/06). -->
    <Style x:Key="JfToggleIconButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource JfInk70}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource JfAccentText}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource JfSky}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="Transparent" CornerRadius="{th:Token Key=Radius.Full, Kind=Corner}" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" />
                        </Grid.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource JfFillHover}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource JfInk90}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource JfFillPress}" />
                                        <Setter Target="Scale.ScaleX" Value="0.92" />
                                        <Setter Target="Scale.ScaleY" Value="0.92" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource JfInk30}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource JfAccentSoft}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource JfAccentText}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource JfAccentSoft}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource JfAccentText}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource JfAccentSoft}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource JfAccentText}" />
                                        <Setter Target="Scale.ScaleX" Value="0.92" />
                                        <Setter Target="Scale.ScaleY" Value="0.92" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource JfInk30}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

