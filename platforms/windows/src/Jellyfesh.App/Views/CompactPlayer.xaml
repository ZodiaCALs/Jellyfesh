<?xml version="1.0" encoding="utf-8"?>
<!--
    The compact mini player: the whole window, kept on top (Windows' compact overlay), showing the
    artwork, two lines of type and the transport. The strip at the top moves the window. Its
    progress is a straight 2 px line along the top of the glass (player.mini-progress), as on the
    mini player (v0.0.4), drawn at whole-pixel steps only; play and pause morph.
-->
<UserControl
    x:Class="Jellyfesh.App.Views.CompactPlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jellyfesh.App.Controls"
    xmlns:th="using:Jellyfesh.App.Theming">

    <Grid Background="{ThemeResource JfSky}">
        <Image controls:Artwork.DecodeSize="720" controls:Artwork.Uri="{x:Bind Player.ArtworkUri, Mode=OneWay}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- The window's drag area (its title bar while compact). -->
            <Grid x:Name="DragArea" Background="Transparent" />
            <StackPanel Grid.Row="2" Padding="16,12,16,14" Background="{ThemeResource JfGlassVeil}" BorderBrush="{ThemeResource JfGlassEdgeSoft}" BorderThickness="0,1,0,0" Spacing="10">
                <!-- The progress line: the rest faint, the played part ink-90. -->
                <Grid
                    x:Name="Line"
                    Height="{th:Token Key=Player.MiniProgress}"
                    AutomationProperties.AccessibilityView="Raw"
                    IsHitTestVisible="False"
                    SizeChanged="OnLineSizeChanged">
                    <Border Background="{ThemeResource JfInk10}" CornerRadius="1" />
                    <Border x:Name="ProgressLine" Width="0" HorizontalAlignment="Left" Background="{ThemeResource JfInk90}" CornerRadius="1" />
                </Grid>
                <StackPanel Spacing="2">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource JfInk90}" Text="{x:Bind Player.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource JfInk70}" Text="{x:Bind Player.Artist, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Player_PreviousButton" AutomationProperties.Name="Previous" Command="{x:Bind Player.PreviousCommand}" IsEnabled="{x:Bind Player.CanGoPrevious, Mode=OneWay}" Style="{StaticResource JfIconButtonStyle}" ToolTipService.ToolTip="Previous (Ctrl+←)">
                            <controls:StrokeIcon Data="{StaticResource IconPrevious}" />
                        </Button>
                        <Button AutomationProperties.Name="{x:Bind Player.PlayPauseLabel, Mode=OneWay}" Command="{x:Bind Player.PlayPauseCommand}" Style="{StaticResource JfIconButtonStyle}" ToolTipService.ToolTip="{x:Bind Player.PlayPauseLabel, Mode=OneWay}">
                            <controls:PlayPauseGlyph IsPlaying="{x:Bind Player.IsPlaying, Mode=OneWay}" ReduceMotion="{x:Bind Shell.ReduceMotion, Mode=OneWay}" Size="18" />
                        </Button>
                        <Button x:Uid="Player_NextButton" AutomationProperties.Name="Next" Command="{x:Bind Player.NextCommand}" IsEnabled="{x:Bind Player.CanGoNext, Mode=OneWay}" Style="{StaticResource JfIconButtonStyle}" ToolTipService.ToolTip="Next (Ctrl+→)">
                            <controls:StrokeIcon Data="{StaticResource IconNext}" />
                        </Button>
                    </StackPanel>
                    <Button x:Uid="Compact_Expand" HorizontalAlignment="Right" AutomationProperties.Name="Back to the Full Window" Click="OnExpandClick" Style="{StaticResource JfIconButtonStyle}" ToolTipService.ToolTip="Back to the Full Window">
                        <controls:StrokeIcon Data="{StaticResource IconExpand}" Size="18" />
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
