<?xml version="1.0" encoding="utf-8"?>
<!-- An artist: Play, Shuffle and More (Play Next, Play Last, Add to Playlist…), their albums, and their songs. -->
<shell:JfPage
    x:Class="Jellyfesh.App.Views.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jellyfesh.App.Controls"
    xmlns:shell="using:Jellyfesh.App.Shell">

    <ListView
        x:Name="SongList"
        x:Uid="Artist_Songs"
        Padding="{x:Bind Layout.ScrollPadding, Mode=OneWay}"
        AutomationProperties.Name="Songs"
        IsItemClickEnabled="True"
        ItemClick="OnSongClick"
        ItemContainerStyle="{StaticResource JfTrackRowStyle}"
        ItemTemplate="{StaticResource TrackRowTemplate}"
        ItemsSource="{x:Bind ViewModel.Songs}"
        SelectionMode="None">
        <ListView.Header>
            <StackPanel Margin="0,0,0,12" Spacing="20">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="140" Height="140">
                        <Ellipse Fill="{ThemeResource JfAccentSoft}" />
                        <TextBlock x:Name="Monogram" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="52" FontWeight="Bold" Foreground="{ThemeResource JfAccentText}" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                        <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource JfHeaderTitleText}" Text="{x:Bind ViewModel.Name}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="Action_PlayButton" Command="{x:Bind ViewModel.PlayCommand}" Content="Play" Style="{StaticResource JfAccentPillStyle}" />
                            <Button x:Uid="Action_ShuffleButton" Command="{x:Bind ViewModel.ShuffleCommand}" Content="Shuffle" Style="{StaticResource JfChipButtonStyle}" />
                            <Button x:Uid="More_Button" Width="36" Height="36" AutomationProperties.Name="More" Style="{StaticResource JfIconButtonStyle}" ToolTipService.ToolTip="More">
                                <controls:StrokeIcon Data="{StaticResource IconMore}" Size="18" />
                                <Button.Flyout>
                                    <MenuFlyout Opening="OnMoreOpening" Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem x:Uid="More_PlayNext" Command="{x:Bind ViewModel.PlayNextCommand}" Text="Play Next" />
                                        <MenuFlyoutItem x:Uid="More_PlayLast" Command="{x:Bind ViewModel.PlayLastCommand}" Text="Play Last" />
                                        <MenuFlyoutSubItem x:Name="AddToPlaylistItem" x:Uid="More_AddToPlaylist" Text="Add to Playlist…" />
                                        <MenuFlyoutItem x:Uid="More_GetInfo" Click="OnGetInfoClick" Text="Get Info" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="8" Visibility="{x:Bind shell:Bind.VisibleIfAny(ViewModel.Albums.Count), Mode=OneWay}">
                    <TextBlock x:Uid="Artist_Albums" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Albums" />
                    <GridView
                        x:Name="AlbumShelf"
                        x:Uid="Artist_AlbumList"
                        Height="252"
                        AutomationProperties.Name="Albums"
                        IsItemClickEnabled="True"
                        ItemClick="OnAlbumClick"
                        ItemContainerStyle="{StaticResource JfGridTileStyle}"
                        ItemTemplate="{StaticResource AlbumTileTemplate}"
                        ItemsSource="{x:Bind ViewModel.Albums}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollMode="Enabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        SelectionMode="None">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                </StackPanel>
                <TextBlock x:Uid="Artist_SongsHeading" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Songs" />
            </StackPanel>
        </ListView.Header>
    </ListView>
</shell:JfPage>
