<?xml version="1.0" encoding="utf-8"?>
<!--
    Search (docs/ui.md, ADR-0024 §4), as Jellyfesh Web shows it: one field ("Songs, albums and
    artists", a pill as wide as the reading measure), then the tabs All, Library and one per source
    that found something, pills on a fill track. All: the library's Songs, Albums and Artists (as
    rows), From Your Sources with each source's section ("Searching…" until it answers, "This Source
    Did Not Answer" with its words, or its results; "Content from {Service}" for one that asks for
    credit; an item the core merged names the others, "Also in …"), then "Results from {Service}"
    for each source that keeps its results apart. Library: the library's results. A source's tab:
    its Songs, Albums, Artists and Playlists, each with Show More. A source's album, artist, playlist
    or folder opens its page. Before anything is typed: "Search Your Music"; nothing found: "No
    Results".
-->
<shell:JfPage
    x:Class="Jellyfesh.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jellyfesh.App.Controls"
    xmlns:shell="using:Jellyfesh.App.Shell"
    xmlns:th="using:Jellyfesh.App.Theming"
    xmlns:vm="using:Jellyfesh.ViewModels"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <Style x:Key="InlineListStyle" TargetType="ListView">
            <Setter Property="SelectionMode" Value="None" />
            <Setter Property="IsItemClickEnabled" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource JfTrackRowStyle}" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
    </Page.Resources>

    <Grid Padding="{x:Bind Layout.PagePadding, Mode=OneWay}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="12">
            <TextBlock x:Uid="Search_Title" AutomationProperties.HeadingLevel="Level1" FontSize="{x:Bind Layout.TitleSize, Mode=OneWay}" Style="{StaticResource JfLargeTitleText}" Text="Search" />
            <!-- The field: a pill 48 epx high, as wide as the reading measure (layout.reading). -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="704" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="Box"
                    x:Uid="Search_Box"
                    MinHeight="48"
                    Padding="44,12,16,12"
                    AutomationProperties.Name="Search"
                    CornerRadius="{th:Token Key=Radius.Full, Kind=Corner}"
                    FontSize="16"
                    KeyDown="OnBoxKeyDown"
                    PlaceholderText="Songs, albums and artists"
                    Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <controls:StrokeIcon
                    Margin="16,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Data="{StaticResource IconSearch}"
                    Foreground="{ThemeResource JfInk70}"
                    IsHitTestVisible="False"
                    Size="20" />
            </Grid>
        </StackPanel>

        <!-- The tabs: All, Library, then each source that found something. -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            Visibility="{x:Bind shell:Bind.VisibleIfAny(ViewModel.Tabs.Count), Mode=OneWay}">
            <Border HorizontalAlignment="Left" Padding="4" Background="{ThemeResource JfFill}" CornerRadius="{StaticResource JfFullRadius}">
                <ItemsRepeater x:Uid="Search_Tabs" AutomationProperties.Name="Results" ItemsSource="{x:Bind ViewModel.Tabs}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchTabItem">
                            <controls:SidebarItem Click="OnTabClick" IsChecked="{x:Bind IsSelected, Mode=OneWay}" Label="{x:Bind Title}" Style="{StaticResource JfLibraryTabStyle}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Border>
        </ScrollViewer>

        <ScrollViewer Grid.Row="2">
            <StackPanel Padding="{x:Bind Layout.EndPadding, Mode=OneWay}" Spacing="24">
                <!-- The library's results, on All and on Library. -->
                <StackPanel Spacing="24" Visibility="{x:Bind shell:Bind.Visible(ViewModel.ShowsLibraryResults), Mode=OneWay}">
                <StackPanel Spacing="4" Visibility="{x:Bind shell:Bind.VisibleIfAny(ViewModel.Tracks.Count), Mode=OneWay}">
                    <TextBlock x:Uid="Search_Songs" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Songs" />
                    <ListView x:Name="TrackList" x:Uid="Search_SongList" AutomationProperties.Name="Songs" ItemClick="OnTrackClick" ItemTemplate="{StaticResource TrackRowTemplate}" ItemsSource="{x:Bind ViewModel.Tracks}" Style="{StaticResource InlineListStyle}" />
                </StackPanel>
                <StackPanel Spacing="4" Visibility="{x:Bind shell:Bind.VisibleIfAny(ViewModel.Albums.Count), Mode=OneWay}">
                    <TextBlock x:Uid="Search_Albums" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Albums" />
                    <ListView x:Name="AlbumList" x:Uid="Search_AlbumList" AutomationProperties.Name="Albums" ItemClick="OnAlbumClick" ItemTemplate="{StaticResource AlbumRowTemplate}" ItemsSource="{x:Bind ViewModel.Albums}" Style="{StaticResource InlineListStyle}" />
                </StackPanel>
                <StackPanel Spacing="4" Visibility="{x:Bind shell:Bind.VisibleIfAny(ViewModel.Artists.Count), Mode=OneWay}">
                    <TextBlock x:Uid="Search_Artists" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Artists" />
                    <ListView x:Name="ArtistList" x:Uid="Search_ArtistList" AutomationProperties.Name="Artists" ItemClick="OnArtistClick" ItemTemplate="{StaticResource ArtistRowTemplate}" ItemsSource="{x:Bind ViewModel.Artists}" Style="{StaticResource InlineListStyle}" />
                </StackPanel>
                </StackPanel>
                <StackPanel Spacing="16" Visibility="{x:Bind shell:Bind.VisibleIfAll(ViewModel.ShowsAll, ViewModel.HasOnlineResults), Mode=OneWay}">
                    <TextBlock x:Uid="Search_Online" Margin="0,8,0,0" AutomationProperties.HeadingLevel="Level2" FontSize="{th:Token Key=Type.H3}" FontWeight="Bold" Foreground="{ThemeResource JfInk90}" Text="From Your Sources" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.OnlineGroups}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="24" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SourceResultGroup">
                                <StackPanel Spacing="4" Visibility="{x:Bind shell:Bind.Visible(IsShown), Mode=OneWay}">
                                    <TextBlock AutomationProperties.HeadingLevel="Level3" Style="{StaticResource JfSectionText}" Text="{x:Bind Name}" />
                                    <TextBlock Style="{StaticResource JfListSecondaryText}" Text="{x:Bind Attribution}" Visibility="{x:Bind shell:Bind.Visible(HasAttribution)}" />
                                    <TextBlock x:Uid="Search_Searching" Style="{StaticResource JfSecondaryBodyText}" Text="Searching…" Visibility="{x:Bind shell:Bind.Visible(IsSearching), Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind shell:Bind.Format('Search_NoAnswer', Error), Mode=OneWay}" Visibility="{x:Bind shell:Bind.Visible(HasError), Mode=OneWay}" />
                                    <ListView AutomationProperties.Name="{x:Bind Name}" ItemClick="OnOnlineTrackClick" ItemTemplate="{StaticResource TrackRowTemplate}" ItemsSource="{x:Bind Tracks}" Loaded="OnOnlineTracksLoaded" Style="{StaticResource InlineListStyle}" Visibility="{x:Bind shell:Bind.Visible(HasTracks), Mode=OneWay}" />
                                    <ListView AutomationProperties.Name="{x:Bind Name}" ItemClick="OnEntryClick" ItemTemplate="{StaticResource SourceEntryTemplate}" ItemsSource="{x:Bind Entries}" Loaded="OnOnlineEntriesLoaded" Style="{StaticResource InlineListStyle}" Visibility="{x:Bind shell:Bind.Visible(HasEntries), Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
                <!-- All: a link to each source that keeps its results apart. -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ApartSources}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.ShowsAll), Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SourceResultGroup">
                            <HyperlinkButton Padding="0,4" Click="OnApartClick" Content="{x:Bind shell:Bind.Format('Search_ResultsFrom', Name)}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- A source's tab: its results kind by kind, each with Show More. -->
                <StackPanel Spacing="24" Visibility="{x:Bind shell:Bind.Visible(ViewModel.ShowsSource), Mode=OneWay}">
                    <TextBlock x:Uid="Search_Searching" Style="{StaticResource JfSecondaryBodyText}" Text="Searching…" Visibility="{x:Bind shell:Bind.Visible(ViewModel.SelectedSource.IsSearching), Mode=OneWay}" />
                    <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind shell:Bind.Format('Search_NoAnswer', ViewModel.SelectedSource.Error), Mode=OneWay}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.SelectedSource.HasError), Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedSource.Kinds, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="24" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SearchKindGroup">
                                <StackPanel Spacing="4">
                                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="{x:Bind Title}" />
                                    <ListView AutomationProperties.Name="{x:Bind Title}" ItemClick="OnOnlineTrackClick" ItemTemplate="{StaticResource TrackRowTemplate}" ItemsSource="{x:Bind Tracks}" Loaded="OnOnlineTracksLoaded" Style="{StaticResource InlineListStyle}" Visibility="{x:Bind shell:Bind.Visible(IsSongs)}" />
                                    <ListView AutomationProperties.Name="{x:Bind Title}" ItemClick="OnEntryClick" ItemTemplate="{StaticResource SourceEntryTemplate}" ItemsSource="{x:Bind Entries}" Loaded="OnOnlineEntriesLoaded" Style="{StaticResource InlineListStyle}" Visibility="{x:Bind shell:Bind.Collapsed(IsSongs)}" />
                                    <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind MoreError, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind shell:Bind.Visible(HasMoreError), Mode=OneWay}" />
                                    <Button Margin="0,8,0,0" Command="{x:Bind ShowMoreCommand}" Content="{x:Bind ShowMoreLabel, Mode=OneWay}" Style="{StaticResource JfChipButtonStyle}" Visibility="{x:Bind shell:Bind.Visible(HasMore), Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Style="{StaticResource JfListSecondaryText}" Text="{x:Bind ViewModel.SelectedSource.Attribution, Mode=OneWay}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.SelectedSource.HasAttribution), Mode=OneWay}" />
                </StackPanel>

                <!-- Before anything is typed, and when nothing was found (the other apps' words). -->
                <StackPanel Spacing="4" Visibility="{x:Bind shell:Bind.VisibleIfEmpty(ViewModel.SearchedText), Mode=OneWay}">
                    <TextBlock x:Uid="Search_StartTitle" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Search Your Music" />
                    <TextBlock x:Uid="Search_StartBody" Style="{StaticResource JfSecondaryBodyText}" Text="Find songs, albums and artists in your library and in your sources." />
                </StackPanel>
                <StackPanel Spacing="4" Visibility="{x:Bind shell:Bind.Visible(ViewModel.NothingFound), Mode=OneWay}">
                    <TextBlock x:Uid="Search_NothingFound" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="No Results" />
                    <TextBlock x:Uid="Search_NothingFoundBody" Style="{StaticResource JfSecondaryBodyText}" Text="Try other words." />
                </StackPanel>
                <TextBlock x:Uid="Search_SourcesNotAvailable" Style="{StaticResource JfSecondaryBodyText}" Text="Searching your online sources comes in a later build; your library is searched now." Visibility="{x:Bind shell:Bind.Visible(ViewModel.SourcesNotAvailable), Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</shell:JfPage>
