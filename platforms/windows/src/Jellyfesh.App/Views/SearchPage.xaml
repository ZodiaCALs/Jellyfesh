<?xml version="1.0" encoding="utf-8"?>
<!--
    Unified search (docs/ui.md): one field; the library answers as you type (Songs, Albums, Artists); the
    same words go to every enabled source, whose merged results stream in below under From Your Sources,
    one group per source, with each source's state. Nothing found: No Results.
-->
<shell:JfPage
    x:Class="Jellyfesh.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Jellyfesh.App.Shell"
    xmlns:vm="using:Jellyfesh.ViewModels"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <Style x:Key="InlineListStyle" TargetType="ListView">
            <Setter Property="SelectionMode" Value="None" />
            <Setter Property="IsItemClickEnabled" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource JfTrackRowStyle}" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="ShelfStyle" TargetType="GridView">
            <Setter Property="SelectionMode" Value="None" />
            <Setter Property="IsItemClickEnabled" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource JfGridTileStyle}" />
            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Enabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Padding="32,24,32,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="12">
            <TextBlock x:Uid="Search_Title" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource JfLargeTitleText}" Text="Search" />
            <Grid MaxWidth="720" HorizontalAlignment="Left" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="Box"
                    x:Uid="Search_Box"
                    MinWidth="320"
                    AutomationProperties.Name="Search"
                    KeyDown="OnBoxKeyDown"
                    PlaceholderText="Songs, albums and artists"
                    Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button x:Uid="Search_PlayAll" Grid.Column="1" Command="{x:Bind ViewModel.PlayAllCommand}" Content="Play All" Style="{StaticResource JfChipButtonStyle}" Visibility="{x:Bind shell:Bind.VisibleIfAny(ViewModel.Tracks.Count), Mode=OneWay}" />
            </Grid>
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.SourceStates}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:SourceSearchState">
                        <Border Padding="10,4" BorderBrush="{ThemeResource JfLine}" BorderThickness="1" CornerRadius="{StaticResource JfFullRadius}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing Width="12" Height="12" IsActive="{x:Bind shell:Bind.Not(IsDone), Mode=OneWay}" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource JfInk70}" Text="{x:Bind Name}" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource JfDanger}" Text="{x:Bind Error, Mode=OneWay}" Visibility="{x:Bind shell:Bind.Visible(HasError), Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="0,0,0,112" Spacing="24">
                <StackPanel Spacing="4" Visibility="{x:Bind shell:Bind.VisibleIfAny(ViewModel.Tracks.Count), Mode=OneWay}">
                    <TextBlock x:Uid="Search_Songs" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Songs" />
                    <ListView x:Name="TrackList" x:Uid="Search_SongList" AutomationProperties.Name="Songs" ItemClick="OnTrackClick" ItemTemplate="{StaticResource TrackRowTemplate}" ItemsSource="{x:Bind ViewModel.Tracks}" Style="{StaticResource InlineListStyle}" />
                </StackPanel>
                <StackPanel Spacing="4" Visibility="{x:Bind shell:Bind.VisibleIfAny(ViewModel.Albums.Count), Mode=OneWay}">
                    <TextBlock x:Uid="Search_Albums" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Albums" />
                    <GridView x:Name="AlbumShelf" x:Uid="Search_AlbumList" Height="252" AutomationProperties.Name="Albums" ItemClick="OnAlbumClick" ItemTemplate="{StaticResource AlbumTileTemplate}" ItemsSource="{x:Bind ViewModel.Albums}" Style="{StaticResource ShelfStyle}" />
                </StackPanel>
                <StackPanel Spacing="4" Visibility="{x:Bind shell:Bind.VisibleIfAny(ViewModel.Artists.Count), Mode=OneWay}">
                    <TextBlock x:Uid="Search_Artists" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Artists" />
                    <GridView x:Name="ArtistShelf" x:Uid="Search_ArtistList" Height="212" AutomationProperties.Name="Artists" ItemClick="OnArtistClick" ItemTemplate="{StaticResource ArtistTileTemplate}" ItemsSource="{x:Bind ViewModel.Artists}" Style="{StaticResource ShelfStyle}" />
                </StackPanel>
                <StackPanel Spacing="8" Visibility="{x:Bind shell:Bind.Visible(ViewModel.HasOnlineResults), Mode=OneWay}">
                    <TextBlock x:Uid="Search_Online" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="From Your Sources" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.OnlineGroups}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="16" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SourceResultGroup">
                                <StackPanel Spacing="4">
                                    <TextBlock AutomationProperties.HeadingLevel="Level3" Style="{StaticResource JfListTitleText}" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                    <ListView AutomationProperties.Name="{x:Bind Name}" ItemClick="OnOnlineTrackClick" ItemTemplate="{StaticResource TrackRowTemplate}" ItemsSource="{x:Bind Tracks}" Loaded="OnOnlineTracksLoaded" Style="{StaticResource InlineListStyle}" Visibility="{x:Bind shell:Bind.Visible(HasTracks)}" />
                                    <ListView AutomationProperties.Name="{x:Bind Name}" ItemClick="OnEntryClick" ItemTemplate="{StaticResource SourceEntryTemplate}" ItemsSource="{x:Bind Entries}" Loaded="OnOnlineEntriesLoaded" Style="{StaticResource InlineListStyle}" Visibility="{x:Bind shell:Bind.Visible(HasEntries)}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
                <TextBlock x:Uid="Search_NothingFound" Style="{StaticResource JfSecondaryBodyText}" Text="No Results" Visibility="{x:Bind shell:Bind.VisibleIfNothingFound(ViewModel.SearchedText, ViewModel.HasResults, ViewModel.IsSearchingSources), Mode=OneWay}" />
                <TextBlock x:Uid="Search_SourcesNotAvailable" Style="{StaticResource JfSecondaryBodyText}" Text="Searching your online sources comes in a later build; your library is searched now." Visibility="{x:Bind shell:Bind.Visible(ViewModel.SourcesNotAvailable), Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</shell:JfPage>
