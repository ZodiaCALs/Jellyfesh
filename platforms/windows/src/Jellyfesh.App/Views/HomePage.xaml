<?xml version="1.0" encoding="utf-8"?>
<!--
    Home (docs/ui.md): the library's size, then Recently Added (albums, a shelf that scrolls sideways),
    Recently Played and Most Played (songs as rows on one surface, as in the other apps). With nothing
    in the library and no source signed in, the welcome instead, with Add Music Folder… and Add a
    Source.
-->
<shell:JfPage
    x:Class="Jellyfesh.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Jellyfesh.App.Shell"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <!-- A row of album tiles that scrolls sideways inside the page. -->
        <Style x:Key="ShelfStyle" TargetType="GridView">
            <Setter Property="Height" Value="232" />
            <Setter Property="SelectionMode" Value="None" />
            <Setter Property="IsItemClickEnabled" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource JfGridTileStyle}" />
            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Enabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel x:Name="SectionsPanel" Padding="{x:Bind Layout.ScrollPadding, Mode=OneWay}" Spacing="28">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="Home_Title" AutomationProperties.HeadingLevel="Level1" FontSize="{x:Bind Layout.TitleSize, Mode=OneWay}" Style="{StaticResource JfLargeTitleText}" Text="Home" />
                <!-- Summary: shown while the look lists it (ADR-0020). -->
                <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind ViewModel.LibrarySize, Mode=OneWay}" Visibility="{x:Bind shell:Bind.VisibleIfTextAnd(ViewModel.LibrarySize, ViewModel.ShowsSummary), Mode=OneWay}" />
            </StackPanel>

            <StackPanel MaxWidth="560" HorizontalAlignment="Left" Spacing="12" Visibility="{x:Bind shell:Bind.VisibleIfButNot(ViewModel.ShowWelcome, ViewModel.IsLoading), Mode=OneWay}">
                <TextBlock x:Uid="Home_EmptyTitle" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Welcome to Jellyfesh" />
                <TextBlock x:Uid="Home_EmptyBody" Style="{StaticResource JfSecondaryBodyText}" Text="Add your music folders, or connect a server in Sources." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="Common_AddMusicFolder" Command="{x:Bind ViewModel.AddFolderCommand}" Content="Add Music Folder…" Style="{StaticResource JfAccentPillStyle}" />
                    <Button x:Uid="Home_AddSource" Click="OnAddSource" Content="Add a Source" Style="{StaticResource JfChipButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="RecentlyAddedSection" Spacing="8" Visibility="{x:Bind shell:Bind.VisibleIfAnyAnd(ViewModel.RecentlyAdded.Count, ViewModel.ShowsRecentlyAdded), Mode=OneWay}">
                <TextBlock x:Uid="Home_RecentlyAdded" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Recently Added" />
                <GridView x:Name="AddedShelf" x:Uid="Home_RecentlyAddedList" Height="252" AutomationProperties.Name="Recently Added" ItemClick="OnAlbumClick" ItemTemplate="{StaticResource AlbumTileTemplate}" ItemsSource="{x:Bind ViewModel.RecentlyAdded}" Style="{StaticResource ShelfStyle}" />
            </StackPanel>

            <StackPanel x:Name="RecentlyPlayedSection" Spacing="8" Visibility="{x:Bind shell:Bind.VisibleIfAnyAnd(ViewModel.RecentlyPlayed.Count, ViewModel.ShowsRecentlyPlayed), Mode=OneWay}">
                <TextBlock x:Uid="Home_RecentlyPlayed" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Recently Played" />
                <Border Padding="8" Style="{StaticResource JfCardStyle}">
                    <ListView x:Name="PlayedList" x:Uid="Home_RecentlyPlayedList" AutomationProperties.Name="Recently Played" IsItemClickEnabled="True" ItemClick="OnTrackClick" ItemContainerStyle="{StaticResource JfTrackRowStyle}" ItemTemplate="{StaticResource TrackRowTemplate}" ItemsSource="{x:Bind ViewModel.RecentlyPlayed}" ScrollViewer.VerticalScrollMode="Disabled" SelectionMode="None" />
                </Border>
            </StackPanel>

            <StackPanel x:Name="MostPlayedSection" Spacing="8" Visibility="{x:Bind shell:Bind.VisibleIfAnyAnd(ViewModel.MostPlayed.Count, ViewModel.ShowsMostPlayed), Mode=OneWay}">
                <TextBlock x:Uid="Home_MostPlayed" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Most Played" />
                <Border Padding="8" Style="{StaticResource JfCardStyle}">
                    <ListView x:Name="MostList" x:Uid="Home_MostPlayedList" AutomationProperties.Name="Most Played" IsItemClickEnabled="True" ItemClick="OnTrackClick" ItemContainerStyle="{StaticResource JfTrackRowStyle}" ItemTemplate="{StaticResource TrackRowTemplate}" ItemsSource="{x:Bind ViewModel.MostPlayed}" ScrollViewer.VerticalScrollMode="Disabled" SelectionMode="None" />
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</shell:JfPage>
