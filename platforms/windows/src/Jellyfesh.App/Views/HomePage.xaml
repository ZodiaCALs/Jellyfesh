<?xml version="1.0" encoding="utf-8"?>
<shell:JfPage
    x:Class="Jellyfesh.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Jellyfesh.App.Shell"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <!-- A row of tiles that scrolls sideways inside the page. -->
        <Style x:Key="ShelfStyle" TargetType="GridView">
            <Setter Property="Height" Value="232" />
            <Setter Property="SelectionMode" Value="None" />
            <Setter Property="IsItemClickEnabled" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource JfGridTileStyle}" />
            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Enabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,24,32,112" Spacing="28">
            <TextBlock x:Uid="Home_Title" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource JfLargeTitleText}" Text="Home" />

            <StackPanel MaxWidth="560" HorizontalAlignment="Left" Spacing="12" Visibility="{x:Bind shell:Bind.VisibleIfButNot(ViewModel.IsEmpty, ViewModel.IsLoading), Mode=OneWay}">
                <TextBlock x:Uid="Home_EmptyTitle" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Your library is empty" />
                <TextBlock x:Uid="Home_EmptyBody" Style="{StaticResource JfSecondaryBodyText}" Text="Add a folder of music and Jellyfesh will find your songs, albums and lyrics." />
                <Button x:Uid="Home_AddFolder" HorizontalAlignment="Left" Click="OnAddFolder" Content="Add a music folder" Style="{StaticResource JfAccentPillStyle}" />
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind shell:Bind.VisibleIfAny(ViewModel.RecentlyAdded.Count), Mode=OneWay}">
                <TextBlock x:Uid="Home_RecentlyAdded" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Recently added" />
                <GridView x:Name="AddedShelf" x:Uid="Home_RecentlyAddedList" AutomationProperties.Name="Recently added" ItemClick="OnTrackClick" ItemTemplate="{StaticResource TrackTileTemplate}" ItemsSource="{x:Bind ViewModel.RecentlyAdded}" Style="{StaticResource ShelfStyle}" />
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind shell:Bind.VisibleIfAny(ViewModel.RecentlyPlayed.Count), Mode=OneWay}">
                <TextBlock x:Uid="Home_RecentlyPlayed" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Recently played" />
                <GridView x:Name="PlayedShelf" x:Uid="Home_RecentlyPlayedList" AutomationProperties.Name="Recently played" ItemClick="OnTrackClick" ItemTemplate="{StaticResource TrackTileTemplate}" ItemsSource="{x:Bind ViewModel.RecentlyPlayed}" Style="{StaticResource ShelfStyle}" />
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind shell:Bind.VisibleIfAny(ViewModel.MostPlayed.Count), Mode=OneWay}">
                <TextBlock x:Uid="Home_MostPlayed" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Most played" />
                <GridView x:Name="MostShelf" x:Uid="Home_MostPlayedList" AutomationProperties.Name="Most played" ItemClick="OnTrackClick" ItemTemplate="{StaticResource TrackTileTemplate}" ItemsSource="{x:Bind ViewModel.MostPlayed}" Style="{StaticResource ShelfStyle}" />
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind shell:Bind.VisibleIfAny(ViewModel.Playlists.Count), Mode=OneWay}">
                <TextBlock x:Uid="Home_Playlists" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Playlists" />
                <GridView x:Name="PlaylistShelf" x:Uid="Home_PlaylistsList" Height="252" AutomationProperties.Name="Playlists" ItemClick="OnPlaylistClick" ItemTemplate="{StaticResource PlaylistTileTemplate}" ItemsSource="{x:Bind ViewModel.Playlists}" Style="{StaticResource ShelfStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</shell:JfPage>
