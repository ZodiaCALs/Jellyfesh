<?xml version="1.0" encoding="utf-8"?>
<!-- Every artist, as a virtualised list (docs/ui.md). Empty: No Artists Yet and Add Music Folder…. -->
<shell:JfPage
    x:Class="Jellyfesh.App.Views.ArtistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Jellyfesh.App.Shell"
    NavigationCacheMode="Enabled">

    <Grid Padding="{x:Bind Layout.PagePadding, Mode=OneWay}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ListView
            x:Name="ArtistList"
            x:Uid="Artists_Grid"
            Grid.RowSpan="2"
            Padding="{x:Bind Layout.EndPadding, Mode=OneWay}"
            AutomationProperties.Name="Artists"
            IsItemClickEnabled="True"
            ItemClick="OnArtistClick"
            ItemContainerStyle="{StaticResource JfTrackRowStyle}"
            ItemTemplate="{StaticResource ArtistRowTemplate}"
            ItemsSource="{x:Bind ViewModel.Artists.Items, Mode=OneWay}"
            SelectionMode="None">
            <ListView.Header>
                <TextBlock Margin="0,0,0,16" x:Uid="Artists_Title" AutomationProperties.HeadingLevel="Level1" FontSize="{x:Bind Layout.TitleSize, Mode=OneWay}" Style="{StaticResource JfLargeTitleText}" Text="Artists" />
            </ListView.Header>
        </ListView>
        <ProgressRing Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <StackPanel Grid.Row="1" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind shell:Bind.VisibleIfButNot(ViewModel.IsEmpty, ViewModel.IsLoading), Mode=OneWay}">
            <TextBlock x:Uid="Artists_EmptyTitle" HorizontalAlignment="Center" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="No Artists Yet" />
            <TextBlock x:Uid="Artists_Empty" HorizontalAlignment="Center" Style="{StaticResource JfSecondaryBodyText}" Text="Add a music folder to see your artists here." TextAlignment="Center" />
            <Button x:Uid="Common_AddMusicFolder" HorizontalAlignment="Center" Command="{x:Bind ViewModel.AddFolderCommand}" Content="Add Music Folder…" Style="{StaticResource JfAccentPillStyle}" />
        </StackPanel>
    </Grid>
</shell:JfPage>
