<?xml version="1.0" encoding="utf-8"?>
<shell:JfPage
    x:Class="Jellyfesh.App.Views.ArtistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Jellyfesh.App.Shell"
    NavigationCacheMode="Enabled">

    <Grid Padding="32,24,32,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <GridView
            x:Name="ArtistGrid"
            x:Uid="Artists_Grid"
            Grid.RowSpan="2"
            Padding="0,0,0,112"
            AutomationProperties.Name="Artists"
            IsItemClickEnabled="True"
            ItemClick="OnArtistClick"
            ItemContainerStyle="{StaticResource JfGridTileStyle}"
            ItemTemplate="{StaticResource ArtistTileTemplate}"
            ItemsSource="{x:Bind ViewModel.Artists.Items, Mode=OneWay}"
            SelectionMode="None">
            <GridView.Header>
                <TextBlock Margin="0,0,0,16" x:Uid="Artists_Title" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource JfLargeTitleText}" Text="Artists" />
            </GridView.Header>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid ItemHeight="200" ItemWidth="152" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>
        <ProgressRing Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <TextBlock x:Uid="Artists_Empty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource JfSecondaryBodyText}" Text="No artists yet." Visibility="{x:Bind shell:Bind.VisibleIfButNot(ViewModel.IsEmpty, ViewModel.IsLoading), Mode=OneWay}" />
    </Grid>
</shell:JfPage>
