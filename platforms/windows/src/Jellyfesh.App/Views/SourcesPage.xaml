<?xml version="1.0" encoding="utf-8"?>
<!--
    Sources (docs/ui.md): the intro line, Add a Source (the core's presets, through the Connect dialog),
    Your Sources (each installed source with its status; choosing one browses it) and Sources Settings….
    Browsing a source shows its catalogue behind a breadcrumb whose first crumb leads back here: drill into
    folders and artists, play albums and playlists whole. Rows with a link offer Open in {Service} (an
    item that cannot play here opens it when chosen), and so does More for an artist being browsed.
-->
<shell:JfPage
    x:Class="Jellyfesh.App.Views.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jellyfesh.App.Controls"
    xmlns:shell="using:Jellyfesh.App.Shell"
    xmlns:vm="using:Jellyfesh.ViewModels"
    NavigationCacheMode="Enabled">

    <Grid Padding="32,24,32,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="Sources_Title" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource JfLargeTitleText}" Text="Sources" />

        <!-- ===== The list: intro, Add a Source, Your Sources, Sources Settings… ===== -->
        <ScrollViewer Grid.Row="1" Visibility="{x:Bind shell:Bind.Collapsed(ViewModel.IsSourceOpen), Mode=OneWay}">
            <StackPanel MaxWidth="720" Padding="0,0,0,112" HorizontalAlignment="Left" Spacing="24">
                <TextBlock x:Uid="Sources_Intro" Style="{StaticResource JfSecondaryBodyText}" Text="Sources bring music from servers and services into Jellyfesh." />

                <StackPanel Spacing="8" Visibility="{x:Bind shell:Bind.VisibleIfAny(ViewModel.Presets.Count), Mode=OneWay}">
                    <TextBlock x:Uid="Sources_AddHeading" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Add a Source" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Presets}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SourcePresetViewModel">
                                <Button
                                    Padding="12"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.HelpText="{x:Bind Subtitle}"
                                    AutomationProperties.Name="{x:Bind Name}"
                                    Background="{ThemeResource JfCloudSoft}"
                                    Click="OnPresetClick"
                                    CornerRadius="10"
                                    Style="{StaticResource JfBareButtonStyle}"
                                    Tag="{x:Bind}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon VerticalAlignment="Center" FontSize="24" Foreground="{ThemeResource JfInk70}" Glyph="&#xE753;" Visibility="{x:Bind shell:Bind.Collapsed(HasIcon)}" />
                                        <Image Width="32" Height="32" VerticalAlignment="Center" controls:Artwork.DecodeSize="64" controls:Artwork.Uri="{x:Bind IconUri}" AutomationProperties.AccessibilityView="Raw" Visibility="{x:Bind shell:Bind.Visible(HasIcon)}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource JfInk90}" Text="{x:Bind Name}" />
                                            <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind Subtitle}" Visibility="{x:Bind shell:Bind.VisibleIf(Subtitle)}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Sources_Yours" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="Your Sources" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Choices}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SourceChoice">
                                <Button
                                    Padding="12"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="{x:Bind AccessibleName}"
                                    Background="{ThemeResource JfCloudSoft}"
                                    Click="OnSourceClick"
                                    CornerRadius="10"
                                    IsEnabled="{x:Bind CanBrowse}"
                                    Style="{StaticResource JfBareButtonStyle}"
                                    Tag="{x:Bind}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon VerticalAlignment="Center" FontSize="24" Foreground="{ThemeResource JfInk70}" Glyph="&#xE753;" Visibility="{x:Bind shell:Bind.Collapsed(HasIcon)}" />
                                        <Image Width="32" Height="32" VerticalAlignment="Center" controls:Artwork.DecodeSize="64" controls:Artwork.Uri="{x:Bind IconUri}" AutomationProperties.AccessibilityView="Raw" Visibility="{x:Bind shell:Bind.Visible(HasIcon)}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource JfInk90}" Text="{x:Bind Name}" />
                                                <Border Padding="8,1" VerticalAlignment="Center" Background="{ThemeResource JfAccentSoft}" CornerRadius="{StaticResource JfFullRadius}">
                                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="{ThemeResource JfAccentText}" Text="{x:Bind BadgeLabel}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind Status}" Visibility="{x:Bind shell:Bind.VisibleIf(Status)}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <StackPanel Spacing="2" Visibility="{x:Bind shell:Bind.Visible(ViewModel.IsEmpty), Mode=OneWay}">
                        <TextBlock x:Uid="Sources_EmptyTitle" Style="{StaticResource JfBodyText}" FontWeight="SemiBold" Text="No Sources Installed" />
                        <TextBlock x:Uid="Sources_EmptyBody" Style="{StaticResource JfSecondaryBodyText}" Text="Install a source plugin from a .jfpkg file." />
                    </StackPanel>
                </StackPanel>

                <Button x:Uid="Sources_Manage" Click="OnManageClick" Content="Sources Settings…" Style="{StaticResource JfChipButtonStyle}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ===== A source's catalogue ===== -->
        <Grid Grid.Row="1" RowSpacing="16" Visibility="{x:Bind shell:Bind.Visible(ViewModel.IsSourceOpen), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <BreadcrumbBar x:Name="Crumbs" VerticalAlignment="Center" ItemClicked="OnCrumbClicked" ItemsSource="{x:Bind ViewModel.Path}" />
                <Button
                    x:Uid="More_Button"
                    Grid.Column="1"
                    AutomationProperties.Name="More"
                    Style="{StaticResource JfIconButtonStyle}"
                    ToolTipService.ToolTip="More"
                    Visibility="{x:Bind shell:Bind.VisibleIf(ViewModel.LevelLink), Mode=OneWay}">
                    <controls:StrokeIcon Data="{StaticResource IconMore}" Size="18" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Command="{x:Bind ViewModel.OpenLevelLinkCommand}" Text="{x:Bind ViewModel.OpenInLabel, Mode=OneWay}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1">
                <StackPanel Padding="0,0,0,112" Spacing="8">
                    <ListView x:Name="EntryList" x:Uid="Sources_Entries" AutomationProperties.Name="Folders, Albums and Playlists" IsItemClickEnabled="True" ItemClick="OnEntryClick" ItemContainerStyle="{StaticResource JfTrackRowStyle}" ItemTemplate="{StaticResource SourceEntryTemplate}" ItemsSource="{x:Bind ViewModel.Entries}" ScrollViewer.VerticalScrollMode="Disabled" SelectionMode="None" />
                    <ListView x:Name="TrackList" x:Uid="Sources_Tracks" AutomationProperties.Name="Songs" IsItemClickEnabled="True" ItemClick="OnTrackClick" ItemContainerStyle="{StaticResource JfTrackRowStyle}" ItemTemplate="{StaticResource TrackRowTemplate}" ItemsSource="{x:Bind ViewModel.Tracks}" ScrollViewer.VerticalScrollMode="Disabled" SelectionMode="None" />
                    <ProgressRing HorizontalAlignment="Center" IsActive="{x:Bind ViewModel.IsBrowsing, Mode=OneWay}" />
                    <Button x:Uid="Sources_More" HorizontalAlignment="Center" Command="{x:Bind ViewModel.LoadMoreCommand}" Content="Show More" Style="{StaticResource JfChipButtonStyle}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.HasNextPage), Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource JfDanger}" Style="{StaticResource JfBodyText}" Text="{x:Bind ViewModel.Error, Mode=OneWay}" Visibility="{x:Bind shell:Bind.VisibleIf(ViewModel.Error), Mode=OneWay}" />
                    <TextBlock x:Uid="Common_NotAvailable" Style="{StaticResource JfSecondaryBodyText}" Text="Coming in a later build." Visibility="{x:Bind shell:Bind.Visible(ViewModel.IsNotAvailable), Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</shell:JfPage>
