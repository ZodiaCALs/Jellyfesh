<?xml version="1.0" encoding="utf-8"?>
<!--
    A source's sign-in, drawn natively from the core's steps (architecture §10): a QR code to scan,
    a page to finish in the browser, fields to fill, or a wait. Secrets go to the core once and are
    never kept (ADR-0015).
-->
<ContentDialog
    x:Class="Jellyfesh.App.Views.SignInDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jellyfesh.App.Controls"
    xmlns:shell="using:Jellyfesh.App.Shell"
    xmlns:vm="using:Jellyfesh.ViewModels"
    CloseButtonClick="OnCloseClick"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick">

    <StackPanel MinWidth="360" MaxWidth="440" Spacing="16">
        <StackPanel x:Name="WaitingPanel" Orientation="Horizontal" Spacing="12">
            <ProgressRing Width="24" Height="24" IsActive="True" />
            <TextBlock x:Name="WaitingText" VerticalAlignment="Center" Style="{StaticResource JfBodyText}" Text="{x:Bind Flow.Message, Mode=OneWay}" />
        </StackPanel>

        <StackPanel x:Name="QrPanel" Spacing="12" Visibility="Collapsed">
            <TextBlock x:Uid="SignIn_ScanQr" Style="{StaticResource JfBodyText}" Text="Scan this code with the service's app on your phone." />
            <controls:QrCodeView Width="248" Height="248" HorizontalAlignment="Center" AutomationProperties.Name="QR code" x:Uid="SignIn_QrCode" Code="{x:Bind Flow.Qr, Mode=OneWay}" />
            <Button x:Uid="SignIn_CopyLink" HorizontalAlignment="Center" Command="{x:Bind Flow.CopyLinkCommand}" Content="Copy the link instead" Style="{StaticResource JfChipButtonStyle}" />
        </StackPanel>

        <StackPanel x:Name="UrlPanel" Spacing="12" Visibility="Collapsed">
            <TextBlock x:Uid="SignIn_Browser" Style="{StaticResource JfBodyText}" Text="Finish signing in in your browser. Jellyfesh continues by itself when you are done." />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="SignIn_OpenAgain" Command="{x:Bind Flow.OpenBrowserCommand}" Content="Open the page again" Style="{StaticResource JfChipButtonStyle}" />
                <Button x:Uid="SignIn_CopyLinkShort" Command="{x:Bind Flow.CopyLinkCommand}" Content="Copy the link" Style="{StaticResource JfChipButtonStyle}" />
            </StackPanel>
        </StackPanel>

        <ItemsRepeater x:Name="FieldsPanel" ItemsSource="{x:Bind Flow.Fields}" Visibility="Collapsed">
            <ItemsRepeater.Layout>
                <StackLayout Spacing="12" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:SignInField">
                    <Grid>
                        <TextBox Header="{x:Bind Label}" PlaceholderText="{x:Bind Placeholder}" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{x:Bind shell:Bind.Collapsed(IsSecret)}" />
                        <PasswordBox Header="{x:Bind Label}" Password="{x:Bind Value, Mode=TwoWay}" PlaceholderText="{x:Bind Placeholder}" Visibility="{x:Bind shell:Bind.Visible(IsSecret)}" />
                    </Grid>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <TextBlock x:Name="ResultText" Style="{StaticResource JfBodyText}" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
