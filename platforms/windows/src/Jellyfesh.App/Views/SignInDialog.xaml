<?xml version="1.0" encoding="utf-8"?>
<!--
    A source's sign-in, drawn natively from the core's steps (architecture §10): a QR code to scan
    (with the plugin's sentence), a code to enter on another device shown large (Jellyfin's Quick
    Connect), a page to finish in the browser, fields as the plugin describes them, or a wait.
    Secrets go to the core once and are never kept (ADR-0015).
-->
<ContentDialog
    x:Class="Jellyfesh.App.Views.SignInDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jellyfesh.App.Controls"
    xmlns:shell="using:Jellyfesh.App.Shell"
    xmlns:vm="using:Jellyfesh.ViewModels"
    CloseButtonClick="OnCloseClick"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick">

    <StackPanel MinWidth="360" MaxWidth="440" Spacing="16">
        <StackPanel x:Name="WaitingPanel" Orientation="Horizontal" Spacing="12">
            <ProgressRing Width="24" Height="24" IsActive="True" />
            <TextBlock x:Name="WaitingText" VerticalAlignment="Center" Style="{StaticResource JfBodyText}" Text="{x:Bind Flow.Message, Mode=OneWay}" />
        </StackPanel>

        <StackPanel x:Name="QrPanel" Spacing="12" Visibility="Collapsed">
            <TextBlock Style="{StaticResource JfBodyText}" Text="{x:Bind Flow.QrHint, Mode=OneWay}" />
            <controls:QrCodeView Width="248" Height="248" HorizontalAlignment="Center" AutomationProperties.Name="QR code" x:Uid="SignIn_QrCode" Code="{x:Bind Flow.Qr, Mode=OneWay}" />
            <Button x:Uid="SignIn_CopyLink" HorizontalAlignment="Center" Command="{x:Bind Flow.CopyLinkCommand}" Content="Copy the Link Instead" Style="{StaticResource JfChipButtonStyle}" />
        </StackPanel>

        <!-- Jellyfin's Quick Connect: the code large and selectable, read out a character at a time, the plugin's words for where to enter it. -->
        <StackPanel x:Name="CodePanel" Spacing="12" Visibility="Collapsed">
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.Name="{x:Bind Flow.CodeSpoken, Mode=OneWay}"
                CharacterSpacing="300"
                FontSize="40"
                FontWeight="Bold"
                Foreground="{ThemeResource JfInk90}"
                IsTextSelectionEnabled="True"
                Text="{x:Bind Flow.Code, Mode=OneWay}"
                Typography.NumeralAlignment="Tabular" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind Flow.CodeHint, Mode=OneWay}" TextAlignment="Center" />
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <ProgressRing Width="16" Height="16" IsActive="True" />
                <TextBlock x:Uid="SignIn_WaitingApproval" VerticalAlignment="Center" Style="{StaticResource JfSecondaryBodyText}" Text="Waiting for approval…" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="UrlPanel" Spacing="12" Visibility="Collapsed">
            <TextBlock x:Uid="SignIn_Browser" Style="{StaticResource JfBodyText}" Text="Continue in your browser. Come back here when you are done." />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="SignIn_OpenAgain" Command="{x:Bind Flow.OpenBrowserCommand}" Content="Open Browser Again" Style="{StaticResource JfChipButtonStyle}" />
                <Button x:Uid="SignIn_CopyLinkShort" Command="{x:Bind Flow.CopyLinkCommand}" Content="Copy the Link" Style="{StaticResource JfChipButtonStyle}" />
            </StackPanel>
        </StackPanel>

        <ItemsRepeater x:Name="FieldsPanel" ItemsSource="{x:Bind Flow.Fields}" Visibility="Collapsed">
            <ItemsRepeater.Layout>
                <StackLayout Spacing="12" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <!-- The label, the line under it ("Optional", the plugin's help), the keyboard for its kind; a pasted Cookie header gets several lines. -->
                <DataTemplate x:DataType="vm:SignInField">
                    <Grid>
                        <TextBox
                            AcceptsReturn="{x:Bind IsMultiline}"
                            Description="{x:Bind Note}"
                            Header="{x:Bind Label}"
                            InputScope="{x:Bind shell:Bind.InputScopeFor(Kind)}"
                            IsSpellCheckEnabled="False"
                            MaxHeight="160"
                            PlaceholderText="{x:Bind Placeholder}"
                            Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="{x:Bind shell:Bind.Wrap(IsMultiline)}"
                            Visibility="{x:Bind shell:Bind.Collapsed(IsSecret)}" />
                        <PasswordBox
                            Description="{x:Bind Note}"
                            Header="{x:Bind Label}"
                            Password="{x:Bind Value, Mode=TwoWay}"
                            PlaceholderText="{x:Bind Placeholder}"
                            Visibility="{x:Bind shell:Bind.Visible(IsSecret)}" />
                    </Grid>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <TextBlock x:Name="ResultText" Style="{StaticResource JfBodyText}" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
