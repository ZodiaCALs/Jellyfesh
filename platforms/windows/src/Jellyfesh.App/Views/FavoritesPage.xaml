<?xml version="1.0" encoding="utf-8"?>
<shell:JfPage
    x:Class="Jellyfesh.App.Views.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Jellyfesh.App.Shell"
    xmlns:views="using:Jellyfesh.App.Views"
    NavigationCacheMode="Enabled">

    <Grid Padding="{x:Bind Layout.PagePadding, Mode=OneWay}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ListView
            x:Name="FavoriteList"
            x:Uid="Favorites_List"
            Grid.RowSpan="2"
            Padding="{x:Bind Layout.EndPadding, Mode=OneWay}"
            AutomationProperties.Name="Favourites"
            IsItemClickEnabled="True"
            ItemClick="OnTrackClick"
            ItemContainerStyle="{StaticResource JfTrackRowStyle}"
            ItemTemplate="{StaticResource TrackRowTemplate}"
            ItemsSource="{x:Bind ViewModel.Favorites.Items, Mode=OneWay}"
            SelectionMode="None">
            <ListView.Header>
                <Grid Margin="0,0,0,16" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Favorites_Title" AutomationProperties.HeadingLevel="Level1" FontSize="{x:Bind Layout.TitleSize, Mode=OneWay}" Style="{StaticResource JfLargeTitleText}" Text="Favourites" />
                    <Button x:Uid="Action_PlayButton" Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.PlayCommand}" Content="Play" IsEnabled="{x:Bind shell:Bind.Not(ViewModel.IsEmpty), Mode=OneWay}" Style="{StaticResource JfAccentPillStyle}" />
                    <Button x:Uid="Action_ShuffleButton" Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.ShuffleCommand}" Content="Shuffle" IsEnabled="{x:Bind shell:Bind.Not(ViewModel.IsEmpty), Mode=OneWay}" Style="{StaticResource JfChipButtonStyle}" />
                </Grid>
            </ListView.Header>
            <!-- Then each source's likes (ADR-0024 §3). -->
            <ListView.Footer>
                <views:SourceSections x:Name="SourceLists" />
            </ListView.Footer>
        </ListView>
        <StackPanel Grid.Row="1" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind shell:Bind.VisibleIfButNeither(ViewModel.IsEmpty, ViewModel.IsLoading, ViewModel.Sources.HasSections), Mode=OneWay}">
            <TextBlock x:Uid="Favorites_EmptyTitle" HorizontalAlignment="Center" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="No Favourites Yet" />
            <TextBlock x:Uid="Favorites_Empty" HorizontalAlignment="Center" Style="{StaticResource JfSecondaryBodyText}" Text="Songs you mark with the heart appear here." TextAlignment="Center" />
        </StackPanel>
        <TextBlock x:Uid="Common_NotAvailable" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource JfSecondaryBodyText}" Text="Coming in a later build." Visibility="{x:Bind shell:Bind.Visible(ViewModel.IsNotAvailable), Mode=OneWay}" />
    </Grid>
</shell:JfPage>
