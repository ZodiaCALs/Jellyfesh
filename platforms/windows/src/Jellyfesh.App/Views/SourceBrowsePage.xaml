<?xml version="1.0" encoding="utf-8"?>
<!--
    A page of a source's catalogue (docs/ui.md, "Sources"; the web's source page is the model): an
    album or a playlist has the large header after Apple Music (240 epx artwork, the kind, the title,
    the artist in accent text, the song count, Play in the page's accent, Shuffle on glass, More) and
    the "12 songs, 48 minutes" footer; the source's top level, a folder or an artist lists what it
    holds under its title. Rows come in the source's own order, albums, folders and songs mixed;
    choosing an album, artist, playlist or folder opens its page, choosing a song plays it with the
    rest after it. "Content from {Service}" for a source that asks for credit.
-->
<shell:JfPage
    x:Class="Jellyfesh.App.Views.SourceBrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jellyfesh.App.Controls"
    xmlns:shell="using:Jellyfesh.App.Shell"
    xmlns:th="using:Jellyfesh.App.Theming">

    <ListView
        x:Name="RowList"
        Padding="32,24,32,112"
        AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"
        IsItemClickEnabled="True"
        ItemClick="OnRowClick"
        ItemContainerStyle="{StaticResource JfTrackRowStyle}"
        ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
        SelectionMode="None">
        <ListView.Header>
            <StackPanel Margin="0,0,0,16" Spacing="16">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="240"
                        Height="240"
                        VerticalAlignment="Top"
                        Background="{ThemeResource JfFill}"
                        CornerRadius="{th:Token Key=Artwork.RadiusGrid, Kind=Corner}"
                        Visibility="{x:Bind shell:Bind.Visible(ViewModel.IsCollection), Mode=OneWay}">
                        <Image controls:Artwork.DecodeSize="480" controls:Artwork.Uri="{x:Bind ViewModel.Header.ArtworkUri, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                        <TextBlock Style="{StaticResource JfCaptionText}" Text="{x:Bind ViewModel.KindLabel, Mode=OneWay}" Visibility="{x:Bind shell:Bind.VisibleIf(ViewModel.KindLabel), Mode=OneWay}" />
                        <TextBlock AutomationProperties.HeadingLevel="Level1" MaxLines="2" Style="{StaticResource JfLargeTitleText}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                        <TextBlock
                            FontSize="{th:Token Key=Type.NowPlayingArtist}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource JfAccentText}"
                            Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind shell:Bind.VisibleIf(ViewModel.Subtitle), Mode=OneWay}" />
                        <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind ViewModel.Attribution, Mode=OneWay}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.HasAttribution), Mode=OneWay}" />
                        <TextBlock Style="{StaticResource JfCaptionText}" Text="{x:Bind ViewModel.Facts, Mode=OneWay}" Visibility="{x:Bind shell:Bind.VisibleIf(ViewModel.Facts), Mode=OneWay}" />
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="Action_PlayButton" Command="{x:Bind ViewModel.PlayCommand}" Content="Play" Style="{StaticResource JfAccentPillStyle}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.CanPlay), Mode=OneWay}" />
                            <Button
                                x:Uid="Action_ShuffleButton"
                                Background="{ThemeResource JfGlassMist}"
                                BorderBrush="{ThemeResource JfGlassEdge}"
                                Command="{x:Bind ViewModel.ShuffleCommand}"
                                Content="Shuffle"
                                Style="{StaticResource JfChipButtonStyle}"
                                Visibility="{x:Bind shell:Bind.Visible(ViewModel.CanPlay), Mode=OneWay}" />
                            <!-- Nothing here plays here: its link is the main action (docs/ui.md). -->
                            <Button Command="{x:Bind ViewModel.OpenLinkCommand}" Content="{x:Bind ViewModel.OpenInLabel}" Style="{StaticResource JfAccentPillStyle}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.OpensLink), Mode=OneWay}" />
                            <Button
                                x:Uid="More_Button"
                                Width="36"
                                Height="36"
                                AutomationProperties.Name="More"
                                Style="{StaticResource JfIconButtonStyle}"
                                ToolTipService.ToolTip="More"
                                Visibility="{x:Bind shell:Bind.Visible(ViewModel.HasMore), Mode=OneWay}">
                                <controls:StrokeIcon Data="{StaticResource IconMore}" Size="18" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem x:Uid="More_PlayNext" Command="{x:Bind ViewModel.PlayNextCommand}" Text="Play Next" Visibility="{x:Bind shell:Bind.Visible(ViewModel.CanQueue), Mode=OneWay}" />
                                        <MenuFlyoutItem x:Uid="More_PlayLast" Command="{x:Bind ViewModel.PlayLastCommand}" Text="Play Last" Visibility="{x:Bind shell:Bind.Visible(ViewModel.CanQueue), Mode=OneWay}" />
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.OpenLinkCommand}" Text="{x:Bind ViewModel.OpenInLabel}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.HasLink)}" />
                                        <MenuFlyoutItem x:Uid="More_GetInfo" Click="OnGetInfoClick" Text="Get Info" Visibility="{x:Bind shell:Bind.Visible(ViewModel.HasDetails)}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- A page the source could not give: what it said. -->
                <StackPanel Spacing="2" Visibility="{x:Bind shell:Bind.Visible(ViewModel.HasError), Mode=OneWay}">
                    <TextBlock x:Uid="Browse_ErrorTitle" FontWeight="SemiBold" Style="{StaticResource JfBodyText}" Text="This Source Did Not Answer" />
                    <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind ViewModel.Error, Mode=OneWay}" />
                </StackPanel>
                <TextBlock x:Uid="Browse_Empty" Style="{StaticResource JfSecondaryBodyText}" Text="Nothing Here" Visibility="{x:Bind shell:Bind.Visible(ViewModel.IsNothingHere), Mode=OneWay}" />
            </StackPanel>
        </ListView.Header>
        <ListView.Footer>
            <StackPanel Margin="0,8,0,0" Spacing="12">
                <ProgressRing HorizontalAlignment="Center" IsActive="{x:Bind ViewModel.IsBrowsing, Mode=OneWay}" />
                <Button x:Uid="Sources_More" HorizontalAlignment="Center" Command="{x:Bind ViewModel.LoadMoreCommand}" Content="Load More" Style="{StaticResource JfChipButtonStyle}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.HasNextPage), Mode=OneWay}" />
                <!-- "12 songs, 48 minutes". -->
                <TextBlock Margin="8,0,0,0" Style="{StaticResource JfCaptionText}" Text="{x:Bind ViewModel.Footer, Mode=OneWay}" Visibility="{x:Bind shell:Bind.VisibleIf(ViewModel.Footer), Mode=OneWay}" />
                <TextBlock x:Uid="Common_NotAvailable" Style="{StaticResource JfSecondaryBodyText}" Text="Coming in a later build." Visibility="{x:Bind shell:Bind.Visible(ViewModel.IsNotAvailable), Mode=OneWay}" />
            </StackPanel>
        </ListView.Footer>
    </ListView>
</shell:JfPage>
