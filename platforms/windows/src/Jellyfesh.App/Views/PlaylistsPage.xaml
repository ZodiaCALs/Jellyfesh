<?xml version="1.0" encoding="utf-8"?>
<!--
    The person's playlists as a list, as in the other apps (docs/parity.md V3): New Playlist… (it asks for
    the name first) and Import Playlist… (M3U8); a row's menu has Delete Playlist…, which asks first.
    Then each signed-in source's playlists (ADR-0024 §3). Empty: No Playlists Yet and New Playlist….
-->
<shell:JfPage
    x:Class="Jellyfesh.App.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Jellyfesh.App.Shell"
    xmlns:views="using:Jellyfesh.App.Views"
    NavigationCacheMode="Enabled">

    <Grid Padding="{x:Bind Layout.PagePadding, Mode=OneWay}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ListView
            x:Name="PlaylistGrid"
            x:Uid="Playlists_Grid"
            Grid.RowSpan="2"
            Padding="{x:Bind Layout.EndPadding, Mode=OneWay}"
            AutomationProperties.Name="Playlists"
            IsItemClickEnabled="True"
            ItemClick="OnPlaylistClick"
            ItemContainerStyle="{StaticResource JfTrackRowStyle}"
            ItemTemplate="{StaticResource PlaylistRowTemplate}"
            ItemsSource="{x:Bind ViewModel.Playlists}"
            SelectionMode="None">
            <ListView.Header>
                <Grid Margin="0,0,0,16" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Playlists_Title" AutomationProperties.HeadingLevel="Level1" FontSize="{x:Bind Layout.TitleSize, Mode=OneWay}" Style="{StaticResource JfLargeTitleText}" Text="Playlists" />
                    <Button x:Uid="Playlists_New" Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.CreateCommand}" Content="New Playlist…" Style="{StaticResource JfAccentPillStyle}" />
                    <Button x:Uid="Playlists_Import" Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.ImportCommand}" Content="Import Playlist…" Style="{StaticResource JfChipButtonStyle}" />
                </Grid>
            </ListView.Header>
            <ListView.Footer>
                <views:SourceSections x:Name="SourceLists" />
            </ListView.Footer>
        </ListView>
        <StackPanel Grid.Row="1" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind shell:Bind.VisibleIfButNeither(ViewModel.IsEmpty, ViewModel.IsLoading, ViewModel.Sources.HasSections), Mode=OneWay}">
            <TextBlock x:Uid="Playlists_EmptyTitle" HorizontalAlignment="Center" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="No Playlists Yet" />
            <TextBlock x:Uid="Playlists_Empty" HorizontalAlignment="Center" Style="{StaticResource JfSecondaryBodyText}" Text="Make a playlist to keep songs together." TextAlignment="Center" />
            <Button x:Uid="Playlists_EmptyNew" HorizontalAlignment="Center" Command="{x:Bind ViewModel.CreateCommand}" Content="New Playlist…" Style="{StaticResource JfAccentPillStyle}" />
        </StackPanel>
        <TextBlock x:Uid="Common_NotAvailable" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource JfSecondaryBodyText}" Text="Coming in a later build." Visibility="{x:Bind shell:Bind.Visible(ViewModel.IsNotAvailable), Mode=OneWay}" />
    </Grid>
</shell:JfPage>
