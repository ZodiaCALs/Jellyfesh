<?xml version="1.0" encoding="utf-8"?>
<shell:JfPage
    x:Class="Jellyfesh.App.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Jellyfesh.App.Shell"
    NavigationCacheMode="Enabled">

    <Grid Padding="32,24,32,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <GridView
            x:Name="PlaylistGrid"
            x:Uid="Playlists_Grid"
            Grid.RowSpan="2"
            Padding="0,0,0,112"
            AutomationProperties.Name="Playlists"
            IsItemClickEnabled="True"
            ItemClick="OnPlaylistClick"
            ItemContainerStyle="{StaticResource JfGridTileStyle}"
            ItemTemplate="{StaticResource PlaylistTileTemplate}"
            ItemsSource="{x:Bind ViewModel.Playlists}"
            SelectionMode="None">
            <GridView.Header>
                <Grid Margin="0,0,0,16" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Playlists_Title" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource JfLargeTitleText}" Text="Playlists" />
                    <Button x:Uid="Playlists_New" Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.CreateCommand}" Content="New playlist" Style="{StaticResource JfAccentPillStyle}" />
                    <Button x:Uid="Playlists_Import" Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.ImportCommand}" Content="Import…" Style="{StaticResource JfChipButtonStyle}" />
                </Grid>
            </GridView.Header>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid ItemHeight="240" ItemWidth="184" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>
        <TextBlock x:Uid="Playlists_Empty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource JfSecondaryBodyText}" Text="No playlists yet. Make one, or add songs to a new one from any list." Visibility="{x:Bind shell:Bind.VisibleIfButNot(ViewModel.IsEmpty, ViewModel.IsLoading), Mode=OneWay}" />
        <TextBlock x:Uid="Common_NotAvailable" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource JfSecondaryBodyText}" Text="Coming in a later build." Visibility="{x:Bind shell:Bind.Visible(ViewModel.IsNotAvailable), Mode=OneWay}" />
    </Grid>
</shell:JfPage>
