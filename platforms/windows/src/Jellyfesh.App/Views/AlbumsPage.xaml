<?xml version="1.0" encoding="utf-8"?>
<!-- Every album, as a virtualised grid: placeholders for all at once, pages filled as they scroll in. -->
<shell:JfPage
    x:Class="Jellyfesh.App.Views.AlbumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Jellyfesh.App.Shell"
    NavigationCacheMode="Enabled">

    <Grid Padding="32,24,32,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <GridView
            x:Name="AlbumGrid"
            x:Uid="Albums_Grid"
            Grid.RowSpan="2"
            Padding="0,0,0,112"
            AutomationProperties.Name="Albums"
            IsItemClickEnabled="True"
            ItemClick="OnAlbumClick"
            ItemContainerStyle="{StaticResource JfLiftTileStyle}"
            ItemTemplate="{StaticResource AlbumTileTemplate}"
            ItemsSource="{x:Bind ViewModel.Albums.Items, Mode=OneWay}"
            SelectionMode="None">
            <GridView.Header>
                <Grid Margin="0,0,0,16" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Albums_Title" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource JfLargeTitleText}" Text="Albums" />
                    <ComboBox x:Name="SortBox" x:Uid="Albums_Sort" Grid.Column="1" MinWidth="160" VerticalAlignment="Center" AutomationProperties.Name="Sort by" SelectionChanged="OnSortChanged" />
                </Grid>
            </GridView.Header>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid ItemHeight="240" ItemWidth="184" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>
        <ProgressRing Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <TextBlock x:Uid="Albums_Empty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource JfSecondaryBodyText}" Text="No albums yet. Add a music folder in Settings." Visibility="{x:Bind shell:Bind.VisibleIfButNot(ViewModel.IsEmpty, ViewModel.IsLoading), Mode=OneWay}" />
    </Grid>
</shell:JfPage>
