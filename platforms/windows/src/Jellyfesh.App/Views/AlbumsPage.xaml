<?xml version="1.0" encoding="utf-8"?>
<!--
    Every album, as a virtualised grid: placeholders for all at once, pages filled as they scroll in. The
    covers fill their columns as on Jellyfesh Web (four to a row on a 1280 epx window; Drawing.CoverGrid).
    The sort menu: Title, Artist, Year, Recently Added, and Descending. Empty: No Albums Yet and Add Music
    Folder….
-->
<shell:JfPage
    x:Class="Jellyfesh.App.Views.AlbumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jellyfesh.App.Controls"
    xmlns:shell="using:Jellyfesh.App.Shell"
    NavigationCacheMode="Enabled">

    <Grid Padding="{x:Bind Layout.PagePadding, Mode=OneWay}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <GridView
            x:Name="AlbumGrid"
            x:Uid="Albums_Grid"
            Grid.RowSpan="2"
            Padding="{x:Bind Layout.EndPadding, Mode=OneWay}"
            AutomationProperties.Name="Albums"
            IsItemClickEnabled="True"
            ItemClick="OnAlbumClick"
            ItemContainerStyle="{StaticResource JfLiftTileStyle}"
            ItemTemplate="{StaticResource AlbumTileTemplate}"
            ItemsSource="{x:Bind ViewModel.Albums.Items, Mode=OneWay}"
            SelectionMode="None"
            SizeChanged="OnGridSizeChanged">
            <GridView.Header>
                <Grid x:Name="HeaderRow" Margin="0,0,0,16" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Albums_Title" AutomationProperties.HeadingLevel="Level1" FontSize="{x:Bind Layout.TitleSize, Mode=OneWay}" Style="{StaticResource JfLargeTitleText}" Text="Albums" />
                    <Button x:Name="SortButton" x:Uid="Albums_Sort" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Sort Albums" Style="{StaticResource JfChipButtonStyle}" ToolTipService.ToolTip="Sort Albums">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="SortText" />
                            <controls:StrokeIcon VerticalAlignment="Center" Data="{StaticResource IconChevronDown}" Size="14" />
                        </StackPanel>
                    </Button>
                </Grid>
            </GridView.Header>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid ItemHeight="240" ItemWidth="196" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>
        <ProgressRing Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <StackPanel Grid.Row="1" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind shell:Bind.VisibleIfButNot(ViewModel.IsEmpty, ViewModel.IsLoading), Mode=OneWay}">
            <TextBlock x:Uid="Albums_EmptyTitle" HorizontalAlignment="Center" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="No Albums Yet" />
            <TextBlock x:Uid="Albums_Empty" HorizontalAlignment="Center" Style="{StaticResource JfSecondaryBodyText}" Text="Add a music folder to see your albums here." TextAlignment="Center" />
            <Button x:Uid="Common_AddMusicFolder" HorizontalAlignment="Center" Command="{x:Bind ViewModel.AddFolderCommand}" Content="Add Music Folder…" Style="{StaticResource JfAccentPillStyle}" />
        </StackPanel>
    </Grid>
</shell:JfPage>
