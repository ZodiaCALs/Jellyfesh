<?xml version="1.0" encoding="utf-8"?>
<!--
    One album: its cover, title, artist and details, the page's one accent action (Play), Shuffle and More
    (Play Next, Play Last, Add to Playlist…), its tracks and their total.
-->
<shell:JfPage
    x:Class="Jellyfesh.App.Views.AlbumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jellyfesh.App.Controls"
    xmlns:shell="using:Jellyfesh.App.Shell"
    xmlns:th="using:Jellyfesh.App.Theming">

    <ListView
        x:Name="TrackList"
        x:Uid="Album_Tracks"
        Padding="32,24,32,112"
        AutomationProperties.Name="Tracks"
        IsItemClickEnabled="True"
        ItemClick="OnTrackClick"
        ItemContainerStyle="{StaticResource JfTrackRowStyle}"
        ItemTemplate="{StaticResource NumberedTrackRowTemplate}"
        ItemsSource="{x:Bind ViewModel.Tracks}"
        SelectionMode="None">
        <ListView.Header>
            <!-- After Apple Music: large artwork, the title, the artist in accent text (opens the artist), genre, year and
                 song count, then Play (the page's one accent fill) and Shuffle (glass). -->
            <Grid Margin="0,0,0,24" ColumnSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="240" Height="240" VerticalAlignment="Top" CornerRadius="{th:Token Key=Artwork.RadiusGrid, Kind=Corner}" Background="{ThemeResource JfFill}">
                    <Image controls:Artwork.DecodeSize="480" controls:Artwork.Uri="{x:Bind ViewModel.Header.ArtworkUri, Mode=OneWay}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                    <TextBlock AutomationProperties.HeadingLevel="Level1" MaxLines="2" Style="{StaticResource JfLargeTitleText}" Text="{x:Bind ViewModel.Header.Title}" TextWrapping="WrapWholeWords" />
                    <HyperlinkButton
                        Padding="0"
                        AutomationProperties.Name="{x:Bind ViewModel.ArtistName}"
                        Command="{x:Bind ViewModel.OpenArtistCommand}"
                        FontSize="{th:Token Key=Type.NowPlayingArtist}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource JfAccentText}"
                        Visibility="{x:Bind shell:Bind.VisibleIf(ViewModel.ArtistName)}">
                        <TextBlock Text="{x:Bind ViewModel.ArtistName}" TextTrimming="CharacterEllipsis" />
                    </HyperlinkButton>
                    <TextBlock Style="{StaticResource JfCaptionText}" Text="{x:Bind ViewModel.Details, Mode=OneWay}" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Action_PlayButton" Command="{x:Bind ViewModel.PlayCommand}" Content="Play" Style="{StaticResource JfAccentPillStyle}" />
                        <Button x:Uid="Action_ShuffleButton" Background="{ThemeResource JfGlassMist}" BorderBrush="{ThemeResource JfGlassEdge}" Command="{x:Bind ViewModel.ShuffleCommand}" Content="Shuffle" Style="{StaticResource JfChipButtonStyle}" />
                        <Button x:Uid="More_Button" Width="36" Height="36" AutomationProperties.Name="More" Style="{StaticResource JfIconButtonStyle}" ToolTipService.ToolTip="More">
                            <controls:StrokeIcon Data="{StaticResource IconMore}" Size="18" />
                            <Button.Flyout>
                                <MenuFlyout Opening="OnMoreOpening" Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem x:Uid="More_PlayNext" Command="{x:Bind ViewModel.PlayNextCommand}" Text="Play Next" />
                                    <MenuFlyoutItem x:Uid="More_PlayLast" Command="{x:Bind ViewModel.PlayLastCommand}" Text="Play Last" />
                                    <MenuFlyoutSubItem x:Name="AddToPlaylistItem" x:Uid="More_AddToPlaylist" Text="Add to Playlist…" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ListView.Header>
        <ListView.Footer>
            <!-- "12 songs, 48 minutes". -->
            <TextBlock Margin="8,16,0,0" Style="{StaticResource JfCaptionText}" Text="{x:Bind ViewModel.Footer, Mode=OneWay}" />
        </ListView.Footer>
    </ListView>
</shell:JfPage>
