<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings (docs/ui.md, "Settings"): Appearance, Playback, Library, Sources and About, with the groups
    in the order every app shows them. Every change goes to the core as a modified Settings slice or its
    dedicated command; the slice that comes back is what the page shows.
-->
<shell:JfPage
    x:Class="Jellyfesh.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jellyfesh.App.Controls"
    xmlns:settings="using:Jellyfesh.Settings"
    xmlns:shell="using:Jellyfesh.App.Shell"
    xmlns:th="using:Jellyfesh.App.Theming"
    xmlns:vm="using:Jellyfesh.ViewModels">

    <Page.Resources>
        <!-- An accent swatch: a 32 px circle in a 44 px target, with an ink ring when chosen. -->
        <Style x:Key="SwatchStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource JfAccentText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Ring.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Ring.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Ellipse x:Name="Ring" Width="40" Height="40" Opacity="0" Stroke="{ThemeResource JfInk90}" StrokeThickness="2" />
                            <Ellipse Width="30" Height="30" Fill="{TemplateBinding Background}" Stroke="{ThemeResource JfLineSoft}" StrokeThickness="1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource JfInk90}" />
        </Style>

        <!-- A row inside a group: its title above its description. -->
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource JfBodyText}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- A source's sign-in button, one per method it offers ("Sign In with QR Code"). -->
        <DataTemplate x:Key="SignInActionTemplate" x:DataType="vm:SignInAction">
            <Button Command="{x:Bind Command}" Content="{x:Bind Title}" Style="{StaticResource JfChipButtonStyle}" />
        </DataTemplate>

        <DataTemplate x:Key="FieldText" x:DataType="settings:SettingField">
            <StackPanel Spacing="4">
                <TextBlock Margin="0,8,0,0" Style="{StaticResource RowTitle}" Text="{x:Bind Group}" Visibility="{x:Bind shell:Bind.Visible(StartsGroup)}" />
                <TextBox Description="{x:Bind Description}" Header="{x:Bind Label}" PlaceholderText="{x:Bind Placeholder}" Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock FontSize="12" Foreground="{ThemeResource JfDanger}" Text="{x:Bind shell:Bind.Text(Error), Mode=OneWay}" Visibility="{x:Bind shell:Bind.VisibleIf(Error), Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FieldSecret" x:DataType="settings:SettingField">
            <StackPanel Spacing="4">
                <TextBlock Margin="0,8,0,0" Style="{StaticResource RowTitle}" Text="{x:Bind Group}" Visibility="{x:Bind shell:Bind.Visible(StartsGroup)}" />
                <PasswordBox Description="{x:Bind Description}" Header="{x:Bind Label}" Password="{x:Bind Text, Mode=TwoWay}" PlaceholderText="{x:Bind Placeholder}" />
                <TextBlock FontSize="12" Foreground="{ThemeResource JfDanger}" Text="{x:Bind shell:Bind.Text(Error), Mode=OneWay}" Visibility="{x:Bind shell:Bind.VisibleIf(Error), Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FieldToggle" x:DataType="settings:SettingField">
            <StackPanel Spacing="4">
                <TextBlock Margin="0,8,0,0" Style="{StaticResource RowTitle}" Text="{x:Bind Group}" Visibility="{x:Bind shell:Bind.Visible(StartsGroup)}" />
                <ToggleSwitch Header="{x:Bind Label}" IsOn="{x:Bind IsOn, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind Description}" TextWrapping="Wrap" Visibility="{x:Bind shell:Bind.VisibleIf(Description)}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FieldChoice" x:DataType="settings:SettingField">
            <StackPanel Spacing="4">
                <TextBlock Margin="0,8,0,0" Style="{StaticResource RowTitle}" Text="{x:Bind Group}" Visibility="{x:Bind shell:Bind.Visible(StartsGroup)}" />
                <ComboBox MinWidth="200" DisplayMemberPath="Title" Header="{x:Bind Label}" ItemsSource="{x:Bind Options}" SelectedItem="{x:Bind SelectedOption, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind Description}" TextWrapping="Wrap" Visibility="{x:Bind shell:Bind.VisibleIf(Description)}" />
            </StackPanel>
        </DataTemplate>
        <!-- Profile 1.2: a number between two bounds is a slider, multipleOf its step. -->
        <DataTemplate x:Key="FieldSlider" x:DataType="settings:SettingField">
            <StackPanel Spacing="4">
                <TextBlock Margin="0,8,0,0" Style="{StaticResource RowTitle}" Text="{x:Bind Group}" Visibility="{x:Bind shell:Bind.Visible(StartsGroup)}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <Slider
                        MaxWidth="360"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{x:Bind Label}"
                        Header="{x:Bind Label}"
                        Maximum="{x:Bind SliderMaximum}"
                        Minimum="{x:Bind SliderMinimum}"
                        StepFrequency="{x:Bind SliderStep}"
                        Value="{x:Bind Value, Mode=TwoWay}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,8" Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind ValueText, Mode=OneWay}" />
                </Grid>
                <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind Description}" TextWrapping="Wrap" Visibility="{x:Bind shell:Bind.VisibleIf(Description)}" />
            </StackPanel>
        </DataTemplate>
        <!-- Profile 1.2: "format": "color", a colour well that opens a colour picker. -->
        <DataTemplate x:Key="FieldColor" x:DataType="settings:SettingField">
            <StackPanel Spacing="4">
                <TextBlock Margin="0,8,0,0" Style="{StaticResource RowTitle}" Text="{x:Bind Group}" Visibility="{x:Bind shell:Bind.Visible(StartsGroup)}" />
                <TextBlock Style="{StaticResource JfBodyText}" Text="{x:Bind Label}" />
                <Button Padding="4" AutomationProperties.Name="{x:Bind Label}" Style="{StaticResource JfChipButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="28" Height="20" Background="{x:Bind shell:Bind.ColorBrush(Text), Mode=OneWay}" BorderBrush="{ThemeResource JfLineSoft}" BorderThickness="1" CornerRadius="4" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind Text, Mode=OneWay}" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Opening="OnColorFlyoutOpening">
                            <ColorPicker ColorChanged="OnFieldColorChanged" IsAlphaEnabled="False" IsMoreButtonVisible="False" Tag="{x:Bind}" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind Description}" TextWrapping="Wrap" Visibility="{x:Bind shell:Bind.VisibleIf(Description)}" />
                <TextBlock FontSize="12" Foreground="{ThemeResource JfDanger}" Text="{x:Bind shell:Bind.Text(Error), Mode=OneWay}" Visibility="{x:Bind shell:Bind.VisibleIf(Error), Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>
        <!-- Profile 1.2: an ordered checklist; what is ticked is shown, in this order. -->
        <DataTemplate x:Key="FieldChecklist" x:DataType="settings:SettingField">
            <StackPanel Spacing="4">
                <TextBlock Margin="0,8,0,0" Style="{StaticResource RowTitle}" Text="{x:Bind Group}" Visibility="{x:Bind shell:Bind.Visible(StartsGroup)}" />
                <TextBlock Style="{StaticResource JfBodyText}" Text="{x:Bind Label}" />
                <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind Description}" TextWrapping="Wrap" Visibility="{x:Bind shell:Bind.VisibleIf(Description)}" />
                <ItemsRepeater ItemsSource="{x:Bind Items}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="2" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="settings:ChecklistItem">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="{x:Bind Title}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                <Button x:Uid="Settings_MoveUp" Grid.Column="1" AutomationProperties.Name="Move Up" Command="{x:Bind MoveUpCommand}" Style="{StaticResource JfIconButtonStyle}" ToolTipService.ToolTip="Move Up">
                                    <FontIcon FontSize="12" Glyph="&#xE70E;" />
                                </Button>
                                <Button x:Uid="Settings_MoveDown" Grid.Column="2" AutomationProperties.Name="Move Down" Command="{x:Bind MoveDownCommand}" Style="{StaticResource JfIconButtonStyle}" ToolTipService.ToolTip="Move Down">
                                    <FontIcon FontSize="12" Glyph="&#xE70D;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </DataTemplate>
        <shell:SettingFieldTemplates
            x:Key="FieldTemplates"
            Checklist="{StaticResource FieldChecklist}"
            Choice="{StaticResource FieldChoice}"
            Color="{StaticResource FieldColor}"
            Secret="{StaticResource FieldSecret}"
            Slider="{StaticResource FieldSlider}"
            Text="{StaticResource FieldText}"
            Toggle="{StaticResource FieldToggle}" />
    </Page.Resources>

    <Grid Padding="32,24,32,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="Settings_Title" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource JfLargeTitleText}" Text="Settings" />
        <SelectorBar x:Name="Sections" Grid.Row="1" SelectionChanged="OnSectionChanged">
            <SelectorBarItem x:Name="AppearanceItem" x:Uid="Settings_Appearance" IsSelected="True" Text="Appearance" />
            <SelectorBarItem x:Name="PlaybackItem" x:Uid="Settings_Playback" Text="Playback" />
            <SelectorBarItem x:Name="LibraryItem" x:Uid="Settings_Library" Text="Library" />
            <SelectorBarItem x:Name="SourcesItem" x:Uid="Settings_Sources" Text="Sources" />
            <SelectorBarItem x:Name="ExtensionsItem" x:Uid="Settings_Extensions" Text="Extensions" />
            <SelectorBarItem x:Name="AboutItem" x:Uid="Settings_About" Text="About" />
        </SelectorBar>

        <ScrollViewer x:Name="Scroller" Grid.Row="2">
            <Grid MaxWidth="880" Padding="0,8,0,112" HorizontalAlignment="Left">

                <!-- ===== Appearance: Theme, Accent Colour, Transparency, Now Playing Backdrop, Lyrics, App Icon =====
                     Grouped cards after Windows Settings; every change applies at once and the core keeps it. -->
                <StackPanel x:Name="AppearancePanel" Spacing="16">
                    <!-- Theme: a segmented control with small previews. -->
                    <Border Style="{StaticResource JfCardStyle}">
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Uid="Appearance_Mode" Style="{StaticResource CardHeading}" Text="Theme" />
                                <TextBlock x:Uid="Appearance_ModeHint" Style="{StaticResource JfSecondaryBodyText}" Text="Light, dark, or the same as Windows." />
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource JfSegmentGroupStyle}">
                                <StackPanel x:Uid="Appearance_ModeChoice" AutomationProperties.Name="Theme" Orientation="Horizontal">
                                    <RadioButton x:Name="SystemMode" x:Uid="Appearance_System" Height="Auto" Padding="10,6" AutomationProperties.Name="System" Checked="OnModeChecked" GroupName="AppearanceMode" Style="{StaticResource JfSegmentStyle}">
                                        <StackPanel Spacing="4">
                                            <controls:ThemePreview Kind="System" />
                                            <TextBlock x:Uid="Appearance_SystemLabel" HorizontalAlignment="Center" Text="System" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="LightMode" x:Uid="Appearance_Light" Height="Auto" Padding="10,6" AutomationProperties.Name="Light" Checked="OnModeChecked" GroupName="AppearanceMode" Style="{StaticResource JfSegmentStyle}">
                                        <StackPanel Spacing="4">
                                            <controls:ThemePreview Kind="Light" />
                                            <TextBlock x:Uid="Appearance_LightLabel" HorizontalAlignment="Center" Text="Light" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="DarkMode" x:Uid="Appearance_Dark" Height="Auto" Padding="10,6" AutomationProperties.Name="Dark" Checked="OnModeChecked" GroupName="AppearanceMode" Style="{StaticResource JfSegmentStyle}">
                                        <StackPanel Spacing="4">
                                            <controls:ThemePreview Kind="Dark" />
                                            <TextBlock x:Uid="Appearance_DarkLabel" HorizontalAlignment="Center" Text="Dark" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Accent Colour: Follow the Artwork, or one of ten swatches, or a custom hue. -->
                    <Border Style="{StaticResource JfCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Uid="Appearance_Colour" Style="{StaticResource CardHeading}" Text="Accent Colour" />
                                    <TextBlock x:Uid="Appearance_ColourHint" Style="{StaticResource JfSecondaryBodyText}" Text="The colour of buttons, selections and the Misty field." />
                                </StackPanel>
                                <ToggleSwitch x:Uid="Appearance_HueFromArtwork" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Follow the Artwork" IsOn="{x:Bind ViewModel.HueFromArtwork, Mode=TwoWay}" OffContent="Follow the Artwork" OnContent="Follow the Artwork" />
                            </Grid>
                            <StackPanel Spacing="12" Visibility="{x:Bind shell:Bind.Collapsed(ViewModel.HueFromArtwork), Mode=OneWay}">
                                <StackPanel x:Name="SwatchPanel" x:Uid="Appearance_Swatches" AutomationProperties.Name="Accent Colour" Orientation="Horizontal" Spacing="4" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="Appearance_CustomHue" VerticalAlignment="Center" Style="{StaticResource JfBodyText}" Text="Custom" />
                                    <Slider
                                        x:Name="HueSlider"
                                        x:Uid="Appearance_Hue"
                                        Grid.Column="1"
                                        MaxWidth="420"
                                        AutomationProperties.Name="Hue"
                                        Style="{StaticResource JfHueSliderStyle}"
                                        Value="{x:Bind ViewModel.FixedHue, Mode=TwoWay}" />
                                    <Ellipse x:Name="HuePreview" Grid.Column="2" Width="28" Height="28" Stroke="{ThemeResource JfGlassEdge}" StrokeThickness="2" AutomationProperties.AccessibilityView="Raw" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Transparency: Solid to Clear with a live preview; Reduce Motion and Transparency. -->
                    <Border Style="{StaticResource JfCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Uid="Appearance_Transparency" Style="{StaticResource CardHeading}" Text="Transparency" />
                                    <TextBlock x:Uid="Appearance_TransparencyHint" Style="{StaticResource JfSecondaryBodyText}" Text="How much of the background shows through the glass." />
                                </StackPanel>
                                <!-- The live preview: Veil glass over the Misty field. -->
                                <Grid Grid.Column="1" Width="120" Height="56" CornerRadius="{th:Token Key=Radius.Md, Kind=Corner}" AutomationProperties.AccessibilityView="Raw">
                                    <Grid Background="{ThemeResource JfSky}">
                                        <Rectangle Fill="{ThemeResource JfAuroraGlow1}" />
                                        <Rectangle Fill="{ThemeResource JfAuroraGlow2}" />
                                        <Ellipse Width="34" Height="34" Margin="12,0,0,0" HorizontalAlignment="Left" Fill="{ThemeResource JfAccent}" />
                                    </Grid>
                                    <Border Margin="28,14,8,14" Background="{ThemeResource JfGlassVeil}" BorderBrush="{ThemeResource JfGlassEdgeSoft}" BorderThickness="1" CornerRadius="{th:Token Key=Radius.Sm, Kind=Corner}" />
                                </Grid>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Appearance_TransparencySolid" VerticalAlignment="Center" Style="{StaticResource JfCaptionText}" Text="Solid" />
                                <Slider
                                    x:Uid="Appearance_TransparencySlider"
                                    Grid.Column="1"
                                    MaxWidth="420"
                                    AutomationProperties.Name="Transparency"
                                    IsEnabled="{x:Bind shell:Bind.Not(ViewModel.ReduceEffects), Mode=OneWay}"
                                    Maximum="100"
                                    Minimum="0"
                                    StepFrequency="5"
                                    Style="{StaticResource JfThinSliderStyle}"
                                    Value="{x:Bind ViewModel.Transparency, Mode=TwoWay}" />
                                <TextBlock x:Uid="Appearance_TransparencyClear" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource JfCaptionText}" Text="Clear" />
                                <TextBlock Grid.Column="3" MinWidth="40" VerticalAlignment="Center" Style="{StaticResource JfTimeText}" Text="{x:Bind ViewModel.TransparencyText, Mode=OneWay}" TextAlignment="Right" />
                            </Grid>
                            <ToggleSwitch x:Uid="Appearance_ReduceEffects" Header="Reduce Motion and Transparency" IsOn="{x:Bind ViewModel.ReduceEffects, Mode=TwoWay}" />
                            <TextBlock x:Uid="Appearance_ReduceEffectsHint" Style="{StaticResource JfSecondaryBodyText}" Text="Solid surfaces instead of glass, and short fades instead of movement." />
                        </StackPanel>
                    </Border>

                    <!-- Now Playing Backdrop: Artwork or Misty, with previews. -->
                    <Border Style="{StaticResource JfCardStyle}">
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Uid="Appearance_Style" Style="{StaticResource CardHeading}" Text="Now Playing Backdrop" />
                                <TextBlock x:Uid="Appearance_StyleHint" Style="{StaticResource JfSecondaryBodyText}" Text="The artwork, blurred, or the Misty field in its colour." />
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource JfSegmentGroupStyle}">
                                <StackPanel x:Uid="Appearance_StyleChoice" AutomationProperties.Name="Now Playing Backdrop" Orientation="Horizontal">
                                    <RadioButton x:Name="ArtworkStyle" x:Uid="Appearance_StyleArtwork" Height="Auto" Padding="10,6" AutomationProperties.Name="Artwork" Checked="OnStyleChecked" GroupName="BackdropStyle" Style="{StaticResource JfSegmentStyle}">
                                        <StackPanel Spacing="4">
                                            <Grid Width="64" Height="40" Background="{ThemeResource JfFill}" CornerRadius="{th:Token Key=Radius.Md, Kind=Corner}">
                                                <Image x:Name="ArtworkStylePreview" Stretch="UniformToFill" />
                                            </Grid>
                                            <TextBlock x:Uid="Appearance_StyleArtworkLabel" HorizontalAlignment="Center" Text="Artwork" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="MistyStyle" x:Uid="Appearance_StyleMisty" Height="Auto" Padding="10,6" AutomationProperties.Name="Misty" Checked="OnStyleChecked" GroupName="BackdropStyle" Style="{StaticResource JfSegmentStyle}">
                                        <StackPanel Spacing="4">
                                            <Grid Width="64" Height="40" Background="{ThemeResource JfSky}" CornerRadius="{th:Token Key=Radius.Md, Kind=Corner}">
                                                <Rectangle Fill="{ThemeResource JfAuroraGlow1}" />
                                                <Rectangle Fill="{ThemeResource JfAuroraGlow2}" />
                                                <Rectangle Fill="{ThemeResource JfAuroraGlow3}" />
                                            </Grid>
                                            <TextBlock x:Uid="Appearance_StyleMistyLabel" HorizontalAlignment="Center" Text="Misty" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Lyrics: Lyrics Size, Lyrics Alignment, Show Translations, Show Romanization (they live only here). -->
                    <Border Style="{StaticResource JfCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="Appearance_Lyrics" Style="{StaticResource CardHeading}" Text="Lyrics" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Appearance_LyricsSize" VerticalAlignment="Center" Style="{StaticResource JfBodyText}" Text="Lyrics Size" />
                                <Border Grid.Column="1" Style="{StaticResource JfSegmentGroupStyle}">
                                    <StackPanel x:Uid="Appearance_LyricsSizeChoice" AutomationProperties.Name="Lyrics Size" Orientation="Horizontal">
                                        <RadioButton x:Name="LyricsSmall" x:Uid="Appearance_LyricsSmall" Checked="OnLyricsSizeChecked" Content="Small" GroupName="LyricsSize" Style="{StaticResource JfSegmentStyle}" />
                                        <RadioButton x:Name="LyricsMedium" x:Uid="Appearance_LyricsMedium" Checked="OnLyricsSizeChecked" Content="Medium" GroupName="LyricsSize" Style="{StaticResource JfSegmentStyle}" />
                                        <RadioButton x:Name="LyricsLarge" x:Uid="Appearance_LyricsLarge" Checked="OnLyricsSizeChecked" Content="Large" GroupName="LyricsSize" Style="{StaticResource JfSegmentStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Appearance_LyricsAlign" VerticalAlignment="Center" Style="{StaticResource JfBodyText}" Text="Lyrics Alignment" />
                                <Border Grid.Column="1" Style="{StaticResource JfSegmentGroupStyle}">
                                    <StackPanel x:Uid="Appearance_LyricsAlignChoice" AutomationProperties.Name="Lyrics Alignment" Orientation="Horizontal">
                                        <RadioButton x:Name="LyricsStart" x:Uid="Appearance_LyricsStart" Checked="OnLyricsAlignChecked" Content="Start" GroupName="LyricsAlign" Style="{StaticResource JfSegmentStyle}" />
                                        <RadioButton x:Name="LyricsCentre" x:Uid="Appearance_LyricsCentre" Checked="OnLyricsAlignChecked" Content="Centre" GroupName="LyricsAlign" Style="{StaticResource JfSegmentStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <ToggleSwitch x:Uid="Appearance_Translation" Header="Show Translations" IsOn="{x:Bind ViewModel.ShowTranslation, Mode=TwoWay}" />
                            <ToggleSwitch x:Uid="Appearance_Romanization" Header="Show Romanization" IsOn="{x:Bind ViewModel.ShowRomanization, Mode=TwoWay}" />
                            <StackPanel Spacing="2">
                                <ToggleSwitch x:Uid="Appearance_LyricsBar" Header="Show Lyrics Bar" IsOn="{x:Bind ViewModel.ShowLyricsBar, Mode=TwoWay}" />
                                <TextBlock x:Uid="Appearance_LyricsBarHint" Style="{StaticResource JfSecondaryBodyText}" Text="The line being sung, under the song's title in the player bar." TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <ToggleSwitch x:Uid="Appearance_DesktopLyrics" Header="Desktop Lyrics" IsOn="{x:Bind ViewModel.DesktopLyrics, Mode=TwoWay}" />
                                <TextBlock x:Uid="Appearance_DesktopLyricsHint" Style="{StaticResource JfSecondaryBodyText}" Text="The line being sung and the next one, in a window that stays above other apps." TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock x:Uid="Appearance_LyricsHint" Style="{StaticResource JfSecondaryBodyText}" Text="Lyrics come from the song's tags and from .lrc, .ttml and .vtt files next to it. Translations and romanizations appear when the lyrics include them." />
                        </StackPanel>
                    </Border>

                    <!-- App Icon. -->
                    <Border Style="{StaticResource JfCardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="Appearance_Icon" Style="{StaticResource CardHeading}" Text="App Icon" />
                                <TextBlock x:Uid="Appearance_IconHint" Style="{StaticResource JfSecondaryBodyText}" Text="Shown in the title bar, the taskbar and the shortcuts Jellyfesh installed." />
                            </StackPanel>
                            <GridView
                                x:Name="IconGrid"
                                x:Uid="Appearance_IconChoice"
                                AutomationProperties.Name="App Icon"
                                ItemsSource="{x:Bind ViewModel.Icons}"
                                SelectionChanged="OnIconChanged"
                                SelectionMode="Single">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AppIconChoice">
                                        <StackPanel Width="88" Padding="0,6" Spacing="8" AutomationProperties.Name="{x:Bind Name}">
                                            <Image Width="64" Height="64" HorizontalAlignment="Center" controls:Artwork.DecodeSize="128" controls:Artwork.Uri="{x:Bind PreviewUri}" />
                                            <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource JfInk70}" Text="{x:Bind Name}" TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <TextBlock x:Uid="Appearance_IconLimits" Style="{StaticResource JfSecondaryBodyText}" Text="Automatic uses Ice in light appearance and Steel in dark. A taskbar pin may keep the old icon until Explorer refreshes." />
                        </StackPanel>
                    </Border>

                    <!-- Customize…: opens Settings › Extensions, where Customize's settings are (a Pro badge while Pro is inactive). -->
                    <Button
                        Padding="20,16"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Command="{x:Bind ViewModel.OpenCustomizeCommand}"
                        Style="{StaticResource JfBareButtonStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="Appearance_Customize" Style="{StaticResource CardHeading}" Text="Customize…" />
                                <TextBlock x:Uid="Appearance_CustomizeHint" Style="{StaticResource JfSecondaryBodyText}" Text="Corners, glass, type, lyrics style and layout." />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="8,1" VerticalAlignment="Center" Background="{ThemeResource JfAccentSoft}" CornerRadius="{StaticResource JfFullRadius}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.CustomizeNeedsPro), Mode=OneWay}">
                                <TextBlock x:Uid="Pro_Badge" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource JfAccentText}" Text="Pro" />
                            </Border>
                            <FontIcon Grid.Column="2" FontSize="12" Foreground="{ThemeResource JfInk70}" Glyph="&#xE76C;" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- ===== Playback: Output, Crossfade, Volume Levelling, Equalizer, Startup ===== -->
                <StackPanel x:Name="PlaybackPanel" Spacing="16" Visibility="Collapsed">
                    <!-- Output: Output Device (System Default, then the devices). -->
                    <Border Style="{StaticResource JfCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="Playback_Output" Style="{StaticResource CardHeading}" Text="Output" />
                            <ComboBox x:Name="DeviceBox" x:Uid="Playback_OutputChoice" MinWidth="280" AutomationProperties.Name="Output Device" Header="Output Device" ItemsSource="{x:Bind ViewModel.Player.Devices}" SelectionChanged="OnDeviceChanged" />
                            <TextBlock x:Uid="Playback_OutputHint" Style="{StaticResource JfSecondaryBodyText}" Text="Where the sound goes." />
                        </StackPanel>
                    </Border>

                    <!-- Crossfade: Crossfade, Length (1–12 s), Album Continuity. -->
                    <Border Style="{StaticResource JfCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Uid="Playback_Crossfade" Style="{StaticResource CardHeading}" Text="Crossfade" />
                                    <TextBlock x:Uid="Playback_CrossfadeHint" Style="{StaticResource JfSecondaryBodyText}" Text="Blend the end of a song into the next." />
                                </StackPanel>
                                <ToggleSwitch x:Uid="Playback_CrossfadeOn" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Crossfade" IsOn="{x:Bind ViewModel.CrossfadeEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider
                                    x:Uid="Playback_CrossfadeLength"
                                    MaxWidth="420"
                                    HorizontalAlignment="Stretch"
                                    Header="Length"
                                    IsEnabled="{x:Bind ViewModel.CrossfadeEnabled, Mode=OneWay}"
                                    Maximum="12"
                                    Minimum="1"
                                    StepFrequency="1"
                                    TickFrequency="1"
                                    TickPlacement="Outside"
                                    Value="{x:Bind ViewModel.CrossfadeSeconds, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" MinWidth="40" VerticalAlignment="Bottom" Margin="0,0,0,8" Style="{StaticResource JfTimeText}" Text="{x:Bind ViewModel.CrossfadeText, Mode=OneWay}" TextAlignment="Right" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Uid="Playback_AlbumContinuityTitle" Style="{StaticResource RowTitle}" Text="Album Continuity" />
                                    <TextBlock x:Uid="Playback_AlbumContinuityHint" Style="{StaticResource JfSecondaryBodyText}" Text="Songs of the same album join without a fade." />
                                </StackPanel>
                                <ToggleSwitch x:Uid="Playback_AlbumContinuity" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Album Continuity" IsEnabled="{x:Bind ViewModel.CrossfadeEnabled, Mode=OneWay}" IsOn="{x:Bind ViewModel.AlbumContinuity, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Volume Levelling: ReplayGain (Off, Track, Album) and Preamp. -->
                    <Border Style="{StaticResource JfCardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="Playback_ReplayGain" Style="{StaticResource CardHeading}" Text="Volume Levelling" />
                                <TextBlock x:Uid="Playback_ReplayGainHint" Style="{StaticResource JfSecondaryBodyText}" Text="Evens out loudness using the ReplayGain tags in your files." />
                            </StackPanel>
                            <RadioButtons x:Uid="Playback_ReplayGainChoice" AutomationProperties.Name="ReplayGain" Header="ReplayGain" MaxColumns="3" SelectedIndex="{x:Bind ViewModel.ReplayGainIndex, Mode=TwoWay}">
                                <RadioButton x:Uid="Playback_ReplayGainOff" Content="Off" />
                                <RadioButton x:Uid="Playback_ReplayGainTrack" Content="Track" />
                                <RadioButton x:Uid="Playback_ReplayGainAlbum" Content="Album" />
                            </RadioButtons>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Uid="Playback_Preamp" MaxWidth="420" HorizontalAlignment="Stretch" Header="Preamp" Maximum="15" Minimum="-15" StepFrequency="0.5" Value="{x:Bind ViewModel.ReplayGainPreampDb, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" MinWidth="64" VerticalAlignment="Bottom" Margin="0,0,0,8" Style="{StaticResource JfTimeText}" Text="{x:Bind ViewModel.ReplayGainPreampText, Mode=OneWay}" TextAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Equalizer: Equalizer, Preset (the core's eq_presets(); Custom once a band moves), Preamp, the bands, Reset to Flat. -->
                    <Border Style="{StaticResource JfCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Playback_Eq" VerticalAlignment="Center" Style="{StaticResource CardHeading}" Text="Equalizer" />
                                <ToggleSwitch x:Uid="Playback_EqOn" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Equalizer" IsOn="{x:Bind ViewModel.EqEnabled, Mode=TwoWay}" />
                            </Grid>
                            <!-- Everything below is greyed while the equalizer is off (a disabled parent disables its controls). -->
                            <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.EqEnabled, Mode=OneWay}" IsTabStop="False">
                                <StackPanel Spacing="12">
                                    <ComboBox x:Name="PresetBox" x:Uid="Playback_EqPreset" MinWidth="200" AutomationProperties.Name="Preset" Header="Preset" ItemsSource="{x:Bind ViewModel.Presets}" SelectionChanged="OnPresetChanged" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Uid="Playback_EqPreamp" MaxWidth="420" HorizontalAlignment="Stretch" Header="Preamp" Maximum="12" Minimum="-12" StepFrequency="0.5" Value="{x:Bind ViewModel.EqPreampDb, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" MinWidth="64" VerticalAlignment="Bottom" Margin="0,0,0,8" Style="{StaticResource JfTimeText}" Text="{x:Bind ViewModel.EqPreampText, Mode=OneWay}" TextAlignment="Right" />
                                    </Grid>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Bands}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" Spacing="4" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:EqBandViewModel">
                                                    <StackPanel Width="52" Spacing="6">
                                                        <Slider Height="160" HorizontalAlignment="Center" AutomationProperties.Name="{x:Bind Label}" Maximum="12" Minimum="-12" Orientation="Vertical" StepFrequency="0.5" Value="{x:Bind GainDb, Mode=TwoWay}" />
                                                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource JfCaptionText}" Text="{x:Bind Label}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>
                                    <Button x:Uid="Playback_EqReset" Command="{x:Bind ViewModel.ResetToFlatCommand}" Content="Reset to Flat" Style="{StaticResource JfChipButtonStyle}" />
                                </StackPanel>
                            </ContentControl>
                        </StackPanel>
                    </Border>

                    <!-- Startup: Resume Playback. -->
                    <Border Style="{StaticResource JfCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="Playback_Startup" Style="{StaticResource CardHeading}" Text="Startup" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Uid="Playback_ResumeTitle" Style="{StaticResource RowTitle}" Text="Resume Playback" />
                                    <TextBlock x:Uid="Playback_ResumeHint" Style="{StaticResource JfSecondaryBodyText}" Text="Start playing where you left off when Jellyfesh opens." />
                                </StackPanel>
                                <ToggleSwitch x:Uid="Playback_Resume" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Resume Playback" IsOn="{x:Bind ViewModel.ResumeOnLaunch, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Library: Music Folders, Watch Folders, Rescan Library ===== -->
                <StackPanel x:Name="LibraryPanel" Spacing="16" Visibility="Collapsed">
                    <!-- Music Folders: each with Show in Explorer and Remove Folder… (it asks first), then Add Folder…. -->
                    <Border Style="{StaticResource JfCardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="Library_Folders" Style="{StaticResource CardHeading}" Text="Music Folders" />
                                <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind ViewModel.LibraryStats, Mode=OneWay}" Visibility="{x:Bind shell:Bind.VisibleIf(ViewModel.LibraryStats), Mode=OneWay}" />
                            </StackPanel>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Folders}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FolderItem">
                                        <Grid Padding="12,6" Background="{ThemeResource JfFill}" ColumnSpacing="8" CornerRadius="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Style="{StaticResource JfCaptionText}" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                            <Button x:Uid="Library_ShowFolder" Grid.Column="1" Click="OnShowFolderClick" Content="Show in Explorer" Style="{StaticResource JfChipButtonStyle}" Tag="{x:Bind}" />
                                            <Button x:Uid="Library_RemoveFolder" Grid.Column="2" Click="OnRemoveFolderClick" Content="Remove Folder…" Style="{StaticResource JfChipButtonStyle}" Tag="{x:Bind}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <TextBlock x:Uid="Library_NoFolders" Style="{StaticResource JfSecondaryBodyText}" Text="No Folders Yet" Visibility="{x:Bind shell:Bind.VisibleIfNone(ViewModel.Folders.Count), Mode=OneWay}" />
                            <Button x:Uid="Library_AddFolder" Command="{x:Bind ViewModel.AddFolderCommand}" Content="Add Folder…" Style="{StaticResource JfAccentPillStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Watch Folders. -->
                    <Border Style="{StaticResource JfCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Uid="Library_WatchTitle" Style="{StaticResource CardHeading}" Text="Watch Folders" />
                                <TextBlock x:Uid="Library_WatchHint" Style="{StaticResource JfSecondaryBodyText}" Text="Update the library when files change." />
                            </StackPanel>
                            <ToggleSwitch x:Uid="Library_Watch" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Watch Folders" IsOn="{x:Bind ViewModel.WatchFolders, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <!-- Rescan Library, with the scan's progress and Last Scan. -->
                    <Border Style="{StaticResource JfCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Uid="Library_RescanTitle" Style="{StaticResource CardHeading}" Text="Rescan Library" />
                                    <TextBlock x:Uid="Library_RescanHint" Style="{StaticResource JfSecondaryBodyText}" Text="Look for new, changed and removed files." />
                                </StackPanel>
                                <Button x:Uid="Library_Rescan" Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.RescanCommand}" Content="Rescan Library" IsEnabled="{x:Bind shell:Bind.Not(ViewModel.IsScanning), Mode=OneWay}" Style="{StaticResource JfChipButtonStyle}" />
                            </Grid>
                            <StackPanel Spacing="6" Visibility="{x:Bind shell:Bind.Visible(ViewModel.IsScanning), Mode=OneWay}">
                                <ProgressBar IsIndeterminate="True" />
                                <TextBlock Style="{StaticResource JfCaptionText}" Text="{x:Bind ViewModel.ScanText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind shell:Bind.VisibleIf(ViewModel.LastScanText), Mode=OneWay}">
                                <TextBlock x:Uid="Library_LastScan" Style="{StaticResource RowTitle}" Text="Last Scan" />
                                <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind ViewModel.LastScanText, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Sources: Add a Source, Installed (Install from File… in its heading), Community Plugins ===== -->
                <StackPanel x:Name="SourcesPanel" Spacing="16" Visibility="Collapsed">
                    <!-- Add a Source: the services Jellyfesh offers (SourcesState.Presets), each while its official
                         plugin is installed. A row opens "Connect to …"; the sign-in dialog then shows the steps. -->
                    <Border Style="{StaticResource JfCardStyle}" Visibility="{x:Bind shell:Bind.VisibleIfAny(ViewModel.SourcePresets.Count), Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="Sources_Add" Style="{StaticResource CardHeading}" Text="Add a Source" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.SourcePresets}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SourcePresetViewModel">
                                        <Button
                                            Padding="12"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.HelpText="{x:Bind Subtitle}"
                                            AutomationProperties.Name="{x:Bind Name}"
                                            Background="{ThemeResource JfCloudSoft}"
                                            Click="OnSourcePresetClick"
                                            CornerRadius="10"
                                            Style="{StaticResource JfBareButtonStyle}"
                                            Tag="{x:Bind}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- The plugin's icon; the Sources glyph when it has none. -->
                                                <FontIcon VerticalAlignment="Center" FontSize="24" Foreground="{ThemeResource JfInk70}" Glyph="&#xE753;" Visibility="{x:Bind shell:Bind.Collapsed(HasIcon)}" />
                                                <Image Width="32" Height="32" VerticalAlignment="Center" controls:Artwork.DecodeSize="64" controls:Artwork.Uri="{x:Bind IconUri}" AutomationProperties.AccessibilityView="Raw" Visibility="{x:Bind shell:Bind.Visible(HasIcon)}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource JfInk90}" Text="{x:Bind Name}" />
                                                    <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind Subtitle}" Visibility="{x:Bind shell:Bind.VisibleIf(Subtitle)}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <!-- Installed: each source with its badge and status; Enabled, a sign-in button per method (or Sign Out),
                         its own settings, "Version · Author" and Uninstall… (it asks first). -->
                    <Border Style="{StaticResource JfCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Sources_Installed" VerticalAlignment="Center" Style="{StaticResource CardHeading}" Text="Installed" />
                                <Button x:Uid="Sources_Install" Grid.Column="1" Command="{x:Bind ViewModel.InstallPluginCommand}" Content="Install from File…" Style="{StaticResource JfChipButtonStyle}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.CanInstallPlugins), Mode=OneWay}" />
                            </Grid>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Plugins}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="12" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PluginViewModel">
                                        <Border Padding="16" Background="{ThemeResource JfCloudSoft}" BorderBrush="{ThemeResource JfLineSoft}" BorderThickness="1" CornerRadius="10">
                                            <StackPanel Spacing="10">
                                                <StackPanel Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource JfInk90}" Text="{x:Bind Name, Mode=OneWay}" />
                                                        <Border Padding="8,1" VerticalAlignment="Center" Background="{ThemeResource JfAccentSoft}" CornerRadius="{StaticResource JfFullRadius}">
                                                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{ThemeResource JfAccentText}" Text="{x:Bind BadgeLabel, Mode=OneWay}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind Status, Mode=OneWay}" Visibility="{x:Bind shell:Bind.VisibleIf(Status), Mode=OneWay}" />
                                                </StackPanel>
                                                <ToggleSwitch x:Uid="Source_Enabled" Header="Enabled" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ItemsRepeater ItemTemplate="{StaticResource SignInActionTemplate}" ItemsSource="{x:Bind SignInActions, Mode=OneWay}" Visibility="{x:Bind shell:Bind.Visible(CanSignIn), Mode=OneWay}">
                                                        <ItemsRepeater.Layout>
                                                            <StackLayout Orientation="Horizontal" Spacing="8" />
                                                        </ItemsRepeater.Layout>
                                                    </ItemsRepeater>
                                                    <Button x:Uid="Source_SignOut" Command="{x:Bind SignOutCommand}" Content="Sign Out" Style="{StaticResource JfChipButtonStyle}" Visibility="{x:Bind shell:Bind.Visible(IsSignedIn), Mode=OneWay}" />
                                                </StackPanel>
                                                <Expander x:Uid="Source_SettingsExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Settings" Visibility="{x:Bind shell:Bind.Visible(HasSettings), Mode=OneWay}">
                                                    <StackPanel Spacing="12">
                                                        <ItemsRepeater ItemTemplate="{StaticResource FieldTemplates}" ItemsSource="{x:Bind Form.Fields, Mode=OneWay}">
                                                            <ItemsRepeater.Layout>
                                                                <StackLayout Spacing="12" />
                                                            </ItemsRepeater.Layout>
                                                        </ItemsRepeater>
                                                        <Button x:Uid="Source_SaveSettings" Command="{x:Bind SaveSettingsCommand}" Content="Save" Style="{StaticResource JfAccentPillStyle}" />
                                                    </StackPanel>
                                                </Expander>
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource JfCaptionText}" Text="{x:Bind Details, Mode=OneWay}" />
                                                    <Button x:Uid="Source_Uninstall" Grid.Column="1" Command="{x:Bind UninstallCommand}" Content="Uninstall…" Style="{StaticResource JfChipButtonStyle}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <StackPanel Spacing="2" Visibility="{x:Bind shell:Bind.VisibleIfNone(ViewModel.Plugins.Count), Mode=OneWay}">
                                <TextBlock x:Uid="Sources_None" Style="{StaticResource RowTitle}" Text="No Sources Installed" />
                                <TextBlock x:Uid="Sources_NoneHint" Style="{StaticResource JfSecondaryBodyText}" Text="Install a source plugin from a .jfpkg file." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Community Plugins: Allow Community Plugins shows the disclosure first. Not in store builds. -->
                    <Border Style="{StaticResource JfCardStyle}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.CanInstallPlugins), Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="Sources_Community" Style="{StaticResource CardHeading}" Text="Community Plugins" />
                                <TextBlock x:Uid="Sources_CommunityHint" Style="{StaticResource JfSecondaryBodyText}" Text="Official sources are signed by Jellyfesh. Community plugins are made by others and are off unless you allow them." />
                            </StackPanel>
                            <ToggleSwitch x:Uid="Sources_AllowCommunity" Header="Allow Community Plugins" IsOn="{x:Bind ViewModel.AllowCommunity, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>


                <!-- ===== Extensions (v0.0.7): Jellyfesh Pro, then AI Lyrics, Customize and any other extension,
                     with Install from File… in the heading (not in store builds). ===== -->
                <StackPanel x:Name="ExtensionsPanel" Spacing="16" Visibility="Collapsed">
                    <!-- Jellyfesh Pro: where Pro comes from; Remove Licence… (asks first); Buy and Restore Purchases
                         where this build's store sells it; Enter Licence Key… where keys are taken; the legal pages. -->
                    <Border Style="{StaticResource JfCardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="Pro_Heading" Style="{StaticResource CardHeading}" Text="Jellyfesh Pro" />
                                <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind ViewModel.Pro.Status, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind ViewModel.Pro.BuyCommand}" Content="{x:Bind ViewModel.Pro.BuyLabel, Mode=OneWay}" Style="{StaticResource JfAccentPillStyle}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.Pro.CanBuy), Mode=OneWay}" />
                                <Button x:Uid="Pro_Restore" Command="{x:Bind ViewModel.Pro.RestoreCommand}" Content="Restore Purchases" Style="{StaticResource JfChipButtonStyle}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.Pro.CanBuy), Mode=OneWay}" />
                                <Button x:Uid="Pro_EnterKey" Command="{x:Bind ViewModel.Pro.EnterLicenceKeyCommand}" Content="Enter Licence Key…" Style="{StaticResource JfChipButtonStyle}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.Pro.CanEnterKey), Mode=OneWay}" />
                                <Button x:Uid="Pro_RemoveLicence" Command="{x:Bind ViewModel.Pro.RemoveLicenceCommand}" Content="Remove Licence…" Style="{StaticResource JfChipButtonStyle}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.Pro.CanRemoveLicence), Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind shell:Bind.Visible(ViewModel.Pro.HasLinks)}">
                                <HyperlinkButton x:Uid="Legal_LicenceAgreement" Command="{x:Bind ViewModel.Pro.OpenLicenceAgreementCommand}" Content="Licence Agreement" />
                                <HyperlinkButton x:Uid="Legal_PrivacyPolicy" Command="{x:Bind ViewModel.Pro.OpenPrivacyPolicyCommand}" Content="Privacy Policy" />
                                <HyperlinkButton x:Uid="Legal_TermsOfSale" Command="{x:Bind ViewModel.Pro.OpenTermsOfSaleCommand}" Content="Terms of Sale" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Extensions_Installed" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource CardHeading}" Text="Installed" />
                        <Button x:Uid="Extensions_Install" Grid.Column="1" Command="{x:Bind ViewModel.InstallPluginCommand}" Content="Install from File…" Style="{StaticResource JfChipButtonStyle}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.CanInstallPlugins), Mode=OneWay}" />
                    </Grid>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Extensions}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="16" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExtensionViewModel">
                                <Border Style="{StaticResource JfCardStyle}">
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock AutomationProperties.HeadingLevel="Level3" Style="{StaticResource CardHeading}" Text="{x:Bind Plugin.Name, Mode=OneWay}" />
                                                <Border Padding="8,1" VerticalAlignment="Center" Background="{ThemeResource JfAccentSoft}" CornerRadius="{StaticResource JfFullRadius}" Visibility="{x:Bind shell:Bind.Visible(ShowsProBadge), Mode=OneWay}">
                                                    <TextBlock x:Uid="Pro_Badge" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource JfAccentText}" Text="Pro" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind Info.Description, Mode=OneWay}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch x:Uid="Source_Enabled" Header="Enabled" IsOn="{x:Bind Plugin.IsEnabled, Mode=TwoWay}" />

                                        <!-- AI Lyrics: the online mode's API key. -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind shell:Bind.VisibleIfAny(Plugin.AuthMethods.Count), Mode=OneWay}">
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind KeyStatus, Mode=OneWay}" Visibility="{x:Bind shell:Bind.VisibleIf(KeyStatus), Mode=OneWay}" />
                                            <ItemsRepeater ItemTemplate="{StaticResource SignInActionTemplate}" ItemsSource="{x:Bind Plugin.SignInActions, Mode=OneWay}" Visibility="{x:Bind shell:Bind.Visible(Plugin.CanSignIn), Mode=OneWay}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Horizontal" Spacing="8" />
                                                </ItemsRepeater.Layout>
                                            </ItemsRepeater>
                                            <Button x:Uid="Source_SignOut" Command="{x:Bind Plugin.SignOutCommand}" Content="Sign Out" Style="{StaticResource JfChipButtonStyle}" Visibility="{x:Bind shell:Bind.Visible(Plugin.IsSignedIn), Mode=OneWay}" />
                                        </StackPanel>

                                        <!-- Its settings in the app's language, by group, applied with Save. -->
                                        <StackPanel Spacing="12" Visibility="{x:Bind shell:Bind.Visible(Plugin.HasSettings), Mode=OneWay}">
                                            <ItemsRepeater ItemTemplate="{StaticResource FieldTemplates}" ItemsSource="{x:Bind Plugin.Form.Fields, Mode=OneWay}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="12" />
                                                </ItemsRepeater.Layout>
                                            </ItemsRepeater>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Uid="Source_SaveSettings" Command="{x:Bind Plugin.SaveSettingsCommand}" Content="Save" Style="{StaticResource JfAccentPillStyle}" />
                                                <Button x:Uid="Extensions_Reset" Command="{x:Bind ResetToDefaultsCommand}" Content="Reset to Defaults" Style="{StaticResource JfChipButtonStyle}" Visibility="{x:Bind shell:Bind.Visible(IsCustomize), Mode=OneWay}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- AI Lyrics: On-Device Models. -->
                                        <StackPanel Spacing="8" Visibility="{x:Bind shell:Bind.Visible(HasModels), Mode=OneWay}">
                                            <TextBlock x:Uid="Models_Title" Style="{StaticResource RowTitle}" Text="On-Device Models" />
                                            <ItemsRepeater ItemsSource="{x:Bind Models}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="8" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SpeechModelItem">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                                <TextBlock Style="{StaticResource JfBodyText}" Text="{x:Bind Title, Mode=OneWay}" />
                                                                <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind Status, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind shell:Bind.VisibleIf(Status), Mode=OneWay}" />
                                                                <ProgressBar MaxWidth="240" HorizontalAlignment="Left" Maximum="100" Value="{x:Bind Progress, Mode=OneWay}" Visibility="{x:Bind shell:Bind.Visible(IsDownloading), Mode=OneWay}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                                                <Button x:Uid="Models_Download" Command="{x:Bind DownloadCommand}" Content="Download" Style="{StaticResource JfChipButtonStyle}" Visibility="{x:Bind shell:Bind.Visible(CanDownload), Mode=OneWay}" />
                                                                <Button x:Uid="Action_CancelButton" Command="{x:Bind CancelCommand}" Content="Cancel" Style="{StaticResource JfChipButtonStyle}" Visibility="{x:Bind shell:Bind.Visible(IsDownloading), Mode=OneWay}" />
                                                                <Button x:Uid="Models_Delete" Command="{x:Bind DeleteCommand}" Content="Delete…" Style="{StaticResource JfChipButtonStyle}" Visibility="{x:Bind shell:Bind.Visible(CanDelete), Mode=OneWay}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>

                                        <!-- AI Lyrics: Sending Audio, each allowed origin with Stop Allowing. -->
                                        <StackPanel Spacing="8" Visibility="{x:Bind shell:Bind.Visible(HasConsents), Mode=OneWay}">
                                            <TextBlock x:Uid="Consents_Title" Style="{StaticResource RowTitle}" Text="Sending Audio" />
                                            <ItemsRepeater ItemsSource="{x:Bind Consents}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="8" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AudioConsentItem">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource JfBodyText}" Text="{x:Bind Origin}" TextTrimming="CharacterEllipsis" />
                                                            <Button x:Uid="Consents_StopAllowing" Grid.Column="1" Command="{x:Bind StopAllowingCommand}" Content="Stop Allowing" Style="{StaticResource JfChipButtonStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource JfCaptionText}" Text="{x:Bind Plugin.Details, Mode=OneWay}" />
                                            <Button x:Uid="Source_Uninstall" Grid.Column="1" Command="{x:Bind Plugin.UninstallCommand}" Content="Uninstall…" Style="{StaticResource JfChipButtonStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <StackPanel Spacing="2" Visibility="{x:Bind shell:Bind.VisibleIfNone(ViewModel.Extensions.Count), Mode=OneWay}">
                        <TextBlock x:Uid="Extensions_None" Style="{StaticResource RowTitle}" Text="No Extensions Installed" />
                        <TextBlock x:Uid="Extensions_NoneHint" Style="{StaticResource JfSecondaryBodyText}" Text="AI Lyrics and Customize come with Jellyfesh; others install from a .jfpkg file." TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <!-- ===== About: the version (from the build), the website and the licences where the build knows them, the log folder ===== -->
                <StackPanel x:Name="AboutPanel" Spacing="16" Visibility="Collapsed">
                    <Border Style="{StaticResource JfCardStyle}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Image x:Name="AboutIcon" Width="64" Height="64" />
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{ThemeResource JfInk90}" Text="Jellyfesh" />
                                    <TextBlock x:Name="VersionText" Style="{StaticResource JfSecondaryBodyText}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Uid="About_Tagline" Style="{StaticResource JfBodyText}" Text="An elegant, lightweight music player." />
                            <TextBlock x:Uid="About_Misty" Style="{StaticResource JfSecondaryBodyText}" Text="Designed with the Misty design language. Design tokens derived from the Misty Design Language 1.1 tokens, © 2026 ZodiaCALs, Apache License 2.0." />
                            <TextBlock x:Uid="About_Rights" Style="{StaticResource JfSecondaryBodyText}" Text="All rights reserved. Third-party licences are listed in the notices file next to the app." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="WebsiteButton" x:Uid="About_Website" Click="OnWebsiteClick" Content="Website" Style="{StaticResource JfChipButtonStyle}" Visibility="Collapsed" />
                                <Button x:Name="LicencesButton" x:Uid="About_Licences" Click="OnLicencesClick" Content="Third-Party Licences" Style="{StaticResource JfChipButtonStyle}" />
                                <Button x:Uid="About_Logs" Click="OnOpenLogsClick" Content="Open Log Folder" Style="{StaticResource JfChipButtonStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind shell:Bind.Visible(ViewModel.Pro.HasLinks)}">
                                <HyperlinkButton x:Uid="Legal_LicenceAgreementAbout" Command="{x:Bind ViewModel.Pro.OpenLicenceAgreementCommand}" Content="Licence Agreement" />
                                <HyperlinkButton x:Uid="Legal_PrivacyPolicyAbout" Command="{x:Bind ViewModel.Pro.OpenPrivacyPolicyCommand}" Content="Privacy Policy" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Updates (direct downloads only: the store updates store builds). -->
                    <Border Style="{StaticResource JfCardStyle}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.Updates.IsSupported), Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Uid="Update_Title" Style="{StaticResource CardHeading}" Text="Updates" />
                                    <TextBlock Style="{StaticResource JfBodyText}" Text="{x:Bind ViewModel.Updates.AvailableText, Mode=OneWay}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.Updates.HasUpdate), Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource JfSecondaryBodyText}" Text="{x:Bind ViewModel.Updates.ErrorText, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind shell:Bind.VisibleIf(ViewModel.Updates.ErrorText), Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.Updates.IsChecking, Mode=OneWay}" />
                                    <Button x:Uid="Update_ViewRelease" Command="{x:Bind ViewModel.Updates.ViewReleaseCommand}" Content="View Release" Style="{StaticResource JfAccentPillStyle}" Visibility="{x:Bind shell:Bind.Visible(ViewModel.Updates.HasUpdate), Mode=OneWay}" />
                                    <Button x:Uid="Update_Check" Command="{x:Bind ViewModel.Updates.CheckCommand}" Content="Check for Updates" IsEnabled="{x:Bind shell:Bind.Not(ViewModel.Updates.IsChecking), Mode=OneWay}" Style="{StaticResource JfChipButtonStyle}" />
                                </StackPanel>
                            </Grid>
                            <ToggleSwitch x:Uid="Update_Auto" Header="Check for Updates Automatically" IsOn="{x:Bind ViewModel.Updates.CheckAutomatically, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</shell:JfPage>
