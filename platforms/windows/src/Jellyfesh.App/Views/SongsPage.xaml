<?xml version="1.0" encoding="utf-8"?>
<!--
    Every song, virtualised and sorted by the core: Play and Shuffle, then the list; choosing one plays it
    and the songs after it. The sort menu: Title, Artist, Album, Year, Recently Added, and Descending.
-->
<shell:JfPage
    x:Class="Jellyfesh.App.Views.SongsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jellyfesh.App.Controls"
    xmlns:shell="using:Jellyfesh.App.Shell"
    NavigationCacheMode="Enabled">

    <Grid Padding="{x:Bind Layout.PagePadding, Mode=OneWay}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ListView
            x:Name="SongList"
            x:Uid="Songs_List"
            Grid.RowSpan="2"
            Padding="{x:Bind Layout.EndPadding, Mode=OneWay}"
            AutomationProperties.Name="Songs"
            IsItemClickEnabled="True"
            ItemClick="OnSongClick"
            ItemContainerStyle="{StaticResource JfTrackRowStyle}"
            ItemTemplate="{StaticResource TrackRowTemplate}"
            ItemsSource="{x:Bind ViewModel.Songs.Items, Mode=OneWay}"
            SelectionMode="None">
            <ListView.Header>
                <Grid Margin="0,0,0,16" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Songs_Title" AutomationProperties.HeadingLevel="Level1" FontSize="{x:Bind Layout.TitleSize, Mode=OneWay}" Style="{StaticResource JfLargeTitleText}" Text="Songs" />
                    <Button x:Uid="Action_PlayButton" Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.PlayCommand}" Content="Play" IsEnabled="{x:Bind shell:Bind.Not(ViewModel.IsEmpty), Mode=OneWay}" Style="{StaticResource JfAccentPillStyle}" />
                    <Button x:Uid="Action_ShuffleButton" Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.ShuffleCommand}" Content="Shuffle" IsEnabled="{x:Bind shell:Bind.Not(ViewModel.IsEmpty), Mode=OneWay}" Style="{StaticResource JfChipButtonStyle}" />
                    <Button x:Name="SortButton" x:Uid="Songs_Sort" Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Sort Songs" Style="{StaticResource JfChipButtonStyle}" ToolTipService.ToolTip="Sort Songs">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="SortText" />
                            <controls:StrokeIcon VerticalAlignment="Center" Data="{StaticResource IconChevronDown}" Size="14" />
                        </StackPanel>
                    </Button>
                </Grid>
            </ListView.Header>
        </ListView>
        <ProgressRing Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <StackPanel Grid.Row="1" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind shell:Bind.VisibleIfButNot(ViewModel.IsEmpty, ViewModel.IsLoading), Mode=OneWay}">
            <TextBlock x:Uid="Songs_EmptyTitle" HorizontalAlignment="Center" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="No Songs Yet" />
            <TextBlock x:Uid="Songs_Empty" HorizontalAlignment="Center" Style="{StaticResource JfSecondaryBodyText}" Text="Add a music folder to see your songs here." TextAlignment="Center" />
            <Button x:Uid="Common_AddMusicFolder" HorizontalAlignment="Center" Command="{x:Bind ViewModel.AddFolderCommand}" Content="Add Music Folder…" Style="{StaticResource JfAccentPillStyle}" />
        </StackPanel>
    </Grid>
</shell:JfPage>
