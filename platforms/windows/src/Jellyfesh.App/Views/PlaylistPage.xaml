<?xml version="1.0" encoding="utf-8"?>
<!--
    One playlist: Play, Shuffle and More (Play Next, Play Last, Add to Playlist…, Rename…, Export Playlist…,
    Delete Playlist…); drag rows (or Alt+Up and Alt+Down) to reorder.
-->
<shell:JfPage
    x:Class="Jellyfesh.App.Views.PlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jellyfesh.App.Controls"
    xmlns:shell="using:Jellyfesh.App.Shell">

    <Grid Padding="32,24,32,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource JfLargeTitleText}" Text="{x:Bind ViewModel.Name, Mode=OneWay}" />
            <TextBlock Style="{StaticResource JfCaptionText}" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
            <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="8">
                <Button x:Uid="Action_PlayButton" Command="{x:Bind ViewModel.PlayCommand}" Content="Play" IsEnabled="{x:Bind shell:Bind.Not(ViewModel.IsEmpty), Mode=OneWay}" Style="{StaticResource JfAccentPillStyle}" />
                <Button x:Uid="Action_ShuffleButton" Command="{x:Bind ViewModel.ShuffleCommand}" Content="Shuffle" IsEnabled="{x:Bind shell:Bind.Not(ViewModel.IsEmpty), Mode=OneWay}" Style="{StaticResource JfChipButtonStyle}" />
                <Button x:Uid="More_Button" Width="36" Height="36" AutomationProperties.Name="More" Style="{StaticResource JfIconButtonStyle}" ToolTipService.ToolTip="More">
                    <controls:StrokeIcon Data="{StaticResource IconMore}" Size="18" />
                    <Button.Flyout>
                        <MenuFlyout Opening="OnMoreOpening" Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem x:Uid="More_PlayNext" Command="{x:Bind ViewModel.PlayNextCommand}" Text="Play Next" />
                            <MenuFlyoutItem x:Uid="More_PlayLast" Command="{x:Bind ViewModel.PlayLastCommand}" Text="Play Last" />
                            <MenuFlyoutSubItem x:Name="AddToPlaylistItem" x:Uid="More_AddToPlaylist" Text="Add to Playlist…" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="More_Rename" Command="{x:Bind ViewModel.RenameCommand}" Text="Rename…" />
                            <MenuFlyoutItem x:Uid="More_Export" Command="{x:Bind ViewModel.ExportCommand}" Text="Export Playlist…" />
                            <MenuFlyoutItem x:Uid="More_Delete" Command="{x:Bind ViewModel.DeleteCommand}" Text="Delete Playlist…" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </StackPanel>
        <ListView
            x:Name="EntryList"
            x:Uid="Playlist_Entries"
            Grid.Row="1"
            Padding="0,0,0,112"
            AllowDrop="True"
            AutomationProperties.Name="Songs in this playlist"
            CanDragItems="True"
            CanReorderItems="True"
            DragItemsCompleted="OnDragItemsCompleted"
            IsItemClickEnabled="True"
            ItemClick="OnEntryClick"
            ItemContainerStyle="{StaticResource JfTrackRowStyle}"
            ItemTemplate="{StaticResource TrackRowTemplate}"
            ItemsSource="{x:Bind ViewModel.Entries.Items, Mode=OneWay}"
            SelectionMode="Single">
            <ListView.KeyboardAccelerators>
                <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="OnMoveUp" />
                <KeyboardAccelerator Key="Down" Modifiers="Menu" Invoked="OnMoveDown" />
                <KeyboardAccelerator Key="Delete" Invoked="OnRemoveKey" />
            </ListView.KeyboardAccelerators>
        </ListView>
        <!-- An empty playlist (docs/parity.md V5: macOS's words, now every app's). -->
        <StackPanel Grid.Row="1" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind shell:Bind.VisibleIfButNot(ViewModel.IsEmpty, ViewModel.IsLoading), Mode=OneWay}">
            <TextBlock x:Uid="Playlist_EmptyTitle" HorizontalAlignment="Center" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource JfSectionText}" Text="This Playlist Is Empty" />
            <TextBlock x:Uid="Playlist_Empty" HorizontalAlignment="Center" Style="{StaticResource JfSecondaryBodyText}" Text="Add songs from their menu with Add to Playlist." TextAlignment="Center" />
        </StackPanel>
    </Grid>
</shell:JfPage>
