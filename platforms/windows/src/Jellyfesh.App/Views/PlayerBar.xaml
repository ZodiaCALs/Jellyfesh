<?xml version="1.0" encoding="utf-8"?>
<!--
    The player bar for windows 900 epx and wider (docs/ui.md, "The player bar and the mini player"),
    Jellyfesh Web's dock: a floating Veil bar 80 epx high with r-2xl corners over every page (the
    content fades out just above it). In this order: the artwork and two lines of type (they open
    Now Playing; in a remote session Playing on {Device} with the session's error, quieter, after
    it); shuffle, previous, play, next and repeat above the seek bar with its times (play is the only
    accent fill); then the quality badge and its menu (ADR-0026 §3) while something plays, Lyrics,
    Queue, the device button while a remote source plays (Devices), the
    volume (hidden when a remote device has none; narrow bars keep only its mute button), the mini
    player button and More (Open in {Service}, Stop Controlling, Desktop Lyrics). It bends CMP-02
    (one control) on purpose, for desktop use.

    Every part keeps to its own column at any width (v0.0.9, Drawing.PlayerBarLayout): the tools'
    column is as wide as what it holds, and a narrower bar drops the volume line, then Lyrics and
    Queue, then the mute button; the middle column grows to 340 epx once the title has 112; the title,
    the artist and the translation end with "…" and the sung line is cut at the column's edge; the
    times stay beside the scrubber.
-->
<UserControl
    x:Class="Jellyfesh.App.Views.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jellyfesh.App.Controls"
    xmlns:shell="using:Jellyfesh.App.Shell"
    xmlns:th="using:Jellyfesh.App.Theming">

    <Grid x:Name="Root" Height="{th:Token Key=Player.BarHeight}" SizeChanged="OnBarSizeChanged">
        <Border CornerRadius="{th:Token Key=Radius.2xl, Kind=Corner}" Style="{StaticResource JfVeilCapsuleStyle}" />
        <Grid Padding="8,0,16,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="MiddleColumn" Width="340" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- What is playing; opens Now Playing. -->
            <Button
                x:Name="OpenButton"
                x:Uid="Mini_Open"
                Height="68"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Padding="6,0,8,0"
                AutomationProperties.Name="Open Now Playing"
                Click="OnOpenClick"
                CornerRadius="{th:Token Key=Radius.Xl, Kind=Corner}"
                Style="{StaticResource JfBareButtonStyle}"
                ToolTipService.ToolTip="Open Now Playing">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Art" Width="56" Height="56" VerticalAlignment="Center" Background="{ThemeResource JfFill}" BorderBrush="{ThemeResource JfLineSoft}" BorderThickness="1" CornerRadius="{th:Token Key=Radius.Lg, Kind=Corner}">
                        <Image controls:Artwork.DecodeSize="112" controls:Artwork.Uri="{x:Bind Player.ArtworkUri, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource JfInk90}" Text="{x:Bind Player.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <!-- The lyrics bar (Show Lyrics Bar): the line being sung, filling word by word, in place of the artist. -->
                        <TextBlock FontSize="12.5" Foreground="{ThemeResource JfInk70}" Text="{x:Bind Player.Artist, Mode=OneWay}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind shell:Bind.CollapsedIfAll(Shell.Settings.ShowLyricsBar, Shell.LyricsBar.HasLine), Mode=OneWay}" />
                        <controls:LyricsBarLine x:Name="BarLine" LineFontSize="13" Visibility="{x:Bind shell:Bind.VisibleIfAll(Shell.Settings.ShowLyricsBar, Shell.LyricsBar.HasLine), Mode=OneWay}" />
                        <!-- A remote session: Playing on {Device}, and its error quieter after it. -->
                        <TextBlock Style="{StaticResource JfRemoteLineText}" Visibility="{x:Bind shell:Bind.Visible(Player.IsRemote), Mode=OneWay}">
                            <Run Text="{x:Bind Player.RemoteDeviceText, Mode=OneWay}" /><Run Foreground="{ThemeResource JfInk50}" FontWeight="Normal" Text="{x:Bind shell:Bind.After(Player.RemoteError), Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- The transport above the seek bar. -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <ToggleButton
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind Player.ShuffleLabel, Mode=OneWay}"
                        Command="{x:Bind Player.ToggleShuffleCommand}"
                        IsChecked="{x:Bind Player.Shuffle, Mode=OneWay}"
                        Style="{StaticResource JfToggleIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind Player.ShuffleLabel, Mode=OneWay}">
                        <controls:StrokeIcon Data="{StaticResource IconShuffle}" Size="18" />
                    </ToggleButton>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Uid="Player_PreviousButton" Width="44" Height="44" AutomationProperties.Name="Previous" Command="{x:Bind Player.PreviousCommand}" IsEnabled="{x:Bind Player.CanGoPrevious, Mode=OneWay}" Style="{StaticResource JfTransportButtonStyle}" ToolTipService.ToolTip="Previous (Ctrl+←)">
                            <controls:StrokeIcon Data="{StaticResource IconPrevious}" Size="20" />
                        </Button>
                        <Button
                            Width="44"
                            Height="44"
                            AutomationProperties.Name="{x:Bind Player.PlayPauseLabel, Mode=OneWay}"
                            Command="{x:Bind Player.PlayPauseCommand}"
                            Style="{StaticResource JfPlayButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind Player.PlayPauseLabel, Mode=OneWay}">
                            <controls:PlayPauseGlyph IsPlaying="{x:Bind Player.IsPlaying, Mode=OneWay}" ReduceMotion="{x:Bind Shell.ReduceMotion, Mode=OneWay}" Size="22" />
                        </Button>
                        <Button x:Uid="Player_NextButton" Width="44" Height="44" AutomationProperties.Name="Next" Command="{x:Bind Player.NextCommand}" IsEnabled="{x:Bind Player.CanGoNext, Mode=OneWay}" Style="{StaticResource JfTransportButtonStyle}" ToolTipService.ToolTip="Next (Ctrl+→)">
                            <controls:StrokeIcon Data="{StaticResource IconNext}" Size="20" />
                        </Button>
                    </StackPanel>
                    <ToggleButton
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind Player.RepeatLabel, Mode=OneWay}"
                        Command="{x:Bind Player.CycleRepeatCommand}"
                        IsChecked="{x:Bind shell:Bind.RepeatOn(Player.Repeat), Mode=OneWay}"
                        Style="{StaticResource JfToggleIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind Player.RepeatLabel, Mode=OneWay}">
                        <controls:StrokeIcon Data="{x:Bind shell:Bind.RepeatGlyph(Player.Repeat), Mode=OneWay}" Size="18" />
                    </ToggleButton>
                </StackPanel>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock MinWidth="36" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" Foreground="{ThemeResource JfInk70}" Style="{StaticResource JfTimeText}" Text="{x:Bind Player.BarProgress.PositionText, Mode=OneWay}" TextAlignment="Right" />
                    <controls:SeekBar
                        x:Name="Seek"
                        x:Uid="NowPlaying_Seek"
                        Grid.Column="1"
                        Height="22"
                        AutomationProperties.Name="Position"
                        ReduceMotion="{x:Bind Shell.ReduceMotion, Mode=OneWay}"
                        ValueText="{x:Bind Player.BarProgress.AccessibleText, Mode=OneWay}" />
                    <TextBlock Grid.Column="2" MinWidth="36" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" Foreground="{ThemeResource JfInk70}" Style="{StaticResource JfTimeText}" Text="{x:Bind Player.BarProgress.RemainingText, Mode=OneWay}" />
                </Grid>
            </StackPanel>

            <!-- The quality badge, Lyrics, Queue, the device button (remote sources), the volume, the mini player and More. -->
            <StackPanel x:Name="Tools" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" SizeChanged="OnToolsSizeChanged" Spacing="2">
                <Button
                    x:Name="QualityBadge"
                    x:Uid="Bar_Quality"
                    Margin="0,0,6,0"
                    AutomationProperties.Name="{x:Bind Player.QualityBadgeLabel, Mode=OneWay}"
                    Click="OnQualityClick"
                    Style="{StaticResource JfQualityBadgeStyle}"
                    ToolTipService.ToolTip="Streaming Quality"
                    Visibility="{x:Bind shell:Bind.Visible(Player.HasQualityBadge), Mode=OneWay}">
                    <TextBlock MaxLines="1" Text="{x:Bind Player.QualityBadge, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                </Button>
                <Button x:Uid="Bar_Lyrics" AutomationProperties.Name="Lyrics" Click="OnLyricsClick" Style="{StaticResource JfIconButtonStyle}" ToolTipService.ToolTip="Lyrics" Visibility="{x:Bind shell:Bind.Visible(FitsPanes), Mode=OneWay}">
                    <controls:StrokeIcon Data="{StaticResource IconLyrics}" Size="20" />
                </Button>
                <Button x:Uid="Bar_Queue" AutomationProperties.Name="Queue" Click="OnQueueClick" Style="{StaticResource JfIconButtonStyle}" ToolTipService.ToolTip="Queue" Visibility="{x:Bind shell:Bind.Visible(FitsPanes), Mode=OneWay}">
                    <controls:StrokeIcon Data="{StaticResource IconQueue}" Size="20" />
                </Button>
                <Button
                    x:Name="DeviceButton"
                    AutomationProperties.Name="{x:Bind Player.OutputLabel, Mode=OneWay}"
                    Click="OnDeviceClick"
                    Style="{StaticResource JfIconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind Player.OutputName, Mode=OneWay}"
                    Visibility="{x:Bind shell:Bind.Visible(Player.IsRemote), Mode=OneWay}">
                    <controls:StrokeIcon Data="{x:Bind shell:Bind.Glyph(Player.OutputGlyph), Mode=OneWay}" Size="20" />
                </Button>
                <Button
                    AutomationProperties.Name="{x:Bind Player.MuteLabel, Mode=OneWay}"
                    Command="{x:Bind Player.ToggleMuteCommand}"
                    Style="{StaticResource JfIconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind Player.MuteLabel, Mode=OneWay}"
                    Visibility="{x:Bind shell:Bind.VisibleIfAll(Player.CanMute, FitsMute), Mode=OneWay}">
                    <controls:StrokeIcon Data="{x:Bind shell:Bind.VolumeGlyph(Player.Volume, Player.IsMuted), Mode=OneWay}" Size="20" />
                </Button>
                <Slider
                    x:Name="VolumeSlider"
                    x:Uid="NowPlaying_Volume"
                    Width="112"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Volume"
                    Style="{StaticResource JfThinSliderStyle}"
                    Value="{x:Bind Player.Volume, Mode=OneWay}"
                    ValueChanged="OnVolumeChanged"
                    Visibility="{x:Bind shell:Bind.VisibleIfAll(Player.ShowsVolume, FitsVolumeLine), Mode=OneWay}" />
                <Button x:Uid="Bar_MiniPlayer" AutomationProperties.Name="Open Mini Player" Click="OnMiniPlayerClick" Style="{StaticResource JfIconButtonStyle}" ToolTipService.ToolTip="Open Mini Player (Ctrl+M)">
                    <controls:StrokeIcon Data="{StaticResource IconMiniPlayer}" Size="20" />
                </Button>
                <Button
                    x:Name="MoreButton"
                    x:Uid="More_Button"
                    AutomationProperties.Name="More"
                    Click="OnMoreClick"
                    Style="{StaticResource JfIconButtonStyle}"
                    ToolTipService.ToolTip="More">
                    <controls:StrokeIcon Data="{StaticResource IconMore}" Size="20" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
