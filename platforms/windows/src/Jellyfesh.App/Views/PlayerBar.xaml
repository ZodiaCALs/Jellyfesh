<?xml version="1.0" encoding="utf-8"?>
<!--
    The player bar for windows 900 px and wider (docs/design-controls.md, "v0.0.4"), after Media
    Player and Apple Music: a floating Veil bar 80 px high with r-xl corners. Start: the artwork and
    two lines of type (they open Now Playing). Middle: the transport capsule (shuffle, previous,
    play, next, repeat; play is the only accent fill) above the seek bar with its times. End:
    Lyrics, Queue and the volume. It bends CMP-02 (one control) on purpose, for desktop use.
-->
<UserControl
    x:Class="Jellyfesh.App.Views.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jellyfesh.App.Controls"
    xmlns:shell="using:Jellyfesh.App.Shell"
    xmlns:th="using:Jellyfesh.App.Theming">

    <Grid Height="{th:Token Key=Player.BarHeight}">
        <Border CornerRadius="{th:Token Key=Radius.Xl, Kind=Corner}" Style="{StaticResource JfVeilCapsuleStyle}" />
        <Grid Padding="10,6,14,6" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="180" />
                <ColumnDefinition Width="2*" MaxWidth="560" />
                <ColumnDefinition Width="*" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <!-- Start: what is playing; opens Now Playing. -->
            <Button
                x:Name="OpenButton"
                x:Uid="Mini_Open"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                AutomationProperties.Name="Open Now Playing"
                Click="OnOpenClick"
                CornerRadius="{th:Token Key=Radius.Lg, Kind=Corner}"
                Style="{StaticResource JfBareButtonStyle}"
                ToolTipService.ToolTip="Open Now Playing">
                <Grid Padding="4" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Art" Width="48" Height="48" CornerRadius="{th:Token Key=Radius.Md, Kind=Corner}" Background="{ThemeResource JfFill}">
                        <Image controls:Artwork.DecodeSize="96" controls:Artwork.Uri="{x:Bind Player.ArtworkUri, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource JfInk90}" Text="{x:Bind Player.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource JfInk70}" Text="{x:Bind Player.Artist, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Middle: the transport capsule above the seek bar. -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="4">
                    <ToggleButton
                        Width="36"
                        Height="36"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind Player.ShuffleLabel, Mode=OneWay}"
                        Command="{x:Bind Player.ToggleShuffleCommand}"
                        IsChecked="{x:Bind Player.Shuffle, Mode=OneWay}"
                        Style="{StaticResource JfToggleIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind Player.ShuffleLabel, Mode=OneWay}">
                        <controls:StrokeIcon Data="{StaticResource IconShuffle}" Size="16" />
                    </ToggleButton>
                    <Button x:Uid="Player_PreviousButton" Width="36" Height="36" AutomationProperties.Name="Previous" Command="{x:Bind Player.PreviousCommand}" IsEnabled="{x:Bind Player.CanGoPrevious, Mode=OneWay}" Style="{StaticResource JfTransportButtonStyle}" ToolTipService.ToolTip="Previous (Ctrl+B)">
                        <controls:StrokeIcon Data="{StaticResource IconPrevious}" Size="18" />
                    </Button>
                    <Button
                        Width="40"
                        Height="40"
                        AutomationProperties.Name="{x:Bind Player.PlayPauseLabel, Mode=OneWay}"
                        Command="{x:Bind Player.PlayPauseCommand}"
                        Style="{StaticResource JfPlayButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind Player.PlayPauseLabel, Mode=OneWay}">
                        <controls:PlayPauseGlyph IsPlaying="{x:Bind Player.IsPlaying, Mode=OneWay}" ReduceMotion="{x:Bind Shell.ReduceMotion, Mode=OneWay}" Size="18" />
                    </Button>
                    <Button x:Uid="Player_NextButton" Width="36" Height="36" AutomationProperties.Name="Next" Command="{x:Bind Player.NextCommand}" IsEnabled="{x:Bind Player.CanGoNext, Mode=OneWay}" Style="{StaticResource JfTransportButtonStyle}" ToolTipService.ToolTip="Next (Ctrl+F)">
                        <controls:StrokeIcon Data="{StaticResource IconNext}" Size="18" />
                    </Button>
                    <ToggleButton
                        Width="36"
                        Height="36"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind Player.RepeatLabel, Mode=OneWay}"
                        Command="{x:Bind Player.CycleRepeatCommand}"
                        IsChecked="{x:Bind shell:Bind.RepeatOn(Player.Repeat), Mode=OneWay}"
                        Style="{StaticResource JfToggleIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind Player.RepeatLabel, Mode=OneWay}">
                        <controls:StrokeIcon Data="{x:Bind shell:Bind.RepeatGlyph(Player.Repeat), Mode=OneWay}" Size="16" />
                    </ToggleButton>
                </StackPanel>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock MinWidth="36" VerticalAlignment="Center" Style="{StaticResource JfTimeText}" Foreground="{ThemeResource JfInk70}" Text="{x:Bind Player.BarProgress.PositionText, Mode=OneWay}" TextAlignment="Right" AutomationProperties.AccessibilityView="Raw" />
                    <controls:SeekBar
                        x:Name="Seek"
                        x:Uid="NowPlaying_Seek"
                        Grid.Column="1"
                        Height="22"
                        AutomationProperties.Name="Position"
                        ReduceMotion="{x:Bind Shell.ReduceMotion, Mode=OneWay}"
                        ValueText="{x:Bind Player.BarProgress.AccessibleText, Mode=OneWay}" />
                    <TextBlock Grid.Column="2" MinWidth="36" VerticalAlignment="Center" Style="{StaticResource JfTimeText}" Foreground="{ThemeResource JfInk70}" Text="{x:Bind Player.BarProgress.RemainingText, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </StackPanel>

            <!-- End: Lyrics, Queue and the volume. -->
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                <Button x:Uid="Bar_Lyrics" AutomationProperties.Name="Lyrics" Click="OnLyricsClick" Style="{StaticResource JfIconButtonStyle}" ToolTipService.ToolTip="Lyrics">
                    <controls:StrokeIcon Data="{StaticResource IconLyrics}" Size="18" />
                </Button>
                <Button x:Uid="Bar_Queue" AutomationProperties.Name="Queue" Click="OnQueueClick" Style="{StaticResource JfIconButtonStyle}" ToolTipService.ToolTip="Queue">
                    <controls:StrokeIcon Data="{StaticResource IconQueue}" Size="18" />
                </Button>
                <Button AutomationProperties.Name="{x:Bind Player.MuteLabel, Mode=OneWay}" Command="{x:Bind Player.ToggleMuteCommand}" Style="{StaticResource JfIconButtonStyle}" ToolTipService.ToolTip="{x:Bind Player.MuteLabel, Mode=OneWay}">
                    <controls:StrokeIcon Data="{x:Bind shell:Bind.VolumeGlyph(Player.Volume, Player.IsMuted), Mode=OneWay}" Size="18" />
                </Button>
                <Slider
                    x:Name="VolumeSlider"
                    x:Uid="NowPlaying_Volume"
                    Width="112"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Volume"
                    Style="{StaticResource JfThinSliderStyle}"
                    Value="{x:Bind Player.Volume, Mode=OneWay}"
                    ValueChanged="OnVolumeChanged" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
