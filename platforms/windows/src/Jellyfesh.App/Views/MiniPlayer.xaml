<?xml version="1.0" encoding="utf-8"?>
<!--
    The capsule under 900 epx (docs/ui.md, "The player bar and the mini player"), Jellyfesh Web's:
    a floating Veil pill player.mini-height high with the round artwork, two lines of type, play
    (never accent-filled, COL-04) and next. Its progress is a straight 2 epx line along the bottom
    edge between the pill's round ends, drawn at whole-pixel steps only. Selecting the capsule opens
    Now Playing. In a remote session the second line is Playing on {Device}.
-->
<UserControl
    x:Class="Jellyfesh.App.Views.MiniPlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jellyfesh.App.Controls"
    xmlns:shell="using:Jellyfesh.App.Shell"
    xmlns:th="using:Jellyfesh.App.Theming">

    <Grid
        x:Name="Capsule"
        Height="{th:Token Key=Player.MiniHeight}"
        MaxWidth="560"
        SizeChanged="OnCapsuleSizeChanged">
        <Border CornerRadius="{th:Token Key=Radius.Full, Kind=Corner}" Style="{StaticResource JfVeilCapsuleStyle}" />
        <Grid Padding="8,0" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="OpenButton"
                x:Uid="Mini_Open"
                Height="52"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Padding="4,0,8,0"
                AutomationProperties.Name="Open Now Playing"
                Click="OnOpenClick"
                CornerRadius="{th:Token Key=Radius.Full, Kind=Corner}"
                Style="{StaticResource JfBareButtonStyle}"
                ToolTipService.ToolTip="Open Now Playing">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{th:Token Key=Artwork.SizeMini, Kind=Pixels}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Art" Width="{th:Token Key=Artwork.SizeMini}" Height="{th:Token Key=Artwork.SizeMini}" VerticalAlignment="Center" Background="{ThemeResource JfFill}" CornerRadius="{th:Token Key=Radius.Full, Kind=Corner}">
                        <Image controls:Artwork.DecodeSize="80" controls:Artwork.Uri="{x:Bind Player.ArtworkUri, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="14.5" FontWeight="SemiBold" Foreground="{ThemeResource JfInk90}" Text="{x:Bind Player.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource JfInk70}" Text="{x:Bind Player.Artist, Mode=OneWay}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind shell:Bind.Collapsed(Player.IsRemote), Mode=OneWay}" />
                        <TextBlock Style="{StaticResource JfRemoteLineText}" Text="{x:Bind Player.RemoteDeviceText, Mode=OneWay}" Visibility="{x:Bind shell:Bind.Visible(Player.IsRemote), Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Button>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind Player.PlayPauseLabel, Mode=OneWay}"
                Background="{ThemeResource JfFillHover}"
                Command="{x:Bind Player.PlayPauseCommand}"
                Foreground="{ThemeResource JfInk90}"
                Style="{StaticResource JfIconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind Player.PlayPauseLabel, Mode=OneWay}">
                <controls:PlayPauseGlyph IsPlaying="{x:Bind Player.IsPlaying, Mode=OneWay}" ReduceMotion="{x:Bind Shell.ReduceMotion, Mode=OneWay}" Size="22" />
            </Button>
            <Button
                x:Uid="Player_NextButton"
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.Name="Next"
                Command="{x:Bind Player.NextCommand}"
                IsEnabled="{x:Bind Player.CanGoNext, Mode=OneWay}"
                Style="{StaticResource JfTransportButtonStyle}"
                Width="44"
                Height="44"
                ToolTipService.ToolTip="Next (Ctrl+→)">
                <controls:StrokeIcon Data="{StaticResource IconNext}" Size="20" />
            </Button>
        </Grid>
        <!-- The progress line between the pill's round ends (half its height in): the rest ink-10, the played part ink-70. -->
        <Border
            Height="{th:Token Key=Player.MiniProgress}"
            Margin="32,0"
            VerticalAlignment="Bottom"
            Background="{ThemeResource JfInk10}"
            CornerRadius="1"
            IsHitTestVisible="False" />
        <Border
            x:Name="ProgressLine"
            Width="0"
            Height="{th:Token Key=Player.MiniProgress}"
            Margin="32,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            AutomationProperties.AccessibilityView="Raw"
            Background="{ThemeResource JfInk70}"
            CornerRadius="1"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>
