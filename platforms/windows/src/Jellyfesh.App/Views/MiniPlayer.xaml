<?xml version="1.0" encoding="utf-8"?>
<!--
    The mini player under 900 px (docs/design-controls.md, "v0.0.4"): a floating Veil capsule with
    player.mini-radius corners, the artwork, two lines of type and exactly one control, play/pause
    (Misty CMP-02), never accent-filled (COL-04). Its progress is a straight 2 px line along the
    bottom edge, inset by the corners, drawn at whole-pixel steps only. Selecting the capsule opens
    Now Playing.
-->
<UserControl
    x:Class="Jellyfesh.App.Views.MiniPlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jellyfesh.App.Controls"
    xmlns:th="using:Jellyfesh.App.Theming">

    <Grid
        x:Name="Capsule"
        Height="{th:Token Key=Player.MiniHeight}"
        MinWidth="300"
        MaxWidth="560"
        SizeChanged="OnCapsuleSizeChanged">
        <Border CornerRadius="{th:Token Key=Player.MiniRadius, Kind=Corner}" Style="{StaticResource JfVeilCapsuleStyle}" />
        <Grid Padding="10" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="OpenButton"
                x:Uid="Mini_Open"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Open Now Playing"
                Click="OnOpenClick"
                CornerRadius="{th:Token Key=Radius.Lg, Kind=Corner}"
                Style="{StaticResource JfBareButtonStyle}"
                ToolTipService.ToolTip="Open Now Playing">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Art" Width="44" Height="44" CornerRadius="{th:Token Key=Radius.Md, Kind=Corner}" Background="{ThemeResource JfFill}">
                        <Image controls:Artwork.DecodeSize="88" controls:Artwork.Uri="{x:Bind Player.ArtworkUri, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource JfInk90}" Text="{x:Bind Player.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource JfInk70}" Text="{x:Bind Player.Artist, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Button>
            <Button
                Grid.Column="1"
                AutomationProperties.Name="{x:Bind Player.PlayPauseLabel, Mode=OneWay}"
                Command="{x:Bind Player.PlayPauseCommand}"
                Style="{StaticResource JfIconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind Player.PlayPauseLabel, Mode=OneWay}">
                <controls:PlayPauseGlyph IsPlaying="{x:Bind Player.IsPlaying, Mode=OneWay}" ReduceMotion="{x:Bind Shell.ReduceMotion, Mode=OneWay}" Size="18" />
            </Button>
        </Grid>
        <!-- The progress line: the rest faint, the played part ink-90 (player.mini-progress). -->
        <Border
            Height="{th:Token Key=Player.MiniProgress}"
            Margin="{th:Token Key=Player.MiniRadius, Kind=Thickness, Sides=LR}"
            VerticalAlignment="Bottom"
            Background="{ThemeResource JfInk10}"
            CornerRadius="1"
            IsHitTestVisible="False" />
        <Border
            x:Name="ProgressLine"
            Width="0"
            Height="{th:Token Key=Player.MiniProgress}"
            Margin="{th:Token Key=Player.MiniRadius, Kind=Thickness, Sides=L}"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            AutomationProperties.AccessibilityView="Raw"
            Background="{ThemeResource JfInk90}"
            CornerRadius="1"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>
