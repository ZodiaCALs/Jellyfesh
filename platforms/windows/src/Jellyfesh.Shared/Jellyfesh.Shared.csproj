<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Everything of the Windows app that is not WinUI: the core client seam (ICoreClient), view
    models, formatting, drawing-time scheduling and settings models. It never names a type of the
    Jellyfesh.Ffi binding (Jellyfesh.Interop maps them), so it builds and is tested on any OS.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfesh</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfesh.Shared.Tests" />
  </ItemGroup>
</Project>
