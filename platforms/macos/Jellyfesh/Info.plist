<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Jellyfesh</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
		<string>zh-Hant</string>
		<string>ja</string>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.music</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Jellyfesh. All rights reserved.</string>
	<key>JFEdition</key>
	<string>$(JF_EDITION)</string>
	<key>JFDistribution</key>
	<string>$(JF_DISTRIBUTION)</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Jellyfesh reads the music in folders you add to your library.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Jellyfesh reads the music in folders you add to your library.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Jellyfesh reads the music in folders you add to your library.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Jellyfesh reads the music on drives you add to your library.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>Jellyfesh reads the music on network drives you add to your library.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>Jellyfesh plays songs from your Apple Music subscription when you turn Apple Music on in Sources.</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.audio</string>
				<string>public.mp3</string>
				<string>public.mpeg-4-audio</string>
				<string>org.xiph.flac</string>
				<string>public.aiff-audio</string>
				<string>com.microsoft.waveform-audio</string>
				<string>org.xiph.ogg-vorbis</string>
				<string>org.xiph.opus</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Jellyfesh Plugin</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.jellyfesh.plugin</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.jellyfesh.plugin</string>
			<key>UTTypeDescription</key>
			<string>Jellyfesh Plugin</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>jfpkg</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
