    "Official sources are signed by Jellyfesh. Community plugins are made by others and are off unless you allow them.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公式ソースは Jellyfesh が署名しています。コミュニティプラグインは他の人が作ったもので、許可しない限りオフのままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "官方来源由 Jellyfesh 签名。社区插件由他人制作，除非你允许，否则保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "官方來源由 Jellyfesh 簽署。社群外掛由他人製作，除非你允許，否則會保持關閉。"
          }
        }
      }
    },
