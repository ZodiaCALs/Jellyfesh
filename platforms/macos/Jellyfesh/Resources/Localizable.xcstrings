    "A translation under each line, when the lyrics have one.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歌詞に翻訳があれば、各行の下に表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "歌词附有翻译时，在每行下方显示。"
