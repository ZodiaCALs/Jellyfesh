    "Add your music folders, or connect a server in Sources.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽フォルダを追加するか、「ソース」でサーバーに接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加你的音乐文件夹，或在“来源”中连接服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入你的音樂資料夾，或在「來源」中連線至伺服器。"
          }
        }
      }
    },
