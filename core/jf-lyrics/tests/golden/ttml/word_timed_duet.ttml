  <body dur="20.000">
    <div begin="1.000" end="9.000" ttm:agent="v1">
      <p begin="1.000" end="3.200" itunes:key="L1"><span begin="1.000" end="1.400">Meet</span> <span begin="1.400" end="1.700">me</span> <span begin="1.700" end="2.000">by</span> <span begin="2.000" end="2.300">the</span> <span begin="2.300" end="3.200">ferry</span></p>
      <p begin="3.400" end="5.600" itunes:key="L2" ttm:agent="v2"><span begin="3.400" end="3.800">I'll</span> <span begin="3.800" end="4.200">bring</span> <span begin="4.200" end="4.500">the</span> <span begin="4.500" end="4.900">um</span><span begin="4.900" end="5.200">brel</span><span begin="5.200" end="5.600">la</span></p>
      <p begin="5.800" end="8.000" itunes:key="L3" ttm:agent="v1000"><span begin="5.800" end="6.400">Rain</span> <span begin="6.400" end="6.900">or</span> <span begin="6.900" end="8.000">shine!</span></p>
      <p begin="7.500" end="9.000" itunes:key="L4" ttm:agent="v2"><span begin="7.500" end="9.000">Together</span></p>
    </div>
