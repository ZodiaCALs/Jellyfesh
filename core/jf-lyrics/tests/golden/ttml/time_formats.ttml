<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" ttp:frameRate="25">
  <body>
    <div>
      <p begin="00:00:01.250" end="00:00:02.500">Full clock time</p>
      <p begin="00:03.000" end="00:04.750">Minutes and seconds</p>
      <p begin="5.5" end="6.125">Bare seconds</p>
      <p begin="7.25s" dur="1250ms">Offset seconds with a duration in milliseconds</p>
      <p begin="0.15m" end="0.0026h">Offset minutes and hours</p>
      <p begin="00:00:10:05" end="275f">Frames at twenty-five per second</p>
      <p begin="12s">An open ending</p>
    </div>
  </body>
</tt>
