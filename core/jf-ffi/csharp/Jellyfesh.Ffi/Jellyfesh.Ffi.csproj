<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Jellyfesh.Ffi: the C# binding of jf-core over jf-ffi's JSON C ABI (docs/ffi.md).
    Hand-written; `cargo xtask bindings -\-lang csharp` copies it, with the native library in
    ../native/, into platforms/windows/Generated/.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfesh.Ffi</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Enables the trimming and NativeAOT analyzers: the library must stay AOT-safe (spike S8). -->
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.0.4</Version>
  </PropertyGroup>

  <!-- The native library copied next to this project by xtask; referencing projects get it in
       their output folder. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../native/*"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
