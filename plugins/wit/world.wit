package jellyfesh:plugin@1.3.0;

/// A source plugin: one online service, server or lyrics provider.
///
/// A plugin is a WebAssembly component built for this world (the SDK,
/// `plugins/sdk`, does it from Rust) and packed with its manifest into a
/// `.jfpkg` (ADR-0004). It has no WASI imports at all: no files, sockets,
/// environment or arguments; everything goes through the imports below.
///
/// Every export must be present. Capabilities a plugin does not implement
/// return `plugin-error.unsupported` (the SDK does this for you), and the host
/// never calls a capability the manifest does not declare.
///
/// Versioning: the manifest's `api_version` names the package `major.minor`
/// the plugin targets. The major version must match the host's; a plugin
/// built for an older minor runs on a newer host. 1.1 added the `remote`
/// interface (world `remote-source`) and manifest links; every 1.0 interface
/// is unchanged, so 1.0 plugins load in 1.1 hosts (ADR-0018). 1.2 added the
/// world `plugin` (ADR-0019, ADR-0020); 1.0 and 1.1 plugins load unchanged.
/// 1.3 added the `library` and `download` exports to `plugin` and the
/// manifest's `content_policy.qualities` (ADR-0024, ADR-0025, ADR-0026); no
/// earlier record, enum or function changed, so 1.0–1.2 plugins load
/// unchanged.
world source {
    import http;
    import kv;
    import crypto;
    import clock;
    import log;

    export meta;
    export auth;
    export catalog;
    export playback;
    export lyrics;
    export artwork;
    export recommendations;
}

/// A source plugin built with API 1.1: everything in `source`, plus remote
/// control. The SDK builds this world; `remote` answers `unsupported` unless
/// the plugin implements it and its manifest declares the `remote` capability.
world remote-source {
    include source;
    export remote;
}

/// The remote-control part of a 1.1 plugin, which hosts look up on its own
/// for plugins that declare `remote` (1.0 plugins do not export it).
world remote-control {
    export remote;
}

/// A plugin built with API 1.2: everything in `remote-source`, the song's
/// audio and on-device speech recognition for making lyrics, and the new
/// exports. The SDK builds this world and answers `unsupported` for every
/// export a plugin does not implement. A host calls an export only when the
/// manifest declares its capability (`make_lyrics`, `appearance`,
/// `discover`, `details`, `comments`), and serves `audio` and `speech` only
/// to plugins whose manifest declares the permission of that name; to the
/// others they answer `not-declared`.
///
/// Packages that use any of it declare `api_version = "1.2"`. A plugin built
/// with SDK 1.2 that uses none of it may keep an older `api_version`, so it
/// also loads in older hosts.
///
/// API 1.3 adds the exports `library` (capability `library`: the person's
/// likes and playlists, ADR-0024) and `download` (capability `download`:
/// files from the person's own server, ADR-0025). Packages that declare
/// either, or `content_policy.qualities`, declare `api_version = "1.3"`.
world plugin {
    include remote-source;

    import audio;
    import speech;

    export maker;
    export appearance;
    export discover;
    export details;
    export comments;
    export library;
    export download;
}

/// The making-lyrics part of `plugin`: what a host links and looks up for
/// plugins that declare `make_lyrics` (older plugins do not export it).
world maker-part {
    import audio;
    import speech;
    export maker;
}

/// The appearance part of `plugin`, looked up for plugins that declare
/// `appearance`.
world appearance-part {
    export appearance;
}

/// The Discover part of `plugin`, looked up for plugins that declare
/// `discover`.
world discover-part {
    export discover;
}

/// The details part of `plugin`, looked up for plugins that declare
/// `details`.
world details-part {
    export details;
}

/// The comments part of `plugin`, looked up for plugins that declare
/// `comments`.
world comments-part {
    export comments;
}

/// The library part of `plugin` (API 1.3), looked up for plugins that
/// declare `library`.
world library-part {
    export library;
}

/// The download part of `plugin` (API 1.3), looked up for plugins that
/// declare `download`.
world download-part {
    export download;
}
