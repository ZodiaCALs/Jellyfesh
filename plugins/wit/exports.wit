package jellyfesh:plugin@1.3.0;

/// Plugin metadata and settings.
///
/// Every export of a plugin runs under the sandbox limits: about 200 ms of CPU
/// (2 s for `auth.begin`), 10 s of wall-clock time (30 s for login steps)
/// and 64 MiB of memory. A plugin that traps or exceeds a limit is restarted
/// on its next call; three violations in a row disable it with a visible
/// reason. The host only calls capabilities the manifest declares.
interface meta {
    use types.{plugin-error};

    /// Something a plugin can do. Mirrors `capabilities` in the manifest
    /// (`resolve-stream` is `resolve_stream` there).
    enum capability {
        /// Log in and out (`auth`).
        auth,
        /// `catalog.search`.
        search,
        /// `catalog.browse`.
        browse,
        /// `playback.resolve-stream`.
        resolve-stream,
        /// `lyrics.lyrics`.
        lyrics,
        /// `artwork.artwork`.
        artwork,
        /// `recommendations`.
        recommendations,
    }

    /// What the plugin can do right now, for example after it has asked the
    /// configured server which features it supports. Must be a subset of the
    /// manifest's capabilities; the host ignores anything else.
    capabilities: func() -> list<capability>;

    /// The person's settings: a JSON object that matches the package's
    /// settings schema (`{}` when there is none). The host calls this once
    /// after every instantiation, before any other export except
    /// `capabilities`, and again whenever the settings change. Return an
    /// error to report settings the plugin cannot use; the host shows it.
    settings-changed: func(settings: string) -> result<_, plugin-error>;
}

/// Logging in and out.
///
/// The host owns the state machine and the UI renders each step natively; the
/// plugin only answers `begin`, `poll` and `submit`:
///
/// * `begin` starts a flow of one of the kinds the manifest lists;
/// * `poll` is called while a step is `show-qr`, `show-code`, `waiting` or
///   `open-url` without capture, after `flow-step.poll-after-ms`;
/// * `submit` delivers what the person typed for `ask-fields`, or the
///   authorisation code the host caught for `open-url` with loopback capture;
/// * a flow ends with `done` (logged in) or `failed`.
///
/// Per kind:
///
/// * `qr`: return `show-qr` (or `show-code` for a code to type elsewhere, as
///   with Jellyfin Quick Connect), then answer `poll` until `done`.
/// * `oauth`: authorisation code with PKCE in the system browser. `begin`
///   receives `flow.oauth` (redirect URI, S256 challenge, state) and returns
///   `open-url` with `loopback` capture; the host catches the redirect on
///   127.0.0.1, checks `state`, and calls `submit` with the fields `code`,
///   `code-verifier` and `redirect-uri`. Exchange the code and store the
///   tokens with `kv.set-secret`.
/// * `cookie-import`: return `ask-fields` with one `cookie-header` field. The
///   host keeps only the cookies the manifest's `[cookie_import]` names,
///   stores them in the plugin's jar for that URL, and calls `submit` with
///   the field's value replaced by the imported cookie names.
/// * `password-exchange`: return `ask-fields` (user name, password with
///   `secret` set). `submit` gets the password once; exchange it for a token
///   in that call and store only the token. The host never stores the
///   password, refuses any attempt by the plugin to store it, and restarts
///   the plugin's instance afterwards so it does not linger in memory.
/// * `api-key`: return `ask-fields` with a `secret` field; validate the key
///   in `submit` and keep it with `kv.set-secret`.
interface auth {
    use types.{plugin-error};

    /// The ways to log in. A manifest lists the kinds a plugin supports.
    enum auth-kind {
        qr,
        oauth,
        cookie-import,
        password-exchange,
        api-key,
    }

    /// What the host prepared for an `oauth` flow.
    record oauth-request {
        /// Where the browser must be sent back to, for example
        /// `http://127.0.0.1:49152/callback`. Use it verbatim as the
        /// `redirect_uri` of the authorisation and token requests.
        redirect-uri: string,
        /// The PKCE code challenge (base64url of the SHA-256 of the verifier).
        code-challenge: string,
        /// Always `S256`.
        code-challenge-method: string,
        /// The `state` parameter to put in the authorisation URL; the host
        /// checks it on the redirect.
        state: string,
    }

    /// A login flow in progress, as the host passes it to every call.
    record flow {
        /// Host-assigned identifier, unique per flow.
        id: string,
        /// The kind the flow was started with.
        kind: auth-kind,
        /// Whatever the plugin returned in `flow-step.state` last time: empty
        /// at `begin`. Keeping progress here instead of in memory lets a flow
        /// survive an instance restart.
        state: string,
        /// Set for `oauth` flows.
        oauth: option<oauth-request>,
    }

    /// How a field should be entered and shown.
    enum field-kind {
        /// Plain text.
        text,
        /// An e-mail address.
        email,
        /// A URL.
        url,
        /// Digits only, such as a one-time code.
        number,
        /// A `Cookie:` header copied from a browser (`cookie-import` flows).
        cookie-header,
    }

    /// One input the person fills in.
    record field-spec {
        /// Key in the submitted fields: 1–64 characters from `a-z 0-9 _ -`.
        name: string,
        /// Label shown next to the input.
        label: string,
        kind: field-kind,
        /// Masked while typing, never logged, never stored by the host; for
        /// `password-exchange` the plugin may not store it either.
        secret: bool,
        /// The person must fill it in.
        required: bool,
        /// Example shown inside the empty input.
        placeholder: option<string>,
        /// A sentence of help under the input.
        help: option<string>,
    }

    /// A submitted value.
    record field-value {
        name: string,
        value: string,
    }

    /// A QR code for the person to scan with the service's app.
    record qr-code {
        /// The payload to encode, usually a URL.
        data: string,
        /// One sentence for the person ("Scan with the Example app").
        hint: option<string>,
        /// When the code stops working; the host ends the flow then.
        expires-at-ms: option<u64>,
    }

    /// A short code for the person to enter on another device.
    record code-display {
        /// The code, shown large ("482 913").
        code: string,
        /// Where to enter it ("In Jellyfin, open Quick Connect").
        hint: string,
        /// When the code stops working; the host ends the flow then.
        expires-at-ms: option<u64>,
    }

    /// How the host learns that the browser part of a flow is finished.
    enum redirect-capture {
        /// It does not: the host keeps calling `poll`.
        none,
        /// The host catches the redirect to `oauth-request.redirect-uri` and
        /// calls `submit` with the code.
        loopback,
    }

    /// A web page to open in the system browser (never an embedded view).
    record open-url {
        /// The `https` URL to open. It must be covered by the network allowlist.
        url: string,
        capture: redirect-capture,
    }

    /// What the UI shows next.
    variant step {
        show-qr(qr-code),
        show-code(code-display),
        open-url(open-url),
        /// A form. Every `field-spec.name` must be unique.
        ask-fields(list<field-spec>),
        /// Progress text while the host polls ("Waiting for confirmation").
        waiting(string),
        /// Logged in: the account's display name.
        done(string),
        /// The flow ended without a login; the text says why.
        failed(string),
    }

    /// A step plus the plugin's bookkeeping for it.
    record flow-step {
        step: step,
        /// Opaque state the host keeps and passes back in `flow.state`;
        /// at most 16 KiB. Not for secrets.
        state: string,
        /// For steps the host polls: how long to wait before the next `poll`.
        /// Clamped to 0.2–30 s; none means 2 s.
        poll-after-ms: option<u32>,
    }

    /// Starts a flow.
    begin: func(flow: flow) -> result<flow-step, plugin-error>;
    /// Asks how a polled flow is going.
    poll: func(flow: flow) -> result<flow-step, plugin-error>;
    /// Delivers form fields or the caught authorisation code.
    submit: func(flow: flow, fields: list<field-value>) -> result<flow-step, plugin-error>;
    /// Ends the session: revoke tokens on the service where it allows, then
    /// forget them. The host deletes the plugin's secrets and cookie jar
    /// afterwards, whatever this returns.
    logout: func() -> result<_, plugin-error>;
}

/// Searching and browsing the service's catalogue.
interface catalog {
    use types.{item, item-kind, item-page, page-request, plugin-error};

    /// Narrows a search.
    record search-filters {
        /// Kinds wanted; empty means all kinds.
        kinds: list<item-kind>,
    }

    /// Full-text search, results in the service's relevance order.
    search: func(query: string, filters: search-filters, page: page-request) -> result<item-page, plugin-error>;

    /// Lists the children of `node`: an album's tracks, an artist's albums, a
    /// playlist's or folder's entries. None lists the root: the plugin's
    /// top-level sections as `folder` items.
    browse: func(node: option<item>, page: page-request) -> result<item-page, plugin-error>;
}

/// Turning a track into something the engine can play.
interface playback {
    use types.{header, item, plugin-error};

    /// The quality the person chose for this network.
    enum quality {
        /// Data saver, about 96 kbit/s.
        low,
        /// About 160–192 kbit/s.
        normal,
        /// About 320 kbit/s.
        high,
        /// The original file or lossless.
        lossless,
    }

    /// Where and how the engine fetches the audio.
    record stream-info {
        /// The `http` or `https` URL of the audio; it must be covered by the
        /// network allowlist. The engine fetches it with range requests.
        url: string,
        /// Headers for every request to `url` (for example authorisation).
        headers: list<header>,
        /// When `url` stops working; the host resolves again after that.
        expires-at-ms: option<u64>,
        /// Codec or container hint ("flac", "mp3", "aac", "opus", "vorbis").
        codec: option<string>,
        /// Nominal bitrate in kbit/s, if known.
        bitrate-kbps: option<u32>,
        /// Whether the host may keep the audio in its cache (subject to the
        /// manifest's content policy).
        cacheable: bool,
    }

    /// Resolves a playable track. Fails with `service` (or returns an item
    /// that is not playable from search) rather than working around a
    /// paywall or region lock.
    resolve-stream: func(item: item, quality: quality) -> result<stream-info, plugin-error>;
}

/// Lyrics for a track.
interface lyrics {
    use types.{item, plugin-error};

    /// Format of `lyric-payload.text`; the host converts each into its own
    /// lyric model.
    enum lyric-format {
        /// Unsynchronised plain text.
        plain,
        /// LRC with line timestamps.
        lrc,
        /// Enhanced LRC with word timestamps.
        elrc,
        /// TTML (Apple-style, line or word timing).
        ttml,
        /// WebVTT.
        vtt,
        /// JSON with syllable timing.
        json-syllables,
    }

    /// Lyrics as the service provides them.
    record lyric-payload {
        format: lyric-format,
        /// The lyrics document itself, at most 1 MiB.
        text: string,
        /// BCP 47 language tag of the lyrics, if known.
        language: option<string>,
        /// Attribution to show with the lyrics ("Lyrics provided by …").
        attribution: option<string>,
    }

    /// Lyrics for `item`, or none when the service has none.
    lyrics: func(item: item) -> result<option<lyric-payload>, plugin-error>;
}

/// Cover art and photos.
interface artwork {
    use types.{image-ref, item, plugin-error};

    /// A picture for `item` about `size` pixels on its longer edge (the host
    /// asks for 64–3000), or none.
    artwork: func(item: item, size: u32) -> result<option<image-ref>, plugin-error>;
}

/// Suggestions from the service.
interface recommendations {
    use types.{item, item-page, page-request, plugin-error};

    /// Items like `item` ("radio", similar artists).
    for-item: func(item: item, page: page-request) -> result<item-page, plugin-error>;
    /// Personal suggestions for the logged-in account.
    for-user: func(page: page-request) -> result<item-page, plugin-error>;
}

/// Remote control of the service's own player (API 1.1): the person's
/// devices, what plays on them, and the transport. For plugins whose manifest
/// declares the `remote` capability with `playback_mode = "remote"`; their
/// items play on the service's devices, never through Jellyfesh's engine, and
/// never join its queue (ADR-0011, ADR-0018).
///
/// The host polls `state` (about every second while something plays, less
/// often while paused) and calls the commands when the person uses the
/// transport. Commands may take effect a moment later; the next `state` shows
/// the result.
interface remote {
    use types.{item, plugin-error};

    /// What kind of device something plays on.
    enum device-kind {
        computer,
        smartphone,
        speaker,
        tv,
        car,
        other,
    }

    /// A device the service can play on.
    record device {
        /// The service's identifier, passed back in `play` and `transfer`.
        id: string,
        /// The name the person gave the device.
        name: string,
        kind: device-kind,
        /// The device the service plays on now (at most one).
        active: bool,
        /// Whether `set-volume` works on this device.
        supports-volume: bool,
        /// Volume in percent (0–100), if known.
        volume-percent: option<u32>,
    }

    /// The repeat mode of the service's player.
    enum repeat {
        off,
        /// The whole context (album, playlist).
        all,
        /// The current track.
        one,
    }

    /// What the service's player is doing.
    record playback-state {
        /// The device it plays on.
        device: option<device>,
        /// The current track, in the plugin's item shape (so it can be played,
        /// browsed or shown like any item).
        item: option<item>,
        /// The album, playlist or artist it plays from, if any.
        context: option<item>,
        playing: bool,
        /// Position in the track when the state was read, in milliseconds.
        position-ms: u32,
        shuffle: bool,
        repeat: repeat,
    }

    /// The person's devices, the active one first.
    devices: func() -> result<list<device>, plugin-error>;
    /// What plays now; none when nothing plays on any device.
    state: func() -> result<option<playback-state>, plugin-error>;
    /// Plays on `device` (none: the active device, or the service's choice):
    /// `context` (an album, playlist or artist) from track `start`, or the
    /// `tracks` given, from `start`. One of them is set.
    play: func(device: option<string>, context: option<item>, tracks: list<item>, start: u32) -> result<_, plugin-error>;
    /// Resumes on the active device.
    resume: func() -> result<_, plugin-error>;
    pause: func() -> result<_, plugin-error>;
    next: func() -> result<_, plugin-error>;
    previous: func() -> result<_, plugin-error>;
    seek: func(position-ms: u32) -> result<_, plugin-error>;
    /// 0–100, on the active device.
    set-volume: func(percent: u32) -> result<_, plugin-error>;
    set-shuffle: func(on: bool) -> result<_, plugin-error>;
    set-repeat: func(mode: repeat) -> result<_, plugin-error>;
    /// Moves playback to `device`, playing if `play` (else as it was).
    transfer: func(device: string, play: bool) -> result<_, plugin-error>;
}

/// Making synced lyrics (capability `make_lyrics`, API 1.2, a Jellyfesh Pro
/// capability; ADR-0019).
///
/// The host calls `plan` whenever the app shows what making lyrics needs
/// (cheap: no network), and `make` for one song the person chose (or, with
/// `automatic`, each song that starts playing without synced lyrics). Pro
/// capabilities answer `pro-required` in the host while Jellyfesh Pro is
/// inactive; the plugin never sees those calls.
///
/// `make` runs under its own limits: 30 minutes of wall-clock time, 10 s of
/// plugin CPU (time inside `audio`, `speech` and `http` does not count) and
/// 128 MiB of memory, in an instance of its own, so the plugin's other calls
/// go on meanwhile. It may be cancelled at any time.
interface maker {
    use types.{plugin-error};
    use lyrics.{lyric-payload};

    /// Where recognition happens.
    enum mode {
        /// The `speech` import, in the app.
        on-device,
        /// The person's own provider, through `http`, after consent.
        online,
    }

    /// What `make` needs first, with the current settings.
    variant need {
        /// Nothing: `make` can run.
        nothing,
        /// The online mode needs the person's API key (Sign In).
        sign-in,
        /// The on-device mode needs this model (an id from `speech.models`)
        /// downloaded.
        model(string),
        /// Making lyrics cannot work at all as set up; the text says why.
        unavailable(string),
    }

    /// What `make` would do now.
    record maker-plan {
        mode: mode,
        /// The engine, for people: "Whisper Base on this device",
        /// "whisper-1 at api.openai.com".
        engine: string,
        /// The origin audio goes to in the online mode
        /// (`https://api.openai.com`); none on the device. The app asks the
        /// person before the first job that sends audio there.
        upload-to: option<string>,
        need: need,
        /// Make lyrics for each song that starts playing without synced lyrics.
        automatic: bool,
    }

    /// The song to make lyrics for.
    record song {
        /// Its `audio.track-handle` for `audio` and `speech`, valid in this
        /// call only. (A plain `u64` here, so that plugins which never touch
        /// `audio` do not import it and still load in older hosts.)
        track: u64,
        title: string,
        artist: option<string>,
        album: option<string>,
        duration-ms: u64,
        /// Plain lyrics to time, when the song has them.
        text: option<string>,
        /// Their language (BCP 47), when known.
        language: option<string>,
    }

    /// Lyrics a plugin made.
    record made {
        /// Enhanced LRC with word timing (`elrc`) is best; `lrc` and `ttml`
        /// are accepted. At most 1 MiB.
        lyrics: lyric-payload,
        /// The engine that recognised the words, as `plan.engine` says it.
        engine: string,
    }

    /// What `make` would do with the current settings. Cheap; no network.
    plan: func() -> result<maker-plan, plugin-error>;
    /// Makes synced lyrics for `song`.
    make: func(song: song) -> result<made, plugin-error>;
}

/// The app's look and layout (capability `appearance`, API 1.2, a Jellyfesh
/// Pro capability; ADR-0020).
///
/// The host calls `look` when the plugin loads and after its settings
/// change, checks the answer (numbers clamped to their ranges, NaN ignored,
/// duplicates dropped, at least one library place kept) and fills in the
/// defaults for what it leaves out. One appearance plugin is active: the
/// first enabled one in install order.
interface appearance {
    use types.{plugin-error};

    /// The face text uses: the platform's own fonts, none bundled.
    enum typeface { system, rounded, serif, mono }
    /// Spacing: × 0.8, 1.0 or 1.2.
    enum density { compact, standard, roomy }
    /// The weight of lyric lines.
    enum lyrics-weight { regular, medium, semibold, bold, heavy }
    /// The colour of the sung part of lyrics.
    variant highlight {
        /// The artwork's colour (the theme's accent from the cover).
        artwork,
        /// The accent colour the person chose in Appearance.
        accent,
        /// This colour, 0xRRGGBB.
        custom(u32),
    }
    /// A place in the sidebar (navigation pane, Library switcher). Settings
    /// is never listed and always shown.
    enum place { home, albums, artists, songs, playlists, favourites, search, sources }
    /// A section of Home.
    enum home-section { summary, recently-added, recently-played, most-played, favourites }
    /// How Now Playing is laid out.
    enum now-playing-layout {
        /// The v0.0.6 stage.
        stage,
        /// A large cover with the current line below.
        artwork,
        /// Lyrics full width with a small cover in the corner.
        lyrics,
    }
    /// The mini-player.
    enum mini-player-style {
        /// The v0.0.6 bar.
        bar,
        /// A compact bar: cover, title, play.
        compact,
        /// A floating capsule.
        floating,
    }

    /// The look; none leaves the Luminous default.
    record appearance-look {
        /// Corner radii × this, 0–2; 1 is Luminous.
        corner-scale: option<f32>,
        /// Glass alpha and blur × this, 0–1; 0 is solid panels.
        glass: option<f32>,
        /// The aurora field's strength, 0–1 (token `field.aurora-strength`).
        aurora: option<f32>,
        typeface: option<typeface>,
        /// Every type size × this, 0.85–1.30.
        text-scale: option<f32>,
        density: option<density>,
        lyrics-weight: option<lyrics-weight>,
        /// The glow around the sung line, 0–1.
        lyrics-glow: option<f32>,
        lyrics-highlight: option<highlight>,
        /// The places shown, in order.
        sidebar: option<list<place>>,
        /// Home's sections, in order.
        home: option<list<home-section>>,
        now-playing: option<now-playing-layout>,
        mini-player: option<mini-player-style>,
    }

    /// The look for the current settings. Cheap; no network.
    look: func() -> result<appearance-look, plugin-error>;
}

/// A source's Discover page (capability `discover`, API 1.2): shelves of
/// items the service recommends, in its own words. Without it the app makes
/// the page from `recommendations.for-user` and the top level of `browse`.
interface discover {
    use types.{item, plugin-error};

    /// How a shelf is shown.
    enum shelf-style {
        /// One scrolling row of covers.
        row,
        /// A grid of covers.
        grid,
        /// A numbered list (a chart).
        chart,
    }

    /// One shelf of the page.
    record shelf {
        /// Stable within the plugin.
        id: string,
        /// Its heading, in the service's words ("New Releases").
        title: string,
        style: shelf-style,
        /// At most 50 are shown.
        items: list<item>,
        /// The id of a node `catalog.browse` lists in full ("See All").
        more: option<string>,
    }

    /// The page: at most 12 shelves are shown.
    discover: func() -> result<list<shelf>, plugin-error>;
}

/// More about an item (capability `details`, API 1.2): an album's notes, an
/// artist's biography and photo, and facts the apps word in their own
/// languages.
interface details {
    use types.{image-ref, item, plugin-error};

    /// What a fact is. The apps word the known keys; `other` carries the
    /// service's own label.
    variant fact-key {
        version,
        genre,
        language,
        released,
        label,
        composer,
        lyricist,
        arranger,
        producer,
        popularity,
        quality,
        other(string),
    }

    /// One fact: "Released" "2021-03-05".
    record fact {
        key: fact-key,
        value: string,
    }

    /// What the service says about an item.
    record item-details {
        /// Album notes, an artist's biography; plain text.
        description: option<string>,
        /// A large cover or an artist photo.
        image: option<image-ref>,
        /// At most 32 are shown.
        facts: list<fact>,
        /// How many comments the item has (capability `comments`).
        comment-count: option<u64>,
    }

    /// Details for `item` (a track, album, artist or playlist of this plugin).
    details: func(item: item) -> result<item-details, plugin-error>;
}

/// What people say about an item on the service (capability `comments`,
/// API 1.2). Read-only; the content policy's attribution applies.
interface comments {
    use types.{image-ref, item, page-request, plugin-error};

    /// One comment.
    record comment {
        /// Stable within the plugin.
        id: string,
        /// The commenter's name on the service.
        author: string,
        avatar: option<image-ref>,
        /// Plain text, at most 2 000 characters shown.
        text: string,
        likes: option<u64>,
        /// When it was written, milliseconds since the Unix epoch.
        time-ms: option<u64>,
        /// How many replies it has.
        replies: option<u64>,
    }

    /// One page of comments.
    record comment-page {
        /// The service's highlighted comments, on the first page only.
        hot: list<comment>,
        /// The comments, newest first or in the service's order; at most 50.
        comments: list<comment>,
        /// How many there are in all, if the service says.
        total: option<u64>,
        /// The cursor of the next page; none on the last.
        next: option<string>,
    }

    /// A page of comments on `item`.
    comments: func(item: item, page: page-request) -> result<comment-page, plugin-error>;
}

/// The person's library on the service (capability `library`, API 1.3;
/// ADR-0024): their liked songs, albums and artists, and their own and
/// followed playlists, for the app's Favourites and Playlists pages. Read
/// only: the app never changes them on the service.
///
/// A playlist's songs come from `catalog.browse` on its item, page by page,
/// as for any other container, so Play, Shuffle and the playlist's page work
/// as they do for any source container.
interface library {
    use types.{item, item-kind, item-page, page-request, plugin-error};

    /// A playlist in the person's library.
    record playlist-entry {
        /// The playlist itself (kind `playlist`), passed back to
        /// `catalog.browse` for its songs.
        item: item,
        /// The person's own playlist, or one they collaborate on, rather
        /// than one they follow.
        owned: bool,
        /// Whether `catalog.browse` lists the playlist's songs. False when
        /// the service lists them only in its own app (a Spotify playlist the
        /// person neither owns nor collaborates on): the app then plays the
        /// playlist as a whole and offers to open it in the service.
        songs-listed: bool,
    }

    /// One page of playlists.
    record playlist-page {
        /// The playlists, in the service's order.
        entries: list<playlist-entry>,
        /// Cursor for the following page; none when this page is the last.
        next: option<string>,
        /// How many playlists there are in all, if the service says.
        total: option<u32>,
    }

    /// The person's liked items of `kind` (`track`, `album` or `artist`),
    /// newest first where the service keeps that order. A kind the service
    /// does not keep answers `unsupported`.
    likes: func(kind: item-kind, page: page-request) -> result<item-page, plugin-error>;

    /// The person's own and followed playlists.
    playlists: func(page: page-request) -> result<playlist-page, plugin-error>;
}

/// Downloading a song from the person's own server (capability `download`,
/// API 1.3; ADR-0025), when the server lets the account download it. Never
/// a stream URL that skips the server's download policy, never DRM
/// circumvention or a paywall bypass. The host fetches the file, resumes it
/// with range requests, tags it and adds it to the library.
interface download {
    use types.{header, item, plugin-error};

    /// The quality the person chose in Settings › Downloads.
    enum download-quality {
        /// The file exactly as the server keeps it.
        original,
        /// The server's conversion at about 320 kbit/s: Opus where it can,
        /// otherwise AAC or MP3.
        high,
        /// About 192 kbit/s.
        normal,
        /// About 128 kbit/s.
        low,
    }

    /// Where the host fetches the file.
    record download-info {
        /// The `http` or `https` URL of the file; it must be covered by the
        /// network allowlist.
        url: string,
        /// Headers for every request to `url` (for example authorisation).
        headers: list<header>,
        /// The file's container, as its usual extension: `flac`, `mp3`,
        /// `m4a`, `opus`, `ogg`, `wav`.
        container: string,
        /// The size in bytes, if known.
        size: option<u64>,
        /// Whether this is the original file, byte for byte as the server
        /// keeps it, rather than the server's conversion.
        original: bool,
        /// The file's name on the server, if it has one. The host names
        /// files by the person's template; this only fills in the extension
        /// when `container` is empty.
        file-name: option<string>,
    }

    /// Where to fetch `item` (a track) at `quality`. Answer `unsupported`
    /// when the server does not let this account (or this item) be
    /// downloaded, such as Jellyfin's `EnableContentDownloading` policy or
    /// `CanDownload`, or Subsonic's download role or error 50: the app tells
    /// the person so. A server that cannot convert may answer the original
    /// file, with `original` set.
    download: func(item: item, quality: download-quality) -> result<download-info, plugin-error>;
}
